---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'; 
import CookieBanner from '../components/CookieBanner.astro';
import CommandPalette from '../components/CommandPalette.astro'; 
import '../styles/global.css';

// Props erweitern für bessere SEO pro Seite
const { 
  title, 
  description = "Die Brücke Graz – Inklusion, Kultur und Begegnung. Wir schaffen Raum für ein Miteinander ohne Barrieren.",
  image = "/assets/share-image.jpg" // Fallback Bild (sollte in public/assets liegen)
} = Astro.props;

const fullTitle = title ? `${title} - Die Brücke` : 'Die Brücke - Studio';

// FIX: Fallback für Astro.site, damit es lokal und ohne Config nicht crasht
const siteUrl = Astro.site || 'https://beta.diebruecke.social';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html> 
<html lang="de" class="scroll-smooth"> 
  <head> 
    <meta charset="utf-8"> 
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"> 
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>   
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <link rel="preconnect" href="https://api.diebruecke.social" crossorigin>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>

    <script is:inline>
      const themeKey = 'theme';
      const updateTheme = () => {
        const local = typeof localStorage !== 'undefined' ? localStorage.getItem(themeKey) : null;
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const mode = local || system;
        document.documentElement.classList.toggle('dark', mode === 'dark');
        document.documentElement.style.colorScheme = mode;
      };
      updateTheme();
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem(themeKey)) updateTheme();
      });
      window.toggleTheme = () => {
        const isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem(themeKey, isDark ? 'light' : 'dark');
        updateTheme();
        window.dispatchEvent(new Event('theme-change'));
      };
    </script>
    
    <style is:global>
      /* Font Definitions */
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-display { font-family: 'Outfit', sans-serif; }

      /* Sticky Scroll Fix */
      html { overflow-x: visible; scroll-behavior: smooth; }
      body { overflow-x: clip; width: 100%; }

      /* Erzwingt weiße Überschriften im Dark Mode innerhalb von Main */
      html.dark main h1, html.dark main h2, html.dark main h3, html.dark main h4, html.dark main h5, html.dark main h6 {
          color: #f8fafc !important; /* Slate-50 */
      }
      /* Ausnahme für Gradient-Texte */
      html.dark main .text-transparent {
          color: transparent !important;
      }
    </style>
  </head>     

    {/* --- GLOBALER TOOLTIP --- */}
    <div id="global-tooltip" class="fixed pointer-events-none opacity-0 transition-opacity duration-200 bg-slate-900 text-white text-[11px] font-bold px-3 py-1.5 rounded-lg shadow-xl z-[9999] whitespace-nowrap transform -translate-x-1/2 mt-2 hidden dark:bg-slate-50 dark:text-slate-900 border border-white/10 dark:border-slate-200">
    </div>

    <script is:inline>
        // GLOBAL TOOLTIP LOGIC
        const tooltip = document.getElementById('global-tooltip');
        
        if (tooltip) {
            document.body.addEventListener('mouseover', (e) => {
                const target = e.target.closest('[data-tooltip]');
                if (target) {
                    const text = target.getAttribute('data-tooltip');
                    if (!text) return;
                    tooltip.textContent = text;
                    tooltip.classList.remove('hidden');
                    const rect = target.getBoundingClientRect();
                    const centerX = rect.left + (rect.width / 2);
                    const topY = rect.bottom; 
                    tooltip.style.left = `${centerX}px`;
                    tooltip.style.top = `${topY}px`;
                    requestAnimationFrame(() => {
                        tooltip.classList.remove('opacity-0');
                    });
                }
            });

            document.body.addEventListener('mouseout', (e) => {
                const target = e.target.closest('[data-tooltip]');
                if (target) {
                    tooltip.classList.add('opacity-0');
                    setTimeout(() => {
                         if (tooltip.classList.contains('opacity-0')) {
                             tooltip.classList.add('hidden');
                         }
                    }, 200);
                }
            });

            window.addEventListener('scroll', () => {
                tooltip.classList.add('opacity-0');
                tooltip.classList.add('hidden');
            }, { passive: true });
        }
    </script>

  <body class="antialiased p-4 md:p-8 min-h-screen bg-gray-50 dark:bg-black transition-colors duration-300"> 
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] px-6 py-3 bg-rose-500 text-white font-bold rounded-xl shadow-xl outline-none ring-4 ring-rose-300 transition-all">
        Zum Hauptinhalt springen
    </a>
    <div class="relative max-w-[1400px] mx-auto rounded-[40px] shadow-2xl rounded-canvas isolate flex flex-col min-h-[calc(100vh-4rem)] bg-white dark:bg-slate-900 transition-colors duration-300">

      <div class="sticky top-0 z-50 rounded-t-[40px] overflow-hidden">
        <Header />
      </div>

      <main id="main-content" class="flex-grow dark:text-slate-200">
        <slot />
      </main>

      <Footer />
      <CookieBanner />
    </div>

    <CommandPalette />
  </body>     
</html>