---
import MainLayout from '../layouts/layout.astro';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

// --- DATA FETCHING ---
let supporters = [];
try {
    supporters = await directus.request(readItems('sponsors', {
        // Wir filtern nur nach Status (muss in Directus angelegt sein!)
        filter: { status: { _eq: 'published' } },
        // Wir sortieren nur nach der manuellen Sortier-Nummer
        sort: ['sort'], 
        limit: -1
    }));
} catch (error) {
    console.error("Fehler beim Laden der Supporter:", error);
}

const ASSET_URL = "https://api.diebruecke.social/assets";

// --- CONFIGURATION ---
const getTierStyles = (tier) => {
  switch(tier) {
    // TIER 1: "Die Fundamente" & Fördergeber (Hochformat, Glassmorphism, Strong Glow)
    case 'base':
    case 'funding_body': 
      return "col-span-2 md:col-span-2 row-span-2 text-2xl md:text-4xl font-display font-bold bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl text-slate-800 dark:text-white border border-indigo-200/60 dark:border-indigo-500/30 hover:bg-white/90 dark:hover:bg-slate-900/80 hover:border-indigo-400 dark:hover:border-indigo-400 hover:shadow-2xl hover:shadow-indigo-500/25 hover:-translate-y-2";
    
    // TIER 2: "Die Pfeiler" & Partner (Breit, Glassmorphism, Rose Glow)
    case 'pillar':
    case 'partner':
      return "col-span-2 md:col-span-2 row-span-1 text-lg md:text-xl font-bold bg-white/60 dark:bg-slate-800/50 backdrop-blur-lg text-slate-800 dark:text-white border border-slate-200/60 dark:border-slate-700/50 hover:bg-white/80 dark:hover:bg-slate-800/70 hover:border-rose-300 dark:hover:border-rose-500/60 hover:shadow-xl hover:shadow-rose-500/20 hover:-translate-y-1";
    
    // TIER 3: "Die Bausteine" (Klein & Kompakt, leichtes Glass)
    case 'brick':
    default:
      return "col-span-1 md:col-span-1 row-span-1 text-sm md:text-base font-medium bg-slate-50/60 dark:bg-slate-900/40 backdrop-blur-md text-slate-600 dark:text-slate-400 border border-slate-200/50 dark:border-slate-800/50 hover:bg-white/80 dark:hover:bg-slate-800/60 hover:border-slate-300 dark:hover:border-slate-600 hover:-translate-y-0.5 hover:shadow-md";
  }
};
---

<MainLayout title="Unsere Unterstützer | Die Brücke">
  
  {/* --- HERO SECTION --- */}
  <section class="px-4 sm:px-6 pt-6 pb-12">
    <div class="relative bg-slate-900 rounded-[48px] overflow-hidden min-h-[50vh] flex items-center justify-center text-center px-6 py-20">
        
        {/* Background Effects */}
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute top-[-10%] right-[-5%] w-96 h-96 bg-rose-500/20 rounded-full blur-[100px]"></div>
            <div class="absolute bottom-[-10%] left-[-5%] w-96 h-96 bg-indigo-500/20 rounded-full blur-[100px]"></div>
            <div class="absolute inset-0 bg-[url('/noise.png')] opacity-20 mix-blend-overlay"></div>
        </div>

        {/* Content */}
        <div class="relative z-10 max-w-4xl mx-auto">
            {/* Sticker / Badge */}
            <div class="inline-flex mb-8 animate-spin-slow">
                <div class="relative w-24 h-24 flex items-center justify-center">
                   <svg viewBox="0 0 100 100" class="w-full h-full fill-rose-500 text-rose-500">
                        <path id="curve" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="transparent"/>
                        <text class="text-[13px] font-bold uppercase tracking-widest fill-current">
                            <textPath href="#curve" startOffset="0%">
                                • Danke • Support • Danke • Support
                            </textPath>
                        </text>
                   </svg>
                   <div class="absolute inset-0 flex items-center justify-center">
                        <i class="fa-solid fa-heart text-2xl text-white"></i>
                   </div>
                </div>
            </div>

            <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white leading-[0.95] tracking-tight mb-8">
                Unsere <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-indigo-400">Fundamente.</span>
            </h1>
            
            <p class="text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
                Große Visionen brauchen starke Schultern. Hier sind die Menschen, Unternehmen und öffentlichen Institutionen, 
                die das Fundament für Kultur, Inklusion und Vielfalt legen.
            </p>
        </div>
    </div>
  </section>

  {/* --- THE WALL (mit Glassmorphism Background-Blobs) --- */}
  <section class="relative px-4 sm:px-6 pb-32 bg-slate-50 dark:bg-slate-950 overflow-hidden">
    
    {/* Ambiente-Hintergrund für den Milchglas-Effekt */}
    <div class="absolute top-40 left-10 w-[500px] h-[500px] bg-rose-200/30 dark:bg-rose-900/20 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-40 right-10 w-[600px] h-[600px] bg-indigo-200/30 dark:bg-indigo-900/20 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto pt-12">
      
      {/* Grid Wrapper: Feste Basis-Höhe (160px) für saubere Hochformate */}
      <div id="wall-grid" class="grid grid-cols-2 md:grid-cols-6 gap-4 auto-rows-[160px] grid-flow-dense">
        {supporters.length > 0 ? supporters.map((s) => (
          <a 
            href={s.url || undefined} 
            target={s.url ? "_blank" : "_self"}
            rel={s.url ? "noopener noreferrer" : ""}
            class={`
              ${getTierStyles(s.tier)} 
              relative rounded-[32px] flex items-center justify-center p-6 text-center transition-all duration-500 group overflow-hidden flex-col gap-4
              ${!s.url ? 'cursor-default' : 'cursor-pointer'}
            `}
          >
            
            {/* Subtle Inner Glow für Tier 1 */}
            {(s.tier === 'base' || s.tier === 'funding_body') && (
               <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent dark:from-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            )}
            
            {/* Logo oder Text */}
            {s.logo ? (
                <img 
                    src={`${ASSET_URL}/${s.logo}?key=system-medium-contain`} 
                    alt={s.name}
                    class={`relative z-10 max-w-[80%] object-contain transition-all duration-500 ${
                        (s.tier === 'base' || s.tier === 'funding_body') 
                        ? 'max-h-[120px] filter drop-shadow-sm group-hover:drop-shadow-lg group-hover:scale-105' 
                        : 'max-h-[60px] grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100'
                    }`}
                />
            ) : (
                <span class="relative z-10 break-words w-full">{s.name}</span>
            )}

            {/* Icon für Links (Dezenter Pfeil rechts oben) */}
            {s.url && (
                <div class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-200/50 dark:bg-slate-800/50 backdrop-blur-sm flex items-center justify-center text-xs opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 z-20">
                    <i class="fa-solid fa-arrow-right text-slate-700 dark:text-slate-200"></i>
                </div>
            )}
          </a>
        )) : (
            <div class="col-span-full py-12 text-center text-slate-500 bg-white/50 dark:bg-slate-900/50 backdrop-blur-md rounded-[32px] border border-dashed border-slate-300 dark:border-slate-700">
                <i class="fa-solid fa-heart-crack text-3xl mb-4 text-slate-400 block"></i>
                <p>Noch keine Unterstützer geladen.</p>
                <p class="text-xs mt-2 opacity-60">(Bitte in Directus "status" auf "published" setzen)</p>
            </div>
        )}
      </div>

      {/* CTA Footer Block */}
      <div class="mt-24 text-center">
         <div class="inline-flex flex-col items-center">
            <div class="w-px h-16 bg-slate-300 dark:bg-slate-800 mb-6"></div>
            <a href="/join" class="group relative inline-flex items-center justify-center px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full font-bold overflow-hidden transition-all hover:scale-105 hover:shadow-2xl hover:shadow-slate-900/20 dark:hover:shadow-white/20">
                <span class="relative z-10 flex items-center gap-3">
                    Werde Teil der Wand <i class="fa-solid fa-hand-holding-heart group-hover:animate-pulse"></i>
                </span>
            </a>
            <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Jeder € zählt.</p>
         </div>
      </div>

    </div>
  </section>

  <script>
    // Client-Side Shuffle
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('wall-grid');
      if(grid && grid.children.length > 1) { // Nur shuffeln wenn > 1 Element
        const items = Array.from(grid.children);
        for (let i = items.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [items[i], items[j]] = [items[j], items[i]];
        }
        items.forEach(item => grid.appendChild(item));
      }
    });
  </script>

</MainLayout>