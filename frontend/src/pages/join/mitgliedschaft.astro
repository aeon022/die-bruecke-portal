---
import MainLayout from '../../layouts/layout.astro';

// --- SEO KONFIGURATION ---
const seoTitle = "Mitgliedschaft";
const seoDescription = "Werde förderndes Mitglied der Brücke und sichere unsere barrierefreie Arbeit in Graz seit 1983 – als Privatperson oder mit deinem Unternehmen.";
const seoImage = "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=1200";

const impact = [
    {
        icon: 'fa-door-open',
        title: 'Ein offenes Haus für alle',
        text: 'Du sicherst unser Haus in der Grabenstraße. Das ist ein Treffpunkt, der allen Menschen offensteht. Niemand muss dort etwas konsumieren.',
    },
    {
        icon: 'fa-masks-theater',
        title: 'Kultur ohne Hürden',
        text: 'Du unterstützt unsere zu 100 % barrierefreien Veranstaltungen. Damit bleiben Formate wie Konzerte, Kabaretts, das Impro-Theater oder auch das neue SofaKINO für alle leistbar.',
    },
    {
        icon: 'fa-umbrella-beach',
        title: 'Freizeit und Urlaub',
        text: 'Du hilfst unsere Freizeitassistenz mit zu finanzieren. So ermöglichst du Menschen mit Behinderung begleitete Ausflüge und echte Erholung vom Alltag in unseren betreuten Urlaubs-Camps.',
    },
];

const benefits = [
    {
        icon: 'fa-champagne-glasses',
        title: 'Exklusive Kulturabende',
        text: 'Wir laden dich zu privaten Wohnzimmerkonzerten, Vorab-Premieren und Test-Screenings ein.',
    },
    {
        icon: 'fa-cake-candles',
        title: 'Feiern zum Mitgliedspreis',
        text: 'Als Mitglied kannst du die Brücke zu vergünstigten Konditionen für deine eigene Feier nutzen – von Geburtstag bis Jubiläum.',
    },
    {
        icon: 'fa-people-group',
        title: 'Das besondere Team-Event (für Firmen)',
        text: 'Teambuilding einmal anders! Kommt mit der Belegschaft vorbei und unterstützt uns aktiv bei einem unserer „Offenen Haus“-Termine. Lust auf einen Perspektivenwechsel bei einem gemeinsamen Rollstuhlausflug durch Graz? Kein Problem, wir organisieren das für euch.',
        link: { href: '/join/mitgliedschaft#firmen', label: 'Mehr zur Firmenmitgliedschaft' },
    },
];

// Mitgliedschaft läuft zweistufig: erst unser Formular (Daten landen in Directus),
// erst nach dem Absenden geht's zum passenden Stripe-Link weiter. So haben wir die
// Mitgliederdaten immer selbst, auch wenn Stripe der Zahlungsabwickler bleibt.
// membershipType = fixer Auswahlwert des Directus-Felds `inbox_memberships.membership_type`.
// Das Feld kennt nur 4 grobe Kategorien, unsere Stripe-Tarife sind feiner (Firmengröße) -
// die genaue Auswahl geht deshalb zusätzlich als Freitext ins `message`-Feld mit.
const tierStripeMap = {
    mitglied: { label: 'Mitgliedschaft – 39 € / Jahr', url: 'https://buy.stripe.com/8x2fZh0O87uM4Aj5ng3AY00', membershipType: 'Mitgliedschaft' },
    foerdermitglied: { label: 'Fördermitgliedschaft – 79 € / Jahr', url: 'https://buy.stripe.com/14A9AT2WgcP67MvcPI3AY01', membershipType: 'Fördermitgliedschaft' },
    firma_klein: { label: 'Firmenmitgliedschaft, bis 14 Mitarbeiter:innen – 250 € / Jahr', url: 'https://buy.stripe.com/4gM5kDdAU6qI5En7vo3AY02', membershipType: 'Firmenmitgliedschaft' },
    firma_gross: { label: 'Firmenmitgliedschaft, ab 15 Mitarbeiter:innen – 500 € / Jahr', url: 'https://buy.stripe.com/5kQbJ12Wg8yQ5EncPI3AY03', membershipType: 'Firmenmitgliedschaft' },
};

// Feste Klassen-Strings statt `bg-${color}-500` etc. — Tailwinds Scanner erkennt nur
// literale Klassennamen im Quellcode, keine zur Laufzeit zusammengesetzten Strings.
const tiers = [
    {
        title: 'Mitgliedschaft',
        subtitle: 'Privatpersonen',
        price: '39 €',
        period: '/ Jahr',
        text: 'Für alle, die unsere Arbeit als außerordentliches Mitglied fördern wollen.',
        labelClass: 'text-emerald-600 dark:text-emerald-400',
        buttonClass: 'bg-emerald-500 hover:bg-emerald-600',
        cta: { href: '#membership-form', label: 'Jetzt anmelden', tierId: 'mitglied' },
    },
    {
        title: 'Fördermitgliedschaft',
        subtitle: 'Privatpersonen',
        price: '79 €',
        period: '/ Jahr',
        text: 'Für alle, die unsere Arbeit als außerordentliches Mitglied vor allem finanziell fördern wollen.',
        labelClass: 'text-indigo-600 dark:text-indigo-400',
        buttonClass: 'bg-indigo-500 hover:bg-indigo-600',
        cta: { href: '#membership-form', label: 'Jetzt anmelden', tierId: 'foerdermitglied' },
    },
    {
        title: 'Firmenmitgliedschaft',
        subtitle: 'Unternehmen',
        price: 'ab 250 €',
        period: '/ Jahr',
        text: 'Für Unternehmen und juristische Personen, die unsere Arbeit als außerordentliches Mitglied durch einen erhöhten Beitrag stärken möchten.',
        labelClass: 'text-amber-600 dark:text-amber-400',
        buttonClass: 'bg-amber-500 hover:bg-amber-600',
        cta: { href: '/join/mitgliedschaft#firmen', label: 'Mehr erfahren', tierId: '' },
    },
];

const companyTiers = [
    {
        label: 'Bis 14 Mitarbeiter:innen',
        price: '250 €',
        tierId: 'firma_klein',
    },
    {
        label: 'Ab 15 Mitarbeiter:innen',
        price: '500 €',
        tierId: 'firma_gross',
    },
];

const teamEvents = [
    {
        icon: 'fa-kitchen-set',
        title: 'Die Bar- und Küchen-Crew',
        text: 'Ihr steht als Team gerne zusammen am Herd? Schmeißt eure eigene Küchenparty bei uns! Schnappt euch die Kochlöffel und kocht gemeinsam mit uns, oder übernehmt für einen Abend die Schank an unserem Buffet.',
    },
    {
        icon: 'fa-dice',
        title: 'Spieleabend im XXL-Format',
        text: 'Tauscht den Schreibtisch gegen den Spieltisch. Wir veranstalten bei uns im Saal ein großes Mensch-ärgere-dich-nicht-Turnier, ein Pub-Quiz oder packen die Brettspiele im Buffetbereich aus. Tratschen, Zocken und echte Begegnung inklusive.',
    },
    {
        icon: 'fa-clapperboard',
        title: 'Hostet euer eigenes Event',
        text: 'Organisiert gemeinsam mit uns einen Abend im Saal. Ihr übernehmt den Einlass, die Gäste-Betreuung und die Snacks bei unserem neuen SofaKINO. Ein Teamevent, das Kultur für alle erlebbar macht!',
    },
    {
        icon: 'fa-wheelchair-move',
        title: 'Rollstuhl-Rallye durchs Grätzel',
        text: 'Lust auf einen echten Perspektivenwechsel? Wir organisieren für euer Team einen gemeinsamen Rollstuhlausflug mit Start bei uns in der Grabenstraße. Das baut Barrieren im Kopf schneller ab als jeder trockene Workshop.',
    },
    {
        icon: 'fa-music',
        title: 'Konzert-Paten',
        text: 'Ihr liebt gute Musik? Werdet Paten für einen unserer Konzertabende im Saal. Ihr feiert mit eurem Team, lernt die Bands beim Meet & Greet kennen und stoßt danach am Buffet gemeinsam an.',
    },
];
---

<MainLayout
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>

    <div class="home-content px-4 md:px-6">

        {/* --- HERO --- */}
        <section class="relative z-10 px-6 sm:px-10 pt-24 pb-20 bg-white dark:bg-slate-900 rounded-t-[48px] md:rounded-t-[64px] overflow-hidden transition-colors duration-500">
            <div class="max-w-6xl mx-auto relative z-10">
                <div class="mb-16">
                    <a href="/join" class="inline-flex items-center text-slate-400 hover:text-rose-500 font-bold transition-colors group text-xs uppercase tracking-[0.2em]">
                        <i class="fa-solid fa-chevron-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                        Zurück zu Mitmachen
                    </a>
                </div>

                <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                    <div>
                        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-bold uppercase tracking-[0.3em] mb-10">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                            </span>
                            Mitgliedschaft
                        </div>

                        <h1 class="text-5xl md:text-7xl font-display font-black text-slate-900 dark:text-white tracking-tight leading-[0.95] mb-10">
                            Werde Teil <br/>
                            <span class="text-transparent bg-clip-text bg-gradient-to-br from-emerald-500 via-emerald-600 to-indigo-700 italic">der Brücke.</span>
                        </h1>

                        <p class="text-xl md:text-2xl text-slate-500 dark:text-slate-400 leading-relaxed font-medium max-w-2xl">
                            Seit 1983 ist die Brücke der Ort in Graz, an dem Inklusion einfach gelebt wird. Wir bauen gesellschaftliche, geistige und bauliche Barrieren ab. Als förderndes Mitglied bist du direkt daran beteiligt, dass das so bleibt.
                        </p>
                    </div>

                    {/* Platzhalter: Bild/Illustration folgt */}
                    <div class="hidden lg:block relative">
                        <div class="relative z-10 rounded-[40px] overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700 border-4 border-white dark:border-slate-800 aspect-[4/3] bg-gradient-to-br from-emerald-400 via-emerald-600 to-indigo-700"></div>
                        <div class="absolute -inset-4 bg-gradient-to-br from-emerald-500 to-indigo-700 opacity-20 blur-2xl -z-10 rounded-[40px]"></div>
                    </div>
                </div>
            </div>
        </section>

        {/* --- WAS DEIN BEITRAG BEWIRKT --- */}
        <section class="px-6 sm:px-10 py-20 bg-white dark:bg-slate-900 transition-colors duration-500">
            <div class="max-w-5xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-display font-bold text-slate-900 dark:text-white mb-4 tracking-tight">
                    Was dein Beitrag bewirkt
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-lg leading-relaxed max-w-2xl mb-12 font-medium">
                    Jeder Euro fließt in unsere Arbeit. Das machst du mit deiner Mitgliedschaft möglich:
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {impact.map(item => (
                        <div class="reveal bg-slate-50 dark:bg-slate-800/50 rounded-[32px] p-8 border border-slate-100 dark:border-slate-800">
                            <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-700 flex items-center justify-center text-emerald-500 text-lg shadow-sm mb-6">
                                <i class={`fa-solid ${item.icon}`}></i>
                            </div>
                            <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-3 tracking-tight">{item.title}</h3>
                            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed font-medium">{item.text}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* --- WAS DU DAVON HAST --- */}
        <section class="px-6 sm:px-10 py-20 bg-slate-50 dark:bg-slate-950 transition-colors duration-500">
            <div class="max-w-5xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-display font-bold text-slate-900 dark:text-white mb-4 tracking-tight">
                    Was du davon hast
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-lg leading-relaxed max-w-2xl mb-8 font-medium">
                    Als Mitglied bist du eng in unser Haus eingebunden und erlebst Inklusion hautnah:
                </p>

                {/* GROSSES HIGHLIGHT: Vergünstigter Eintritt */}
                <div class="reveal relative overflow-hidden rounded-[40px] p-8 md:p-12 mb-6 bg-gradient-to-br from-emerald-500 via-emerald-600 to-indigo-700 shadow-2xl">
                    <div class="absolute -right-16 -top-16 w-72 h-72 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
                        <div>
                            <span class="text-white/80 font-bold uppercase tracking-widest text-xs mb-3 block">Der große Mitglieder-Vorteil</span>
                            <h3 class="text-2xl md:text-4xl font-display font-bold text-white tracking-tight leading-tight">
                                Vergünstigter Eintritt zu unseren Events
                            </h3>
                        </div>
                        <div class="flex items-baseline gap-4 shrink-0">
                            <span class="text-2xl font-display font-bold text-white/50 line-through">25 €</span>
                            <span class="text-5xl md:text-6xl font-display font-black text-white tracking-tight">15 €</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {benefits.map(item => (
                        <div class="reveal bg-white dark:bg-slate-800/50 rounded-[32px] p-8 border border-slate-100 dark:border-slate-800">
                            <div class="w-12 h-12 rounded-2xl bg-slate-50 dark:bg-slate-700 flex items-center justify-center text-indigo-500 text-lg shadow-sm mb-6">
                                <i class={`fa-solid ${item.icon}`}></i>
                            </div>
                            <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-3 tracking-tight">{item.title}</h3>
                            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed font-medium mb-4">{item.text}</p>
                            {item.link && (
                                <a href={item.link.href} class="inline-flex items-center gap-2 text-sm font-bold text-indigo-500 dark:text-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors">
                                    {item.link.label}
                                    <i class="fa-solid fa-arrow-right text-xs"></i>
                                </a>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* --- WÄHLE DEINE MITGLIEDSCHAFT --- */}
        <section class="px-6 sm:px-10 py-20 bg-white dark:bg-slate-900 transition-colors duration-500">
            <div class="max-w-6xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-display font-bold text-slate-900 dark:text-white mb-12 tracking-tight">
                    Wähle deine Mitgliedschaft
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {tiers.map(tier => (
                        <div class="reveal flex flex-col bg-slate-50 dark:bg-slate-800/50 rounded-[40px] p-10 border border-slate-100 dark:border-slate-800 hover:shadow-2xl transition-all duration-500">
                            <span class={`text-xs font-bold ${tier.labelClass} uppercase tracking-widest mb-4`}>{tier.subtitle}</span>
                            <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white mb-4 tracking-tight">{tier.title}</h3>
                            <div class="flex items-baseline gap-2 mb-6">
                                <span class="text-4xl font-display font-black text-slate-900 dark:text-white tracking-tight">{tier.price}</span>
                                <span class="text-slate-400 dark:text-slate-500 font-bold text-sm">{tier.period}</span>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-8 font-medium">{tier.text}</p>
                            <a href={tier.cta.href} data-tier={tier.cta.tierId} class={`mt-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-white rounded-full font-bold text-sm transition-all shadow-lg ${tier.buttonClass}`}>
                                {tier.cta.label}
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                    ))}
                </div>

                {/* Zahlungsmöglichkeiten */}
                <div class="reveal mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-8 bg-slate-50 dark:bg-slate-800/50 rounded-3xl p-6 border border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-3 shrink-0">
                        <div class="w-10 h-10 rounded-xl bg-white dark:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-300 shadow-sm">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                        <span class="text-sm font-bold text-slate-700 dark:text-slate-300">Lieber per Überweisung?</span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">
                        IBAN <span class="font-mono font-bold text-slate-700 dark:text-slate-200 select-all">AT34 2081 5034 0288 7370</span> · BIC <span class="font-mono font-bold text-slate-700 dark:text-slate-200 select-all">STSPAT2GXXX</span> · Empfänger: Die Brücke – soziokulturelles Zentrum
                    </p>
                </div>
            </div>
        </section>

        {/* --- FIRMENMITGLIEDSCHAFT & TEAMBUILDING --- */}
        <section id="firmen" class="px-6 sm:px-10 py-24 bg-slate-50 dark:bg-slate-950 scroll-mt-24 transition-colors duration-500">
            <div class="max-w-5xl mx-auto">

                {/* Intro */}
                <div class="reveal mb-16 grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-center">
                    <div>
                        <span class="text-amber-600 dark:text-amber-400 font-bold tracking-widest uppercase text-xs mb-4 block">Firmenmitgliedschaft</span>
                        <h2 class="text-3xl md:text-5xl font-display font-bold text-slate-900 dark:text-white mb-8 tracking-tight leading-tight">
                            Sponsoring, das Sinn <br class="hidden md:block"/>(und Spaß) macht
                        </h2>
                        <p class="text-slate-500 dark:text-slate-400 text-lg leading-relaxed max-w-3xl mb-6 font-medium">
                            Ihr wollt als Unternehmen Verantwortung übernehmen, habt aber keine Lust auf verstaubte Spendenurkunden im Flur? Perfekt. Als Firmenmitglied der Brücke seid ihr nicht nur ein Logo auf einem Flyer, sondern ein echter Motor für Inklusion in Graz.
                        </p>
                        <p class="text-slate-500 dark:text-slate-400 text-lg leading-relaxed max-w-3xl font-medium">
                            Mit eurem Beitrag als außerordentliches Mitglied helft ihr uns ganz konkret, gesellschaftliche und bauliche Barrieren abzubauen. Ihr sichert den Betrieb unseres barrierefreien Hauses und sorgt dafür, dass Kultur für alle leistbar bleibt. Dafür bekommt ihr von uns nicht nur ein gutes Gewissen, sondern auch einen echten Mehrwert für euer Team. Tauscht den klassischen Firmen-Obstkorb gegen echte Begegnungen bei uns im Haus!
                        </p>
                    </div>

                    {/* Deko: morphender Blob */}
                    <div class="hidden md:block shrink-0 relative w-40 h-40 lg:w-56 lg:h-56">
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-400 via-orange-500 to-rose-500 rounded-full blur-2xl opacity-30 dark:opacity-40"></div>
                        <div class="blob-shape absolute inset-3 bg-gradient-to-br from-amber-400 via-orange-500 to-rose-500 shadow-xl"></div>
                    </div>
                </div>

                {/* Teambuilding Ideen */}
                <div class="reveal mb-12">
                    <h3 class="text-2xl md:text-3xl font-display font-bold text-slate-900 dark:text-white mb-4 tracking-tight">
                        Teambuilding mal anders: Was ihr als Firmenmitglied bei uns erleben könnt
                    </h3>
                    <p class="text-slate-500 dark:text-slate-400 text-base leading-relaxed max-w-3xl font-medium">
                        Vergesst den klassischen Klettergarten oder das trockene Seminarhotel. Wir laden euer Team ein, bei uns mittendrin zu sein – unkompliziert, direkt und mit jeder Menge Spaß. Hier ein paar Ideen, was wir zusammen bei uns im Saal oder im Buffetbereich anstellen können:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
                    {teamEvents.map(item => (
                        <div class="reveal group bg-white dark:bg-slate-800/50 rounded-[32px] p-8 border border-slate-100 dark:border-slate-800 hover:-translate-y-2 hover:shadow-xl hover:border-amber-200 dark:hover:border-amber-900/50 transition-all duration-500">
                            <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-slate-700 flex items-center justify-center text-amber-600 dark:text-amber-400 text-lg shadow-sm mb-6 group-hover:bg-amber-500 group-hover:text-white group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500">
                                <i class={`fa-solid ${item.icon}`}></i>
                            </div>
                            <h4 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-3 tracking-tight">{item.title}</h4>
                            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed font-medium">{item.text}</p>
                        </div>
                    ))}
                </div>

                {/* Preis & CTA */}
                <div class="reveal relative overflow-hidden rounded-[48px] p-10 md:p-16 bg-gradient-to-br from-amber-400 via-orange-500 to-rose-600 shadow-2xl">
                    <div class="absolute -right-16 -top-16 w-72 h-72 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="absolute -left-10 -bottom-10 w-56 h-56 bg-slate-900/10 rounded-full blur-3xl"></div>

                    <div class="relative z-10">
                        <span class="text-white/80 font-bold tracking-widest uppercase text-xs mb-8 block">Firmenmitgliedschaft (Unternehmen als außerordentliches Mitglied)</span>

                        <div class="grid sm:grid-cols-2 gap-4 mb-8">
                            {companyTiers.map(tier => (
                                <div class="bg-white/15 backdrop-blur-md rounded-3xl p-6 border border-white/20">
                                    <span class="text-white/80 text-xs font-bold uppercase tracking-widest mb-3 block">{tier.label}</span>
                                    <div class="flex items-baseline gap-2 mb-5">
                                        <span class="text-3xl font-display font-black text-white tracking-tight">{tier.price}</span>
                                        <span class="text-white/70 font-bold text-sm">/ Jahr</span>
                                    </div>
                                    <a href="#membership-form" data-tier={tier.tierId} class="inline-flex items-center justify-center gap-2 w-full px-6 py-3 bg-slate-900 text-white rounded-full font-bold text-sm hover:bg-white hover:text-slate-900 transition-all shadow-lg">
                                        Jetzt anmelden
                                        <i class="fa-solid fa-arrow-right text-xs"></i>
                                    </a>
                                </div>
                            ))}
                        </div>

                        <p class="text-white/80 text-sm font-medium">
                            Lieber per Überweisung? IBAN <span class="font-mono font-bold text-white select-all">AT34 2081 5034 0288 7370</span> · BIC <span class="font-mono font-bold text-white select-all">STSPAT2GXXX</span> · Die Brücke – soziokulturelles Zentrum
                        </p>
                        <a href="mailto:office@diebruecke.cc?subject=Firmenmitgliedschaft" class="inline-flex items-center gap-2 mt-6 text-sm font-bold text-white hover:text-slate-900 hover:bg-white/90 transition-all px-5 py-2.5 rounded-full border border-white/40">
                            Noch Fragen? Jetzt anfragen
                            <i class="fa-solid fa-comments"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {/* --- ANFRAGEFORMULAR --- */}
        <section class="px-6 sm:px-10 py-24 bg-white dark:bg-slate-900 transition-colors duration-500">
            <div class="max-w-3xl mx-auto">
