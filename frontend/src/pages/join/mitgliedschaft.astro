                    <a href="tel:+43316672248" class="px-10 py-5 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-900 dark:text-white rounded-full font-bold hover:border-slate-900 dark:hover:border-slate-400 transition-all flex items-center justify-center gap-2">
