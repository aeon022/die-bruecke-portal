<style>
    .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s ease-out; }
    .reveal.active { opacity: 1; transform: translateY(0); }

    .blob-shape {
        animation: blob-morph 10s ease-in-out infinite;
    }
    @keyframes blob-morph {
        0%, 100% { border-radius: 42% 58% 65% 35% / 45% 45% 55% 55%; transform: rotate(0deg) scale(1); }
        25% { border-radius: 58% 42% 35% 65% / 55% 65% 35% 45%; transform: rotate(8deg) scale(1.04); }
        50% { border-radius: 65% 35% 45% 55% / 35% 55% 45% 65%; transform: rotate(-6deg) scale(0.97); }
        75% { border-radius: 35% 65% 55% 45% / 65% 35% 65% 35%; transform: rotate(4deg) scale(1.02); }
    }
</style>

<script define:vars={{ tierStripeMap }}>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    const form = document.getElementById('membership-form-el');
    const msgBox = document.getElementById('membership-form-message');
    const submitBtn = document.getElementById('membership-submit-btn');
    const bankBtn = document.getElementById('membership-bank-btn');
    const bankDetails = document.getElementById('membership-bank-details');
    const tierSelect = document.getElementById('m-tier');

    // Preis-Buttons (Karten oben + Firmen-Bereich) springen zum Formular und
    // wählen dort schon die passende Mitgliedschaft vor.
    document.querySelectorAll('[data-tier]').forEach(el => {
        const tierId = el.getAttribute('data-tier');
        if (!tierId || !tierStripeMap[tierId]) return;
        el.addEventListener('click', () => {
            if (tierSelect) tierSelect.value = tierId;
        });
    });

    if (form && msgBox && submitBtn && bankBtn && bankDetails && tierSelect) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const paymentMethod = e.submitter?.value || 'stripe';
            const clickedBtn = e.submitter || submitBtn;
            const originalBtnText = clickedBtn.innerHTML;

            submitBtn.setAttribute('disabled', 'true');
            bankBtn.setAttribute('disabled', 'true');
            clickedBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Senden...';
            msgBox.classList.add('hidden');
            bankDetails.classList.add('hidden');

            const formData = new FormData(form);
            const raw = Object.fromEntries(formData.entries());
            const tier = tierStripeMap[raw.tier];

            // membership_type unterscheidet nicht nach Firmengröße -> der genau
            // gewählte Tarif geht zusätzlich als Klartext ins message-Feld.
            const messageParts = [`Gewählter Tarif: ${tier.label}`, `Zahlweise: ${paymentMethod === 'ueberweisung' ? 'Überweisung' : 'Stripe'}`];
            if (raw.message) messageParts.push(raw.message);

            // Directus erwartet die Telefonnummer ganz ohne Leerzeichen (+436641234567).
            const phone = raw.phone ? raw.phone.replace(/\s+/g, '') : '';

            const payload = {
                first_name: raw.first_name,
                last_name: raw.last_name,
                email: raw.email,
                address: raw.address,
                phone,
                message: messageParts.join('\n'),
                membership_type: tier.membershipType,
                website_check: raw.website_check,
            };

            try {
                const response = await fetch('/api/membership', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();

                if (response.ok) {
                    if (paymentMethod === 'ueberweisung') {
                        msgBox.classList.add('hidden');
                        bankDetails.classList.remove('hidden');
                        clickedBtn.innerHTML = originalBtnText;
                        submitBtn.removeAttribute('disabled');
                        bankBtn.removeAttribute('disabled');
                    } else {
                        msgBox.innerHTML = `<i class="fa-solid fa-check-circle"></i> Danke! Du wirst gleich zur sicheren Zahlung weitergeleitet …`;
                        msgBox.className = "p-4 rounded-xl text-sm font-bold mb-4 bg-emerald-100 text-emerald-800 border border-emerald-200 block";

                        const stripeUrl = new URL(tier.url);
                        if (raw.email) stripeUrl.searchParams.set('prefilled_email', raw.email);
                        setTimeout(() => { window.location.href = stripeUrl.toString(); }, 1500);
                    }
                } else {
                    throw new Error(result.message || 'Fehler beim Senden');
                }
            } catch (error) {
                msgBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${error.message || 'Verbindungsfehler.'}`;
                msgBox.className = "p-4 rounded-xl text-sm font-bold mb-4 bg-rose-100 text-rose-800 border border-rose-200 block";
                clickedBtn.innerHTML = originalBtnText;
                submitBtn.removeAttribute('disabled');
                bankBtn.removeAttribute('disabled');
            }
        });
    }
</script>
