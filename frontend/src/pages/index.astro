---
import MainLayout from '../layouts/layout.astro';
import { getEvents, getGlobalSettings } from '../lib/api';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

// COMPONENTS
import Hero from '../components/home/Hero.astro';
import Events from '../components/home/Events.astro';
import Services from '../components/home/Services.astro';
import Foundation from '../components/home/Foundation.astro';
import Projects from '../components/home/Projects.astro';
import Partners from '../components/home/Partners.astro';
import Pionier from '../components/home/Pionier.astro';
import CTA from '../components/home/CTA.astro';

const ASSET_URL = 'https://api.diebruecke.social/assets'; 

// Hilfsfunktion für Hero-Bilder (hier brauchen wir die ganze URL)
const getOptimizedImg = (id, w = 800) => {
    if (!id) return null;
    if (typeof id === 'object') id = id.id;
    if (id.startsWith('http')) return `${id}?auto=format&fit=crop&w=${w}&q=80`;
    return `${ASSET_URL}/${id}?width=${w}&format=webp&quality=80`;
};

// 1. Daten laden
const [settings, allEvents, dbServices, dbPartners] = await Promise.all([
  getGlobalSettings(),
  getEvents(),
  directus.request(readItems('services', {
      sort: ['sort'],
      filter: { status: { _eq: 'published' } }
  })),
  directus.request(readItems('partners', {
      sort: ['sort'],
      filter: { status: { _eq: 'published' } }
  }))
]);

// 2. Event Logik (bleibt gleich)
const today = new Date();
today.setHours(0,0,0,0);
const highlightCandidates = allEvents.filter(e => {
    const eventDate = new Date(e.date_start || e.start_date || e.date); 
    return e.is_highlight === true && eventDate >= today;
});
highlightCandidates.sort((a, b) => {
    const dateA = new Date(a.date_start || a.start_date || a.date).getTime();
    const dateB = new Date(b.date_start || b.start_date || b.date).getTime();
    return dateA - dateB;
});
const highlightEvent = highlightCandidates.length > 0 ? highlightCandidates[0] : allEvents[0];
const upcomingEvents = allEvents
  .filter(e => e.id !== highlightEvent?.id) 
  .filter(e => new Date(e.date_start || e.start_date || e.date) >= today)
  .slice(0, 3);

// 3. Daten für Hero vorbereiten
// Wir fügen hier HTML-Klassen für den Gradient hinzu
const heroHeadline = settings?.hero_headline || `Kultur verbindet.<br> <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-orange-500">Inklusion stärkt.</span>`;
const heroSubline = settings?.hero_subline || "Die Brücke ist dein Rückenwind für ein selbstbestimmtes Leben. Wir verbinden Menschen durch Kultur, Freizeit und Unterstützung im Alltag – barrierefrei, bunt und mitten in Graz.";
const heroImg = getOptimizedImg(settings?.hero_image || 'https://images.unsplash.com/photo-1511632765486-a01980e01a18', 1600);

// --- FIX: PARTNER NUR ALS ID ÜBERGEBEN ---
const optimizedPartners = dbPartners.map(p => ({
    ...p,
    logo: typeof p.logo === 'object' ? p.logo.id : p.logo
}));

const seoDescription = heroSubline.replace(/<[^>]*>/g, '');
---

<MainLayout title="Startseite" description={seoDescription} image={heroImg}>
    <style is:inline>
        .home-content { visibility: hidden; }
        html.home-ready .home-content { visibility: visible; }
    </style>
    <script is:inline>
        (function () {
            const reveal = () => document.documentElement.classList.add('home-ready');
            if (document.readyState === 'complete' || document.readyState === 'interactive') { reveal(); return; }
            window.addEventListener('DOMContentLoaded', reveal, { once: true });
            setTimeout(reveal, 1500);
        })();
    </script>

    <article class="home-content w-full">
        <Hero headline={heroHeadline} subline={heroSubline} image={heroImg} />
        <Events highlightEvent={highlightEvent} upcomingEvents={upcomingEvents} />
        <Services services={dbServices} />
        <Foundation />
        <Projects />
        <Partners partners={optimizedPartners} />
        <Pionier />
        <CTA />
    </article>
</MainLayout>