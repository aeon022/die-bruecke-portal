---
import MainLayout from '../layouts/layout.astro';
import { getEvents, getGlobalSettings } from '../lib/api';
import { nextEventDate } from '../lib/recurrence';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

// COMPONENTS
import Hero from '../components/home/Hero.astro';
import Events from '../components/home/Events.astro';
import WeekStrip from '../components/home/WeekStrip.astro';
import Services from '../components/home/Services.astro';
import Foundation from '../components/home/Foundation.astro';
import Projects from '../components/home/Projects.astro';
import Partners from '../components/home/Partners.astro';
import Pionier from '../components/home/Pionier.astro';
import CTA from '../components/home/CTA.astro';
import ZeitungTeaser from '../components/home/ZeitungTeaser.astro';
import Einfach from '../components/Einfach.astro';
import Safelist from '../components/Safelist.astro';

const ASSET_URL = 'https://api.diebruecke.social/assets'; 

// Hilfsfunktion für Hero-Bilder
const getOptimizedImg = (id, w = 800) => {
    if (!id) return null;
    if (typeof id === 'object') id = id.id;
    if (id.startsWith('/')) return id; // lokales Bild aus public/
    if (id.startsWith('http')) return `${id}?auto=format&fit=crop&w=${w}&q=60`;
    return `${ASSET_URL}/${id}?width=${w}&format=webp&quality=60`;
};

// 1. Daten laden
const [settings, allEvents, dbServices, dbPartners] = await Promise.all([
  getGlobalSettings(),
  getEvents(),
  directus.request(readItems('services', {
      sort: ['sort'],
      filter: { status: { _eq: 'published' } }
  })),
  directus.request(readItems('partners', {
      sort: ['sort'],
      filter: { status: { _eq: 'published' } }
  }))
]);

// 2. Event Logik
const today = new Date();
today.setHours(0,0,0,0);


const eventsWithDisplayDate = allEvents.map(e => ({
    ...e,
    _displayDate: nextEventDate(e),
}));

const highlightCandidates = eventsWithDisplayDate.filter(e => {
    return e.is_highlight === true && e._displayDate >= today;
});
highlightCandidates.sort((a, b) => a._displayDate.getTime() - b._displayDate.getTime());
const highlightEvent = highlightCandidates.length > 0 ? highlightCandidates[0] : eventsWithDisplayDate[0];
const upcomingEvents = eventsWithDisplayDate
  .filter(e => e.id !== highlightEvent?.id)
  .filter(e => e._displayDate >= today)
  .sort((a, b) => a._displayDate.getTime() - b._displayDate.getTime())
  .slice(0, 3);

// Streifen „Diese Woche“: heute bis 6 Tage voraus
const weekEnd = new Date(today); weekEnd.setDate(today.getDate() + 7);
const weekEvents = eventsWithDisplayDate
  .filter(e => e._displayDate >= today && e._displayDate < weekEnd)
  .sort((a, b) => a._displayDate.getTime() - b._displayDate.getTime());

// 3. Daten für Hero vorbereiten (UPDATED)
// Mapping auf die neuen Directus Keys
const heroRow1 = settings?.hero_headline || "Kultur verbindet.";
const heroRow2 = settings?.hero_headline_row2; // Neu: Zeile 2
const heroGradient = settings?.hero_gradient;  // Neu: Gradient Klassen

const heroSubline = settings?.hero_subline || "Die Brücke ist dein Rückenwind für ein selbstbestimmtes Leben. Wir verbinden Menschen durch Kultur, Freizeit und Unterstützung im Alltag – barrierefrei, bunt und mitten in Graz.";
const heroImg = getOptimizedImg(settings?.hero_image || '/images/stock/unsplash-1511632765486.jpg', 1600);

// Partner
const optimizedPartners = dbPartners.map(p => ({
    ...p,
    logo: typeof p.logo === 'object' ? p.logo.id : p.logo
}));

const seoDescription = heroSubline.replace(/<[^>]*>/g, '');
---

<MainLayout title="Die Brücke – soziokulturelles Zentrum Graz" description={seoDescription} image={heroImg} leicht>
    <style is:inline>
        .home-content { visibility: hidden; }
        html.home-ready .home-content { visibility: visible; }
    </style>
    <script is:inline>
        (function () {
            const reveal = () => document.documentElement.classList.add('home-ready');
            if (document.readyState === 'complete' || document.readyState === 'interactive') { reveal(); return; }
            window.addEventListener('DOMContentLoaded', reveal, { once: true });
            setTimeout(reveal, 1500);
        })();
    </script>

    <article class="home-content w-full">
        {/* Hier werden die neuen Props übergeben */}
        <Einfach title="Hallo! Das ist die Brücke.">
            <p>Die Brücke ist ein Haus in Graz.<br/>Die Brücke gibt es seit 1983.</p>
            <p>In der Brücke treffen sich viele Menschen.<br/>Junge und alte Menschen.<br/>Menschen mit Behinderung und Menschen ohne Behinderung.<br/>Alle gehören dazu.</p>
            <h2>Was gibt es in der Brücke?</h2>
            <ul>
                <li>Konzerte, Kabarett und Theater</li>
                <li>Urlaub mit einer Gruppe. Das heißt: Camp.</li>
                <li>Gemeinsam etwas in der Freizeit machen. Das heißt: Freizeit-Assistenz.</li>
                <li>Das Offene Haus: jeden Donnerstag von 17 bis 20 Uhr.<br/>Du musst dich nicht anmelden.</li>
            </ul>
            <h2>So kommst du zu uns</h2>
            <p>Die Brücke<br/>Grabenstraße 39a<br/>8010 Graz</p>
            <p>Die Brücke ist barrierefrei.<br/>Es gibt eine Rampe.<br/>Und es gibt ein WC für Menschen im Rollstuhl.</p>
            <h2>Hier geht es weiter</h2>
            <ul>
                <li><a href="/events">Alle Termine</a></li>
                <li><a href="/about">Über uns</a></li>
                <li><a href="/zeitung">Unsere Zeitung</a>. Es gibt sie auch in einfacher Sprache.</li>
                <li><a href="/contact">Kontakt</a>. Du kannst uns anrufen: <a href="tel:+43316672248">0316 67 22 48</a></li>
            </ul>
        </Einfach>

        <div class="hide-on-ll">
        <Hero 
            headlineRow1={heroRow1} 
            headlineRow2={heroRow2}
            gradientClasses={heroGradient}
            subline={heroSubline} 
            image={heroImg} 
        />
        </div>
        
        <WeekStrip events={weekEvents} />
        <Events highlightEvent={highlightEvent} upcomingEvents={upcomingEvents} />
        <ZeitungTeaser />
        <Services services={dbServices} />
        <Foundation />
        <Projects />
        <Partners partners={optimizedPartners} />
        <Pionier />
        <CTA />
    </article>
</MainLayout>