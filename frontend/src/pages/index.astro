---
import MainLayout from '../layouts/layout.astro';
import { getEvents, getGlobalSettings } from '../lib/api';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

// COMPONENTS
import Hero from '../components/home/Hero.astro';
import Events from '../components/home/Events.astro';
import Services from '../components/home/Services.astro';
import Foundation from '../components/home/Foundation.astro';
import Projects from '../components/home/Projects.astro';
import Partners from '../components/home/Partners.astro';
import Pionier from '../components/home/Pionier.astro';
import CTA from '../components/home/CTA.astro';

const ASSET_URL = 'https://api.diebruecke.social/assets'; 

// 1. Daten laden
const [settings, allEvents, dbServices, dbPartners] = await Promise.all([
  getGlobalSettings(),
  getEvents(),
  directus.request(readItems('services', {
      sort: ['sort'],
      filter: { status: { _eq: 'published' } }
  })),
  directus.request(readItems('partners', {
      sort: ['sort'],
      filter: { status: { _eq: 'published' } }
  }))
]);

// 2. Event Logik (DIESER BLOCK FEHLTE)
const today = new Date();
today.setHours(0,0,0,0);

// a) Highlight finden
const highlightCandidates = allEvents.filter(e => {
    const eventDate = new Date(e.date_start || e.start_date || e.date); 
    return e.is_highlight === true && eventDate >= today;
});

highlightCandidates.sort((a, b) => {
    const dateA = new Date(a.date_start || a.start_date || a.date).getTime();
    const dateB = new Date(b.date_start || b.start_date || b.date).getTime();
    return dateA - dateB;
});

const highlightEvent = highlightCandidates.length > 0 ? highlightCandidates[0] : allEvents[0];

// b) Nächste Events (ohne das Highlight)
const upcomingEvents = allEvents
  .filter(e => e.id !== highlightEvent?.id) 
  .filter(e => new Date(e.date_start || e.start_date || e.date) >= today)
  .slice(0, 3);


// 3. Hero Daten
const heroHeadline = settings?.hero_headline || `Kultur verbindet.<br> <span class="pr-2 bg-clip-text text-transparent bg-gradient-to-r from-rose-600 to-orange-400 dark:from-rose-400 dark:to-orange-300">Inklusion</span> stärkt.`;
const heroSubline = settings?.hero_subline || "Die Brücke ist dein Rückenwind für einen Alltag nach deinen Regeln. Wir schaffen den Raum in Graz, in dem Begegnung auf Augenhöhe passiert und Barrieren – ob aus Stein oder im Kopf – einfach keine Rolle spielen.";
const heroImg = settings?.hero_image 
  ? `${ASSET_URL}/${settings.hero_image}` 
  : 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=2560&auto=format&fit=crop'; 
---

<MainLayout title="Startseite">
    
    <style is:inline>
        .home-content { visibility: hidden; }
        html.home-ready .home-content { visibility: visible; }
    </style>
    <script is:inline>
        (function () {
            const reveal = () => document.documentElement.classList.add('home-ready');
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                reveal();
                return;
            }
            window.addEventListener('DOMContentLoaded', reveal, { once: true });
            setTimeout(reveal, 1500);
        })();
    </script>
    <noscript><style>.home-content{visibility:visible}</style></noscript>

    <article class="home-content w-full">
        
        <Hero 
            headline={heroHeadline}
            subline={heroSubline}
            image={heroImg}
        />

        <Events 
            highlightEvent={highlightEvent}
            upcomingEvents={upcomingEvents}
        />

        <Services 
            services={dbServices}
        />

        {/* NEU: Das Fundament/Leitbild direkt nach den Services */}
        <Foundation />

        <Projects />

        <Partners 
            partners={dbPartners}
        />

        <Pionier />

        <CTA />

    </article>
</MainLayout>