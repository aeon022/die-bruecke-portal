---
import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets';

// 1. Projekte aus Directus laden
const projects = await directus.request(readItems('projects', {
    sort: ['sort'],
    filter: { status: { _eq: 'published' } }
}));

const ASSET_URL = 'https://api.diebruecke.social/assets'; 

// Hilfsfunktion für Directus-Bildoptimierung
const getImg = (id: string, width = 800) => `${ASSET_URL}/${id}?width=${width}&format=webp&quality=80`;

// SEO-Daten
const seoTitle = "Soziale Innovation & Inklusive Projekte Graz | Die Brücke";
const seoDescription = "Das Labor für neue Wege. Von 'SofaKINO' bis 'Stage Dive'. Entdecke Projekte, die Inklusion in Graz neu definieren.";
const seoImage = "https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=1200";

const styleMap: Record<string, { gradient: string, text: string, border: string }> = {
    'SofaKINO': { 
        gradient: "from-indigo-500 to-purple-600",
        text: "group-hover:text-indigo-600",
        border: "group-hover:border-indigo-200"
    },
    'AlltagsAkademie': { 
        gradient: "from-emerald-500 to-teal-500",
        text: "group-hover:text-emerald-600",
        border: "group-hover:border-emerald-200"
    },
    'Erzähl mir was': { 
        gradient: "from-amber-400 to-orange-600",
        text: "group-hover:text-orange-600",
        border: "group-hover:border-orange-200"
    },
    'Stage Dive': { 
        gradient: "from-rose-500 to-orange-500",
        text: "group-hover:text-rose-600",
        border: "group-hover:border-rose-200"
    },
    'default': { 
        gradient: "from-slate-700 to-slate-900",
        text: "group-hover:text-slate-600",
        border: "group-hover:border-slate-300"
    }
};

const getStyle = (title: string) => {
    const key = Object.keys(styleMap).find(k => title.includes(k)) || 'default';
    return styleMap[key];
};
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>
    
    {/* --- HERO SECTION --- */}
    <section class="px-4 sm:px-6 pt-6 pb-12 transition-colors duration-500">
        <div class="relative bg-slate-900 rounded-[48px] md:rounded-[64px] overflow-hidden min-h-[55vh] flex items-center px-8 md:px-16 py-20 shadow-2xl">
            
            <div class="absolute top-0 right-0 w-2/3 h-full overflow-hidden pointer-events-none z-0">
                <div class="absolute top-[-10%] right-[-10%] w-[600px] h-[600px] bg-rose-500/20 rounded-full blur-[120px] animate-pulse-slow"></div>
                <div class="absolute bottom-[-10%] right-[10%] w-[500px] h-[500px] bg-orange-500/10 rounded-full blur-[100px]"></div>
            </div>

            <div class="relative z-10 max-w-4xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-rose-300 text-[10px] font-black uppercase tracking-widest mb-8 backdrop-blur-md">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                    Brücke Laboratorium
                </div>
                
                {/* FIX: pr-8 (Rechts-Abstand) und leading-[1.15] (Umlaut-Abstand) */}
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-black text-white leading-[1.15] md:leading-[1.1] tracking-tight mb-8 uppercase pt-4 pr-8">
                    Ideen, die <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-orange-400 italic pb-2 inline-block pr-2">Brücken bauen.</span>
                </h1>
                
                <p class="text-xl text-slate-300 max-w-xl leading-relaxed mb-10 font-medium">
                    In unseren Projekten erfinden wir Inklusion jeden Tag neu. Wir schaffen Räume für Experimente, Kultur und digitalen Fortschritt.
                </p>

                <div class="flex gap-12 mb-12 border-t border-white/10 pt-8">
                    <div>
                        <span class="block text-3xl font-bold text-white tracking-tight">{projects.length}+</span>
                        <span class="text-[10px] uppercase tracking-[0.2em] text-slate-500 font-bold">Aktive Lab-Projekte</span>
                    </div>
                    <div>
                        <span class="block text-3xl font-bold text-white tracking-tight">Graz</span>
                        <span class="text-[10px] uppercase tracking-[0.2em] text-slate-500 font-bold">Basis & Wirkung</span>
                    </div>
                </div>

                <div class="flex flex-wrap gap-4">
                    <button id="shuffleBtn" class="cursor-pointer px-8 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold border border-white/10 transition-all flex items-center gap-2 group text-xs uppercase tracking-widest">
                        <i class="fa-solid fa-shuffle group-hover:rotate-180 transition-transform duration-500"></i>
                        Mix it up
                    </button>
                    <a href="#projects-grid" class="px-8 py-4 rounded-full bg-white text-slate-900 font-bold hover:bg-rose-400 hover:text-white transition-all text-xs uppercase tracking-widest">
                        Alle entdecken
                    </a>
                </div>
            </div>
        </div>
    </section>

    {/* --- BENTO GRID --- */}
    <section id="projects-grid" class="px-4 sm:px-6 pb-32">
        <div class="max-w-7xl mx-auto">
            <div id="bento-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[minmax(350px,auto)] grid-flow-dense">
                
                {projects.map((project: any, index: number) => {
                    const styles = getStyle(project.title);
                    
                    return (
                        <article 
                            class={`bento-card group relative flex flex-col justify-between rounded-[40px] p-8 overflow-hidden transition-all duration-500 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:shadow-2xl hover:-translate-y-1 ${styles.border} hover:border-transparent cursor-pointer shadow-sm`}
                            data-index={index}
                        >
                            {project.image && (
                                <div class="absolute inset-0 z-0">
                                    <Image 
                                        src={getImg(project.image, 800)} 
                                        alt="" 
                                        width={800}
                                        height={600}
                                        class="w-full h-full object-cover opacity-0 group-hover:opacity-10 transition-opacity duration-700" 
                                    />
                                </div>
                            )}

                            <div class={`absolute inset-0 bg-gradient-to-br ${styles.gradient} opacity-0 group-hover:opacity-[0.03] transition-opacity duration-500`}></div>
                            
                            <div class="relative z-10 flex justify-between items-start mb-6">
                                <div class={`icon-box w-14 h-14 rounded-2xl bg-gradient-to-br ${styles.gradient} flex items-center justify-center text-white text-2xl shadow-lg group-hover:scale-110 group-hover:rotate-6 transition-all duration-500`}>
                                    <i class={`fa-solid ${project.icon || 'fa-star'}`}></i>
                                </div>
                                {project.category && (
                                    <span class="badge px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-widest border border-slate-200 dark:border-slate-700 group-hover:bg-white dark:group-hover:bg-slate-700 transition-all">
                                        {project.category}
                                    </span>
                                )}
                            </div>
                            
                            <div class="relative z-10 flex-grow flex flex-col justify-center">
                                <h2 class={`project-title text-3xl font-display font-bold text-slate-900 dark:text-white mb-4 leading-tight transition-colors duration-300 ${styles.text}`}>
                                    <a href={`/projects/${project.slug}`} class="before:absolute before:inset-0 before:z-20">
                                        {project.title}
                                    </a>
                                </h2>
                                <p class="project-desc text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3 group-[.is-featured]:line-clamp-6 mb-4 font-medium">
                                    {project.description?.replace(/<[^>]*>/g, '')}
                                </p>
                            </div>

                            <div class="relative z-10 mt-auto flex items-center gap-3">
                                <span class={`arrow-circle w-10 h-10 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 group-hover:bg-slate-900 group-hover:border-slate-900 group-hover:text-white transition-all duration-300 bg-white dark:bg-slate-800`}>
                                     <i class="fa-solid fa-arrow-right -rotate-45 group-hover:rotate-0 transition-transform duration-300"></i>
                                </span>
                                <span class="cta-text text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300">
                                   Projekt entdecken
                                </span>
                            </div>

                            <div class={`absolute -bottom-10 -right-10 w-40 h-40 rounded-full bg-gradient-to-br ${styles.gradient} opacity-20 group-hover:opacity-40 group-hover:scale-[2.5] transition-all duration-700 blur-[60px] pointer-events-none mix-blend-multiply dark:mix-blend-screen`}></div>
                        </article>
                    );
                })}

                {/* --- STATIC CARD --- */}
                <div class="bento-card static-card relative rounded-[40px] p-8 min-h-[350px] flex flex-col justify-center items-center text-center overflow-hidden bg-slate-900 border border-slate-800 shadow-2xl hover:scale-[1.01] transition-transform duration-500 group/static">
                    <div class="relative z-10">
                        <div class="w-16 h-16 mx-auto rounded-2xl bg-white/10 flex items-center justify-center text-white text-3xl mb-6 backdrop-blur-sm border border-white/10 shadow-xl rotate-[-6deg] group-hover/static:rotate-0 transition-transform duration-500">
                            <i class="fa-solid fa-rocket"></i>
                        </div>
                        <h3 class="text-3xl font-display font-bold text-white mb-3 tracking-tight leading-tight uppercase">
                            Dein Projekt <br/><span class="text-rose-400 italic">startet hier.</span>
                        </h3>
                        <p class="text-slate-400 text-base mb-8 max-w-[280px] mx-auto leading-relaxed">
                            Die Brücke ist dein Inkubator für inklusive Visionen. Lass uns gemeinsam starten.
                        </p>
                        <a href="/contact" class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white text-slate-900 font-bold hover:bg-rose-500 hover:text-white transition-all shadow-lg text-[10px] uppercase tracking-widest group/btn relative z-30">
                            Initiative starten
                            <i class="fa-solid fa-arrow-right group-hover/btn:translate-x-1 transition-transform"></i>
                        </a>
                     </div>
                </div>

            </div>
        </div>
    </section>

    <script>
        function shuffleHighlights() {
            const cards = document.querySelectorAll('.bento-card');
            if (cards.length === 0) return;
            
            cards.forEach(card => {
                if(card.classList.contains('static-card')) return;
                card.classList.remove('is-featured', 'md:col-span-2', 'md:row-span-2');
                const title = card.querySelector('.project-title');
                if(title) { title.classList.remove('md:text-5xl'); title.classList.add('text-3xl'); }
                const iconBox = card.querySelector('.icon-box');
                if(iconBox) { iconBox.classList.remove('w-20', 'h-20', 'text-4xl'); iconBox.classList.add('w-14', 'h-14', 'text-2xl'); }
            });

            const dynamicCards = Array.from(cards).filter(c => !c.classList.contains('static-card'));
            if(dynamicCards.length === 0) return;
            const randomIndex = Math.floor(Math.random() * dynamicCards.length);
            const winner = dynamicCards[randomIndex] as HTMLElement;

            winner.classList.add('is-featured', 'md:col-span-2', 'md:row-span-2');
            const title = winner.querySelector('.project-title');
            if(title) { title.classList.remove('text-3xl'); title.classList.add('md:text-5xl'); }
            const iconBox = winner.querySelector('.icon-box');
            if(iconBox) { iconBox.classList.remove('w-14', 'h-14', 'text-2xl'); iconBox.classList.add('w-20', 'h-20', 'text-4xl'); }
        }
        document.addEventListener('DOMContentLoaded', shuffleHighlights);
        document.getElementById('shuffleBtn')?.addEventListener('click', shuffleHighlights);
    </script>
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Soziale Innovationen & Projekte Die Brücke Graz",
  "itemListElement": projects.map((project: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://diebruecke.cc/projects/${project.slug}`,
    "name": project.title
  }))
})} />