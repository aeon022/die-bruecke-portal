---
export const prerender = false;

import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets';

import VideoPlayer from '../../components/common/VideoPlayer.astro';

const { slug } = Astro.params;

let trip = null;

try {
  const result = await directus.request(readItems('city_trips', {
    filter: {
      slug: { _eq: slug },
      status: { _eq: 'published' }
    },
    fields: ['*', 'video_url'] 
  }));
  if (result && result.length > 0) trip = result[0];
} catch (error) {
  console.error(`Fehler bei City Trip ${slug}:`, error);
}

if (!trip) return Astro.redirect('/404');

const ASSET_URL = (import.meta.env.PUBLIC_API_URL || "https://api.diebruecke.social") + "/assets";
const heroImage = trip.image ? `${ASSET_URL}/${trip.image}` : null;

// --- SEO GENERATOR ---
const seoTitle = `${trip.title} | Inklusiver City Trip Graz`;
const cleanDesc = trip.description?.replace(/<[^>]*>/g, '') || "";
const seoDescription = cleanDesc.length > 160 ? cleanDesc.substring(0, 157) + "..." : cleanDesc;
const seoImage = heroImage || "https://diebruecke.cc/share-trips.jpg";
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>

    {/* --- HERO SECTION: STUDIO LOOK --- */}
    <section class="px-4 sm:px-6 pt-6 pb-12 transition-colors duration-500">
        <div class="relative bg-slate-900 rounded-[48px] md:rounded-[64px] overflow-hidden min-h-[60vh] flex items-center shadow-2xl">
            
            <div class="absolute inset-0 z-0">
                {heroImage ? (
                    <img 
                        src={heroImage} 
                        alt={trip.title} 
                        class="w-full h-full object-cover opacity-40 scale-105" 
                    />
                ) : (
                    <div class="w-full h-full bg-slate-800"></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-transparent to-transparent opacity-80"></div>
            </div>

            <div class="relative z-10 w-full px-8 md:px-16 py-20">
                <div class="max-w-7xl mx-auto">
                    
                    <div class="mb-12 flex flex-wrap gap-3">
                        <a href="/city-trips" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-all text-[10px] font-black uppercase tracking-widest group shadow-lg">
                            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> 
                            Alle Ausflüge
                        </a>
                        <a href="/camps" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-white/50 hover:text-white hover:bg-rose-500/20 transition-all text-[10px] font-black uppercase tracking-widest group">
                            <i class="fa-solid fa-tent text-[9px]"></i> 
                            Zu den Camps
                        </a>
                    </div>
                    
                    <div class="max-w-4xl">
                        <div class="flex flex-wrap gap-3 mb-8">
                            {trip.free_spots > 0 ? (
                                <div class="px-4 py-1.5 rounded-full bg-emerald-500/20 backdrop-blur-md text-emerald-400 border border-emerald-500/30 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                    {trip.free_spots} Plätze frei
                                </div>
                            ) : (
                                <div class="px-4 py-1.5 rounded-full bg-rose-500/20 backdrop-blur-md text-rose-400 border border-rose-500/30 text-[10px] font-black uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                    Ausgebucht
                                </div>
                            )}
                            
                            {trip.fass_hours && (
                                <div class="px-4 py-1.5 rounded-full bg-indigo-500/20 backdrop-blur-md text-indigo-300 border border-indigo-500/30 text-[10px] font-black uppercase tracking-widest">
                                    {trip.fass_hours}h FASS anrechenbar
                                </div>
                            )}
                        </div>

                        <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-black text-white mb-8 leading-[1.05] tracking-tighter uppercase">
                            {trip.title}
                        </h1>
                        
                        <div class="flex flex-wrap gap-8 text-slate-300 font-bold uppercase tracking-widest text-xs">
                             <div class="flex items-center gap-3">
                                <i class="fa-regular fa-calendar text-indigo-400 text-lg"></i>
                                {trip.date_range}
                             </div>
                             <div class="flex items-center gap-3">
                                <i class="fa-solid fa-location-dot text-rose-500 text-lg"></i>
                                {trip.location}
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 px-6 bg-white dark:bg-slate-950 transition-colors duration-500">
        <div class="container mx-auto">
            <div class="grid lg:grid-cols-12 gap-16 max-w-7xl mx-auto">
                
                {/* --- LINKE SPALTE --- */}
                <div class="lg:col-span-8">
                    <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] font-black text-rose-500 uppercase tracking-[0.2em] mb-8">
                        Trip Details
                    </div>
                    <h2 class="text-4xl font-display font-black text-slate-900 dark:text-white mb-10 tracking-tight uppercase">
                        Was wir gemeinsam <span class="text-indigo-600 italic">erleben.</span>
                    </h2>
                    
                    <div class="prose prose-lg dark:prose-invert text-slate-600 dark:text-slate-400 prose-headings:font-display prose-headings:font-bold max-w-none" set:html={trip.description}></div>

                    {trip.video_url && (
                        <div class="mt-16 pt-8 border-t border-slate-100 dark:border-slate-800">
                            <h3 class="font-display font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase mb-6">
                                Vorschau <span class="text-rose-500">Video</span>
                            </h3>
                            <VideoPlayer url={trip.video_url} poster={heroImage} />
                        </div>
                    )}

                    {/* --- STORNO REGELN --- */}
                    <div class="mt-16 p-8 md:p-10 bg-indigo-50/50 dark:bg-slate-900 border border-indigo-100 dark:border-slate-800 rounded-[32px] shadow-sm">
                        <div class="inline-flex items-center gap-3 px-3 py-1 rounded-full bg-indigo-100 dark:bg-indigo-900/30 text-[10px] font-black text-indigo-600 dark:text-indigo-400 uppercase tracking-[0.2em] mb-6">
                            Wichtige Infos
                        </div>
                        <h3 class="font-display font-black text-2xl md:text-3xl text-slate-900 dark:text-white mb-4 uppercase tracking-tight">
                            Wenn mal was <span class="text-indigo-600 italic">dazwischenkommt.</span>
                        </h3>
                        <p class="text-slate-600 dark:text-slate-400 mb-8 font-medium leading-relaxed max-w-2xl">
                            Du freust dich auf dein Brücke-Camp oder den City-Trip, aber manchmal läuft das Leben einfach anders als geplant. So regeln wir das fair für alle:
                        </p>
                        <ul class="space-y-6">
                            <li class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-800 flex items-center justify-center text-indigo-500 shrink-0 shadow-sm mt-1">
                                    <i class="fa-solid fa-calendar-check text-sm"></i>
                                </div>
                                <div class="text-slate-600 dark:text-slate-400 leading-relaxed text-sm md:text-base">
                                    <strong class="text-slate-900 dark:text-white font-bold block mb-1">Kostenlos abmelden</strong> 
                                    Bei jedem Camp und City-Trip steht im Programm ein genaues Datum. Bis zu diesem Tag kannst du dich einfach und gratis wieder abmelden.
                                </div>
                            </li>
                            <li class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-800 flex items-center justify-center text-slate-500 shrink-0 shadow-sm mt-1">
                                    <i class="fa-solid fa-clock-rotate-left text-sm"></i>
                                </div>
                                <div class="text-slate-600 dark:text-slate-400 leading-relaxed text-sm md:text-base">
                                    <strong class="text-slate-900 dark:text-white font-bold block mb-1">Zu spät abgemeldet?</strong> 
                                    Wenn du dich nach diesem Datum abmeldest, musst du die Kosten für den Urlaub leider komplett selbst bezahlen.
                                </div>
                            </li>
                            <li class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-800 flex items-center justify-center text-emerald-500 shrink-0 shadow-sm mt-1">
                                    <i class="fa-solid fa-notes-medical text-sm"></i>
                                </div>
                                <div class="text-slate-600 dark:text-slate-400 leading-relaxed text-sm md:text-base">
                                    <strong class="text-slate-900 dark:text-white font-bold block mb-1">Ausnahme bei Krankheit</strong> 
                                    Wenn du krank wirst, musst du natürlich nicht zahlen. Wir brauchen in dem Fall aber bitte eine kurze Bestätigung von deinem Arzt oder deiner Ärztin.
                                </div>
                            </li>
                            <li class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-800 flex items-center justify-center text-rose-500 shrink-0 shadow-sm mt-1">
                                    <i class="fa-solid fa-signature text-sm"></i>
                                </div>
                                <div class="text-slate-600 dark:text-slate-400 leading-relaxed text-sm md:text-base">
                                    <strong class="text-slate-900 dark:text-white font-bold block mb-1">Wichtig für die Anmeldung</strong> 
                                    Wenn du eine:n Erwachsenenvertreter:in hast, brauchen wir für deine fixe Anmeldung ein kurzes schriftliches „Okay“ (eine E-Mail reicht völlig) von dieser Person.
                                </div>
                            </li>
                        </ul>
                    </div>

                </div>

                {/* --- RECHTE SPALTE --- */}
                <div class="lg:col-span-4">
                    <div class="bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[48px] p-10 sticky top-24 shadow-sm">
                        <h3 class="text-xs font-black text-slate-400 uppercase tracking-[0.3em] mb-10 text-center border-b border-slate-200 dark:border-slate-800 pb-4">Inkludierte Leistungen</h3>
                        
                        <div class="space-y-8 mb-12">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 text-xl shadow-sm shrink-0">
                                    <i class="fa-solid fa-bus-simple"></i>
                                </div>
                                <div>
                                    <span class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Transfer</span>
                                    <span class="text-slate-900 dark:text-white font-bold">Barrierefreie Anreise</span>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-rose-500 text-xl shadow-sm shrink-0">
                                    <i class="fa-solid fa-user-shield"></i>
                                </div>
                                <div>
                                    <span class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Begleitung</span>
                                    <span class="text-slate-900 dark:text-white font-bold">Professionelles Team</span>
                                </div>
                            </div>
                            
                            <div class="p-6 md:p-8 bg-white dark:bg-slate-800 rounded-[24px] md:rounded-[32px] border border-slate-100 dark:border-slate-700 mt-6 shadow-inner text-center">
                                
                                {trip.price != null && (
                                    <>
                                        <span class="text-slate-400 text-[10px] font-black uppercase tracking-widest block mb-2">Selbstbehalt</span>
                                        <div class="text-3xl md:text-4xl font-display font-black text-slate-900 dark:text-white mb-2">
                                            € {trip.price}
                                        </div>
                                    </>
                                )}
                                
                                {/* GEÄNDERT: FASS Text */}
                                {trip.fass_hours && (
                                    <div class={`text-[9px] md:text-[10px] font-bold text-indigo-500 uppercase tracking-widest flex items-center justify-center gap-2 ${trip.price != null ? "mt-4 pt-4 border-t border-slate-50 dark:border-slate-700" : ""}`}>
                                        <i class="fa-solid fa-circle-info"></i> {trip.fass_hours}h vom gültigen FASS Bescheid
                                    </div>
                                )}

                                <div class="mt-4 pt-4 border-t border-slate-50 dark:border-slate-700 text-[10px] font-medium text-slate-500 dark:text-slate-400 leading-tight">
                                    <i class="fa-solid fa-wallet text-slate-400 mr-1.5"></i> 
                                    Die Teilnahme als Selbstzahler:in (ohne FASS-Bescheid) ist ebenfalls möglich!
                                </div>
                            </div>
                        </div>

                        {/* --- CTA BUTTON MIT MAILTO --- */}
                        <div class="mt-10">
                            <a href={`mailto:office@diebruecke.cc?subject=${encodeURIComponent('Anfrage City-Trip: ' + trip.title)}`} 
                               class="group block w-full py-5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-center font-black uppercase tracking-widest text-xs rounded-2xl transition-all shadow-xl hover:bg-rose-600 dark:hover:bg-rose-500 dark:hover:text-white transform hover:-translate-y-1">
                                Jetzt Platz sichern
                                <i class="fa-solid fa-envelope ml-2 group-hover:scale-110 transition-transform"></i>
                            </a>
                            <p class="text-[10px] text-slate-400 text-center mt-6 font-bold uppercase tracking-widest">
                                Begrenztes Kontingent
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

</MainLayout>

<style>
    img {
        animation: hero-reveal 2s ease-out forwards;
    }
    @keyframes hero-reveal {
        from { transform: scale(1.1); opacity: 0; }
        to { transform: scale(1.05); opacity: 0.4; }
    }
</style>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": trip.title,
  "description": seoDescription,
  "image": [seoImage],
  "touristType": "People with disabilities",
  "itinerary": {
    "@type": "City",
    "name": trip.location
  },
  "offers": {
    "@type": "Offer",
    "price": trip.price || "0",
    "priceCurrency": "EUR",
    "url": Astro.url.href,
    "availability": trip.free_spots > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
  },
  "provider": {
    "@type": "Organization",
    "name": "Die Brücke - soziokulturelles Zentrum",
    "url": "https://diebruecke.cc"
  }
})} />