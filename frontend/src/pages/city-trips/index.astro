---
import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets';

// 1. Daten laden (Collection: city_trips)
const trips = await directus.request(readItems('city_trips', {
    filter: { status: { _eq: 'published' } },
    sort: ['sort', 'date_range'] 
}));

const ASSET_URL = "https://api.diebruecke.social/assets";

// Hilfsfunktion für Directus-Bildoptimierung (spart ca. 80-90% Datenmenge)
const getOptimizedImg = (id, width = 800) => `${ASSET_URL}/${id}?width=${width}&format=webp&quality=80`;

// 2. Featured-Logik
const featuredTrip = trips.find((t: any) => t.is_featured) || trips[0];

// --- SEO CONFIG ---
const seoTitle = "Barrierefreie Reisen & Ausflüge Graz | City Trips";
const seoDescription = "Raus aus dem Alltag! Entdecke unsere inklusiven City Trips und barrierefreien Ausflüge ab Graz. Professionelle Begleitung und volle Barrierefreiheit.";
const seoImage = featuredTrip?.image ? getOptimizedImg(featuredTrip.image, 1200) : "https://diebruecke.cc/share-trips.jpg";
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>
    
    {/* --- HERO SECTION (Featured Trip) --- */}
    {featuredTrip && (
        <section class="px-4 sm:px-6 pt-6 pb-20 transition-colors duration-500">
            <div class="relative bg-slate-900 rounded-[48px] md:rounded-[64px] overflow-hidden min-h-[60vh] flex items-center px-6 md:px-16 py-20 shadow-2xl">
                
                {/* Background Layer mit LCP Optimierung */}
                <div class="absolute inset-0 z-0">
                    {featuredTrip.image && (
                         <Image 
                            src={getOptimizedImg(featuredTrip.image, 1600)} 
                            alt={`Inklusiv-Reise nach ${featuredTrip.title}`} 
                            width={1600}
                            height={900}
                            loading="eager"
                            fetchpriority="high"
                            class="w-full h-full object-cover opacity-50 grayscale hover:grayscale-0 transition-all duration-1000 scale-105" 
                        />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/60 to-transparent"></div>
                </div>

                {/* Content z-30 für volle Klickbarkeit */}
                <div class="relative z-30 w-full">
                    
                    {/* --- NAVIGATION LINKS --- */}
                    <div class="mb-12 flex flex-wrap gap-3">
                        <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-all text-[10px] font-black uppercase tracking-widest group">
                            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> 
                            Startseite
                        </a>
                        <a href="/camps" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-500/10 backdrop-blur-md border border-rose-500/20 text-rose-300 hover:text-white hover:bg-rose-600/30 transition-all text-[10px] font-black uppercase tracking-widest group">
                            <i class="fa-solid fa-tent text-[9px]"></i> 
                            Zu den Camps 2026
                        </a>
                    </div>

                    <div class="max-w-2xl">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-500/30 text-indigo-400 text-[10px] font-black uppercase tracking-widest mb-6 backdrop-blur-md">
                            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span> 
                            Highlight-Trip
                        </div>

                        {/* Leading fix für Umlaute */}
                        <h1 class="text-5xl md:text-8xl font-display font-black text-white mb-6 leading-[1.02] tracking-tighter uppercase">
                            {featuredTrip.title}
                        </h1>
                        
                        <p class="text-xl text-slate-300 mb-10 leading-relaxed line-clamp-3 font-medium border-l-4 border-indigo-500 pl-6">
                            {featuredTrip.description?.replace(/<[^>]*>?/gm, '')}
                        </p>
                        
                        <div class="flex flex-wrap gap-6 mb-10 text-[10px] font-black uppercase tracking-widest text-slate-200">
                            <span class="flex items-center gap-2 bg-white/5 px-4 py-2 rounded-xl border border-white/10 backdrop-blur-sm">
                                <i class="fa-regular fa-calendar text-indigo-400 text-base"></i> {featuredTrip.date_range}
                            </span>
                            <span class="flex items-center gap-2 bg-white/5 px-4 py-2 rounded-xl border border-white/10 backdrop-blur-sm">
                                <i class="fa-solid fa-location-dot text-indigo-400 text-base"></i> {featuredTrip.location}
                            </span>
                        </div>

                        <div class="flex flex-wrap gap-4">
                            <a href={`/city-trips/${featuredTrip.slug}`} class="bg-white text-slate-900 px-10 py-5 rounded-full font-black uppercase tracking-widest text-xs hover:bg-indigo-500 hover:text-white transition-all shadow-xl transform hover:-translate-y-1">
                                Trip-Details ansehen
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    )}

    {/* --- LIST SECTION --- */}
    <section class="px-4 sm:px-6 pb-32">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
                <div>
                    <span class="text-indigo-600 font-bold tracking-widest uppercase text-xs mb-3 block">Reise-Kalender</span>
                    <h2 class="text-4xl md:text-5xl font-display font-black text-slate-900 dark:text-white tracking-tight uppercase">Aktuelle <span class="text-indigo-600 italic">Ausflüge.</span></h2>
                </div>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
                {trips.map((trip: any) => (
                    <article class="group relative bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[40px] overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col h-full shadow-sm cursor-pointer">
                        
                        {/* Bild-Bereich mit optimierter Größe */}
                        <div class="relative h-64 overflow-hidden bg-slate-100">
                            {trip.image ? (
                                <Image 
                                    src={getOptimizedImg(trip.image, 800)} 
                                    alt={trip.title}
                                    width={800}
                                    height={500}
                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-[1.5s]" 
                                />
                            ) : (
                                <div class="w-full h-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-300"><i class="fa-solid fa-bus text-5xl"></i></div>
                            )}
                            <div class="absolute top-6 right-6 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-2 rounded-2xl text-sm font-black text-slate-900 dark:text-white shadow-xl z-10">
                                € {trip.price}
                            </div>
                        </div>
                        
                        <div class="p-8 flex flex-col flex-grow">
                            <div class="flex gap-4 text-[10px] font-black text-indigo-500 uppercase tracking-[0.2em] mb-4">
                                <span><i class="fa-regular fa-calendar mr-1"></i> {trip.date_range}</span>
                            </div>
                            
                            <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white mb-4 leading-tight group-hover:text-indigo-600 transition-colors uppercase tracking-tight">
                                {/* STRETCHED LINK: Gesamte Karte klickbar + Cursorpointer */}
                                <a href={`/city-trips/${trip.slug}`} class="before:absolute before:inset-0 before:z-20">
                                    {trip.title}
                                </a>
                            </h3>

                            {trip.fass_hours && (
                                <div class="mb-6 inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 text-[10px] font-black uppercase tracking-widest border border-emerald-100 dark:border-emerald-800 w-fit relative z-10">
                                    <i class="fa-solid fa-clock"></i> {trip.fass_hours}h FASS
                                </div>
                            )}
                            
                            <div class="pt-6 border-t border-slate-50 dark:border-slate-800 flex items-center justify-between mt-auto">
                                <div class="flex items-center gap-2 text-xs font-bold relative z-10">
                                    {trip.free_spots > 0 ? (
                                        <span class="text-emerald-600 flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> 
                                            {trip.free_spots} Plätze
                                        </span>
                                    ) : (
                                        <span class="text-rose-500 flex items-center gap-2 uppercase tracking-widest">
                                            <span class="w-2 h-2 rounded-full bg-rose-500"></span> Ausgebucht
                                        </span>
                                    )}
                                </div>
                                <div class="w-10 h-10 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 relative z-10">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

</MainLayout>

{/* SCHEMA.ORG */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Barrierefreie Reisen & Ausflüge Die Brücke Graz",
  "description": seoDescription,
  "itemListElement": trips.map((trip: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://diebruecke.cc/city-trips/${trip.slug}`,
    "name": trip.title
  }))
})} />