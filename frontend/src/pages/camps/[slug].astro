---
export const prerender = false;

import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets';

// Import der Komponenten
import ImageGallery from '../../components/common/ImageGallery.astro';
import VideoPlayer from '../../components/common/VideoPlayer.astro';

const { slug } = Astro.params;

let camp = null;

try {
  const result = await directus.request(readItems('camps', {
    filter: {
      slug: { _eq: slug },
      status: { _eq: 'published' }
    },
    // WICHTIG: 'video_url' muss hier dabei sein!
    fields: ['*', 'gallery.*', 'gallery.directus_files_id.*', 'video_url']
  }));
  if (result && result.length > 0) camp = result[0];
} catch (error) {
  console.error(`Fehler beim Laden des Camps ${slug}:`, error);
}

if (!camp) return Astro.redirect('/404');

// API URL Logik
const ASSET_URL = (import.meta.env.PUBLIC_API_URL || "https://api.diebruecke.social") + "/assets";
const heroImage = camp.image ? `${ASSET_URL}/${camp.image}` : null;

// --- SEO GENERATOR ---
const seoTitle = `${camp.title} 2026 | Inklusives Camp | Die Brücke Graz`;
const cleanDescription = camp.description?.replace(/<[^>]*>/g, '').substring(0, 160).trim() + "...";
const seoImage = heroImage || "https://diebruecke.cc/share-camps.jpg";

const getFlag = (location: string) => {
    if (!location) return '📍';
    const loc = location.toLowerCase();
    if (loc.includes('österreich') || loc.includes('austria')) return '🇦🇹';
    if (loc.includes('kroatien') || loc.includes('croatia')) return '🇭🇷';
    if (loc.includes('italien') || loc.includes('italy')) return '🇮🇹';
    return '🌍';
};
---

<MainLayout 
    title={seoTitle}
    description={cleanDescription}
    image={seoImage}
>

    {/* --- HERO SECTION --- */}
    <section class="px-4 sm:px-6 pt-4 pb-12 transition-colors duration-500">
        <div class="relative bg-slate-900 rounded-[40px] md:rounded-[64px] overflow-hidden min-h-[60vh] md:min-h-[65vh] flex items-center shadow-2xl">
            
            {/* Background Image Layer */}
            <div class="absolute inset-0 z-0">
                {heroImage ? (
                    <img 
                        src={heroImage} 
                        alt={camp.title} 
                        class="w-full h-full object-cover opacity-40 scale-105" 
                    />
                ) : (
                    <div class="w-full h-full bg-slate-800"></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-transparent to-transparent opacity-80"></div>
            </div>

            <div class="relative z-10 w-full px-6 md:px-16 py-12 md:py-20">
                <div class="max-w-7xl mx-auto">
                    {/* Back Link */}
                    <div class="mb-8 md:mb-12">
                        <a href="/camps" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-all text-[10px] md:text-xs font-bold uppercase tracking-widest group">
                            <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> 
                            Alle Reisen
                        </a>
                    </div>
                    
                    <div class="max-w-4xl">
                        <div class="flex flex-wrap gap-2 md:gap-3 mb-6 md:mb-8">
                            {camp.free_spots > 0 ? (
                                <div class="px-3 md:px-4 py-1.5 rounded-full bg-emerald-500/20 backdrop-blur-md text-emerald-400 border border-emerald-500/30 text-[9px] md:text-[10px] font-black uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    {camp.free_spots} Plätze frei
                                </div>
                            ) : (
                                <div class="px-3 md:px-4 py-1.5 rounded-full bg-rose-500/20 backdrop-blur-md text-rose-400 border border-rose-500/30 text-[9px] md:text-[10px] font-black uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                    Warteliste
                                </div>
                            )}
                            
                            {camp.fass_hours && (
                                <div class="px-3 md:px-4 py-1.5 rounded-full bg-indigo-500/20 backdrop-blur-md text-indigo-300 border border-indigo-500/30 text-[9px] md:text-[10px] font-black uppercase tracking-widest">
                                    FASS anrechenbar
                                </div>
                            )}
                        </div>

                        <h1 class="text-4xl md:text-7xl lg:text-8xl font-display font-black text-white mb-8 leading-[1.05] md:leading-[1.02] tracking-tighter uppercase break-words">
                            {camp.title}
                        </h1>
                        
                        <div class="flex flex-wrap gap-6 md:gap-8 text-slate-300 font-bold uppercase tracking-widest text-[10px] md:text-xs">
                             <div class="flex items-center gap-2">
                                <i class="fa-regular fa-calendar text-rose-500 text-base md:text-lg"></i>
                                {camp.date_range}
                             </div>
                             <div class="flex items-center gap-2">
                                <span class="text-xl md:text-2xl">{getFlag(camp.location)}</span>
                                {camp.location}
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="py-12 md:py-24 px-4 md:px-6 bg-white dark:bg-slate-950 transition-colors duration-500">
        <div class="container mx-auto">
            <div class="grid lg:grid-cols-12 gap-10 md:gap-16 max-w-7xl mx-auto">
                
                {/* --- LINKE SPALTE: TEXT, VIDEO & GALERIE --- */}
                <div class="lg:col-span-8">
                    <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] font-black text-rose-500 uppercase tracking-[0.2em] mb-6 md:mb-8">
                        Camp Beschreibung
                    </div>
                    <h2 class="text-3xl md:text-4xl font-display font-black text-slate-900 dark:text-white mb-8 md:mb-10 tracking-tight uppercase">
                        Zeit für <span class="text-rose-600 italic">Abenteuer.</span>
                    </h2>
                    
                    {/* Beschreibungstext */}
                    <div class="prose prose-md md:prose-lg dark:prose-invert text-slate-600 dark:text-slate-400 prose-headings:font-display prose-headings:font-bold prose-a:text-rose-600 max-w-none" set:html={camp.description}></div>

                    {/* --- VIDEO PLAYER BEREICH --- */}
                    {camp.video_url && (
                        <div class="mt-16 pt-8 border-t border-slate-100 dark:border-slate-800">
                            <h3 class="font-display font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase mb-6">
                                Camp <span class="text-rose-500">Video</span>
                            </h3>
                            <VideoPlayer url={camp.video_url} poster={heroImage} />
                        </div>
                    )}

                    {/* --- GALERIE BEREICH --- */}
                    {camp.gallery && camp.gallery.length > 0 && (
                        <div class="mt-16 pt-8 border-t border-slate-100 dark:border-slate-800">
                            <h3 class="font-display font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase mb-6">
                                Eindrücke & <span class="text-indigo-500 italic">Momente</span>
                            </h3>
                            <p class="text-slate-500 dark:text-slate-400 mb-8 max-w-xl">
                                Ein kleiner Vorgeschmack darauf, was dich erwartet. Bilder sagen mehr als tausend Worte.
                            </p>
                            
                            <ImageGallery gallery={camp.gallery} />
                        </div>
                    )}
                </div>

                {/* --- RECHTE SPALTE: INFO BOX --- */}
                <div class="lg:col-span-4">
                    <div class="bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[32px] md:rounded-[48px] p-8 md:p-10 sticky top-24 shadow-sm">
                        <h3 class="text-xs font-black text-slate-400 uppercase tracking-[0.3em] mb-8 md:mb-10 text-center border-b border-slate-200 dark:border-slate-800 pb-4">Reisedaten</h3>
                        
                        <div class="space-y-6 md:space-y-8 mb-10 md:mb-12">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl md:rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-rose-600 text-lg md:text-xl shadow-sm shrink-0">
                                    <i class="fa-regular fa-calendar"></i>
                                </div>
                                <div>
                                    <span class="block text-[9px] md:text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Zeitraum</span>
                                    <span class="text-slate-900 dark:text-white font-bold text-sm md:text-base">{camp.date_range}</span>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl md:rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-indigo-600 text-lg md:text-xl shadow-sm shrink-0">
                                    <i class="fa-solid fa-location-dot"></i>
                                </div>
                                <div>
                                    <span class="block text-[9px] md:text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Zielort</span>
                                    <span class="text-slate-900 dark:text-white font-bold text-sm md:text-base">{camp.location}</span>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl md:rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-center text-emerald-600 text-lg md:text-xl shadow-sm shrink-0">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                                <div>
                                    <span class="block text-[9px] md:text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Altersgruppe</span>
                                    <span class="text-slate-900 dark:text-white font-bold text-sm md:text-base">{camp.age_range || 'Alle Altersgruppen'}</span>
                                </div>
                            </div>
                            
                            <div class="p-6 md:p-8 bg-white dark:bg-slate-800 rounded-[24px] md:rounded-[32px] border border-slate-100 dark:border-slate-700 mt-6 shadow-inner text-center">
                                <span class="text-slate-400 text-[10px] font-black uppercase tracking-widest block mb-2">Selbstbehalt</span>
                                <div class="text-3xl md:text-4xl font-display font-black text-slate-900 dark:text-white mb-2">
                                    € {camp.price}
                                </div>
                                {camp.fass_hours && (
                                    <div class="mt-4 pt-4 border-t border-slate-50 dark:border-slate-700 text-[9px] md:text-[10px] font-bold text-indigo-500 uppercase tracking-widest flex items-center justify-center gap-2">
                                        <i class="fa-solid fa-circle-info"></i> {camp.fass_hours}h FASS / Tag
                                    </div>
                                )}
                            </div>
                        </div>

                        <div class="mt-10">
                            <a href={`/contact?subject=Anfrage für Camp: ${camp.title}`} 
                               class="group block w-full py-4 md:py-5 bg-rose-600 hover:bg-slate-900 dark:hover:bg-white dark:hover:text-slate-900 text-white text-center font-black uppercase tracking-widest text-[10px] md:text-xs rounded-xl md:rounded-2xl transition-all shadow-xl shadow-rose-200 dark:shadow-none transform hover:-translate-y-1">
                                Unverbindlich anfragen
                                <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

</MainLayout>

<style>
    img {
        animation: hero-reveal 2s ease-out forwards;
    }
    @keyframes hero-reveal {
        from { transform: scale(1.1); opacity: 0; }
        to { transform: scale(1.05); opacity: 0.4; }
    }
</style>

{/* --- SCHEMA.ORG --- */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": camp.title,
  "description": cleanDescription,
  "image": [seoImage],
  "touristType": "People with disabilities",
  "itinerary": {
    "@type": "City",
    "name": camp.location
  },
  "offers": {
    "@type": "Offer",
    "price": camp.price || "0",
    "priceCurrency": "EUR",
    "url": "https://diebruecke.cc" + Astro.url.pathname,
    "availability": camp.free_spots > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
  },
  "provider": {
    "@type": "Organization",
    "name": "Die Brücke - soziokulturelles Zentrum",
    "url": "https://diebruecke.cc"
  }
})} />