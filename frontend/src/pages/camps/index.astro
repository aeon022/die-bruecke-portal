---
import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets';

// 1. Daten laden: Camps und City Trips separat fetchen
const rawCamps = await directus.request(readItems('camps', {
    filter: { status: { _eq: 'published' } },
    sort: ['sort'] 
}));

const rawCityTrips = await directus.request(readItems('city_trips', {
    filter: { status: { _eq: 'published' } },
    sort: ['sort'] 
})).catch(() => []); // Fallback, falls die Collection z.B. citytrips heißt

// 2. Arrays vorbereiten und mergen
const camps = rawCamps.map((c: any) => ({ ...c, base_path: 'camps' }));
const cityTrips = rawCityTrips.map((c: any) => ({ ...c, base_path: 'city-trips' }));

const allReisen = [...camps, ...cityTrips].sort((a, b) => {
    const sortA = a.sort !== null && a.sort !== undefined ? a.sort : 999;
    const sortB = b.sort !== null && b.sort !== undefined ? b.sort : 999;
    return sortA - sortB;
});

const ASSET_URL = "https://api.diebruecke.social/assets";

// Wir suchen das Featured Item aus ALLEN Reisen, sonst nehmen wir das erste aus der gemischten Liste
const featuredTrip = allReisen.find((c: any) => c.is_featured) || allReisen[0];

// Hilfsfunktion für Directus-Optimierung (Serverseitig)
const getImg = (id: string, w = 800) => `${ASSET_URL}/${id}?width=${w}&format=webp&quality=80`;

const getFlag = (location: string) => {
    if (!location) return '📍';
    const loc = location.toLowerCase();
    if (loc.includes('österreich') || loc.includes('austria')) return '🇦🇹';
    if (loc.includes('kroatien') || loc.includes('croatia') || loc.includes('istrien')) return '🇭🇷';
    if (loc.includes('italien') || loc.includes('italy')) return '🇮🇹';
    if (loc.includes('slowenien') || loc.includes('slovenia')) return '🇸🇮';
    if (loc.includes('ungarn') || loc.includes('hungary')) return '🇭🇺';
    if (loc.includes('tschechien') || loc.includes('czech')) return '🇨🇿';
    if (loc.includes('deutschland') || loc.includes('germany')) return '🇩🇪';
    return '🌍';
};

function cleanDesc(html: string) {
    if (!html) return "";
    return html.replace(/<[^>]*>?/gm, '').slice(0, 160).trim();
}

const seoTitle = "Inklusive Sommercamps & barrierefreie Reisen 2026 | Die Brücke Graz";
const seoDescription = "Entdecke unsere barrierefreien Sommercamps und inklusiven Reisen 2026. Abenteuer ohne Barrieren für Menschen mit Behinderung.";
const seoImage = featuredTrip?.image ? getImg(featuredTrip.image, 1200) : "https://diebruecke.cc/share-camps.jpg";
---

<MainLayout 
    title={seoTitle} 
    description={seoDescription} 
    image={seoImage}
>
    
    {/* --- HERO SECTION (FEATURED REISE) --- */}
    {featuredTrip && (
        <section class="px-4 sm:px-6 pt-6 pb-20 transition-colors duration-500">
            <div class="relative bg-slate-900 rounded-[48px] md:rounded-[64px] overflow-hidden min-h-[70vh] flex items-center shadow-2xl">
                
                <div class="absolute inset-0 z-0">
                    {featuredTrip.image && (
                         <Image 
                            src={getImg(featuredTrip.image, 1600)} 
                            alt={featuredTrip.title}
                            width={1600}
                            height={900}
                            loading="eager"
                            fetchpriority="high"
                            class="w-full h-full object-cover opacity-40 scale-105" 
                         />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-900/70 to-transparent z-10"></div>
                    
                    <div class="absolute top-0 right-0 w-full h-full overflow-hidden pointer-events-none z-20">
                        <div class="absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-rose-600/25 rounded-full blur-[120px] animate-pulse-slow"></div>
                        <div class="absolute bottom-[-10%] right-[-5%] w-[500px] h-[500px] bg-indigo-600/20 rounded-full blur-[100px]"></div>
                    </div>
                </div>

                <div class="relative z-30 w-full px-8 md:px-16 py-24">
                    <div class="max-w-3xl">
                        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-rose-500/20 backdrop-blur-md border border-rose-500/30 text-rose-300 text-[10px] font-black uppercase tracking-[0.3em] mb-10 shadow-lg">
                            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> 
                            Highlight Reise 2026
                        </div>
                        
                        <h1 class="text-5xl md:text-8xl font-display font-black text-white mb-8 tracking-tighter leading-[1.02] uppercase">
                            {featuredTrip.title}
                        </h1>
                        
                        <p 
                            class="text-xl md:text-2xl text-slate-200 mb-12 leading-relaxed font-medium border-l-4 border-rose-500 pl-8 max-w-2xl"
                            set:html={cleanDesc(featuredTrip.description) + '...'}
                        >
                        </p>
                        
                        <div class="flex flex-wrap gap-10 mb-12 text-xs font-black uppercase tracking-[0.2em] text-slate-300">
                            <div class="flex items-center gap-3">
                                <i class="fa-regular fa-calendar text-rose-500 text-xl"></i> 
                                {featuredTrip.date_range}
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-3xl">{getFlag(featuredTrip.location)}</span> 
                                <span class="text-white">{featuredTrip.location}</span>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-4">
                            <a href={`/${featuredTrip.base_path}/${featuredTrip.slug}`} class="bg-rose-600 text-white px-10 py-5 rounded-full font-black uppercase tracking-widest text-xs hover:bg-white hover:text-slate-900 transition-all shadow-xl shadow-rose-900/20 transform hover:-translate-y-1">
                                Details & Anmeldung
                            </a>
                            {featuredTrip.price != null && (
                                <div class="px-10 py-5 border border-white/20 backdrop-blur-md text-white rounded-full font-black text-xs uppercase tracking-widest">
                                    ab € {featuredTrip.price},-
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    )}

    {/* --- LISTE ALLER REISEN 2026 --- */}
    <section class="px-6 sm:px-10 py-32 bg-white dark:bg-slate-950 transition-colors duration-500">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-24 border-b border-slate-100 dark:border-slate-800 pb-12 gap-8">
                <div>
                    <span class="text-rose-500 font-bold tracking-widest uppercase text-[10px] mb-4 block">Reisekatalog</span>
                    <h2 class="text-5xl md:text-7xl font-display font-black text-slate-900 dark:text-white tracking-tighter uppercase leading-none">
                        Unsere <span class="text-rose-600 italic">Reisen</span> 2026.
                    </h2>
                </div>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
                {allReisen.map((trip: any) => (
                    <article class="group relative bg-white dark:bg-slate-900 rounded-[48px] overflow-hidden border border-slate-100 dark:border-slate-800 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col h-full shadow-sm cursor-pointer">
                        
                        {/* Bild-Bereich */}
                        <div class="relative h-72 overflow-hidden bg-slate-100">
                            {trip.image ? (
                                <Image 
                                    src={getImg(trip.image, 800)} 
                                    alt={trip.title}
                                    width={800}
                                    height={500}
                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-[1.5s]" 
                                />
                            ) : (
                                <div class="w-full h-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-300"><i class="fa-solid fa-plane-up text-5xl"></i></div>
                            )}
                            
                            <div class="absolute top-6 left-6 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-2 rounded-2xl text-xs font-black text-slate-900 dark:text-white shadow-xl flex items-center gap-3 z-10">
                                <span class="text-xl">{getFlag(trip.location)}</span> 
                                {trip.price != null && (
                                    <span>€ {trip.price}</span>
                                )}
                            </div>
                            
                            {/* Kennzeichnung, ob City Trip oder Camp */}
                            <div class="absolute top-6 right-6 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-xl text-[10px] font-black text-white uppercase tracking-widest z-10 border border-white/10">
                                {trip.base_path === 'city-trips' ? 'City Trip' : 'Camp'}
                            </div>
                        </div>
                        
                        <div class="p-10 flex flex-col flex-1">
                            <div class="text-[10px] font-black text-rose-500 uppercase tracking-[0.3em] mb-6">
                                <i class="fa-regular fa-calendar mr-2"></i> {trip.date_range}
                            </div>
                            
                            <h3 class="text-3xl font-display font-bold text-slate-900 dark:text-white mb-6 leading-tight group-hover:text-rose-600 transition-colors uppercase tracking-tight">
                                <a href={`/${trip.base_path}/${trip.slug}`} class="before:absolute before:inset-0 before:z-20">
                                    {trip.title}
                                </a>
                            </h3>
                            
                            <div class="text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3 mb-10 text-base font-medium flex-1" set:html={cleanDesc(trip.description)}></div>
                            
                            <div class="pt-8 border-t border-slate-50 dark:border-slate-800 flex items-center justify-between mt-auto">
                                <div class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest relative z-10">
                                    {trip.free_spots > 0 ? (
                                        <span class="text-emerald-600 flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> 
                                            {trip.free_spots} Plätze
                                        </span>
                                    ) : (
                                        <span class="text-rose-500 flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-rose-500"></span> Warteliste
                                        </span>
                                    )}
                                </div>
                                
                                <div class="w-12 h-12 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-400 group-hover:bg-rose-600 group-hover:text-white transition-all duration-300 relative z-10">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    {/* --- CITY TRIPS CALLOUT (Bleibt unangetastet) --- */}
    <section class="px-6 sm:px-10 pb-32">
        <div class="max-w-7xl mx-auto">
            <a href="/city-trips" class="group relative block rounded-[48px] md:rounded-[64px] overflow-hidden bg-indigo-900 text-white shadow-2xl transition-all hover:scale-[1.01] duration-500">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.1),transparent)]"></div>
                <div class="relative z-20 p-12 md:p-24 flex flex-col lg:flex-row items-center justify-between gap-12 text-center lg:text-left">
                    <div class="max-w-2xl">
                        <span class="text-indigo-300 font-black uppercase tracking-[0.3em] text-[10px] mb-6 block">Kurztrips ab Graz</span>
                        <h3 class="text-4xl md:text-6xl font-display font-black mb-6 tracking-tighter uppercase leading-none">
                            Action & Kultur? <br/><span class="text-indigo-400 italic">City Trips.</span>
                        </h3>
                        <p class="text-indigo-100 text-xl font-medium leading-relaxed opacity-80">
                            Entdecke unsere City Trips 2026. Europa hautnah erleben in kleinen Gruppen – barrierefrei und unvergesslich.
                        </p>
                    </div>
                    <div class="bg-white text-indigo-900 px-12 py-6 rounded-full font-black uppercase tracking-widest text-xs shadow-xl group-hover:bg-indigo-500 group-hover:text-white transition-all">
                        Alle City Trips <i class="fa-solid fa-bus-simple ml-3"></i>
                    </div>
                </div>
            </a>
        </div>
    </section>

    {/* --- INFO / CTA --- */}
    <section class="px-4 sm:px-6 pb-24">
        <div class="max-w-5xl mx-auto bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800 rounded-[64px] py-24 px-10 md:px-20 overflow-hidden relative shadow-sm text-center">
            <div class="max-w-3xl mx-auto relative z-10">
                <h2 class="text-4xl md:text-6xl font-display font-black text-slate-900 dark:text-white mb-8 tracking-tighter uppercase leading-none">Bereit für den <br/> <span class="text-rose-600">Sommer 2026?</span></h2>
                <p class="text-slate-500 dark:text-slate-400 text-xl md:text-2xl mb-12 leading-relaxed font-medium">
                    Die Anmeldung startet bald. Wir beraten dich gerne zu Finanzierungsmöglichkeiten (z.B. via FASS-Budget) und Ablauf.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
                    <a href="/contact" class="w-full sm:w-auto bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-12 py-6 rounded-full font-black uppercase tracking-widest text-xs hover:bg-rose-600 dark:hover:bg-rose-400 dark:hover:text-white transition-all shadow-xl">
                        Beratungstermin <i class="fa-solid fa-comments ml-3"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

</MainLayout>

{/* SCHEMA.ORG */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Inklusive Sommercamps & Reisen 2026 Die Brücke Graz",
  "description": seoDescription,
  "itemListElement": allReisen.map((trip: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
        "@type": "TouristTrip",
        "name": trip.title,
        "description": cleanDesc(trip.description),
        "url": `https://diebruecke.cc/${trip.base_path}/${trip.slug}`,
        "image": trip.image ? `${ASSET_URL}/${trip.image}` : seoImage,
        "offers": {
            "@type": "Offer",
            "price": trip.price || "0",
            "priceCurrency": "EUR",
            "availability": trip.free_spots > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
        }
    }
  }))
})} />