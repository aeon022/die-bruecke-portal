---
import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';

const camps = await directus.request(readItems('camps', {
    filter: { status: { _eq: 'published' } },
    sort: ['date_range'] 
}));

const ASSET_URL = "https://api.diebruecke.social/assets";
const featuredCamp = camps.find((c: any) => c.is_featured) || camps[0];

// Aggressivere Flaggen-Zuweisung
const getFlag = (location: string) => {
    if (!location) return '📍';
    const loc = location.toLowerCase();
    if (loc.includes('österreich') || loc.includes('austria')) return '🇦🇹';
    if (loc.includes('kroatien') || loc.includes('croatia') || loc.includes('istrien')) return '🇭🇷';
    if (loc.includes('italien') || loc.includes('italy')) return '🇮🇹';
    if (loc.includes('slowenien') || loc.includes('slovenia')) return '🇸🇮';
    if (loc.includes('ungarn') || loc.includes('hungary')) return '🇭🇺';
    if (loc.includes('tschechien') || loc.includes('czech')) return '🇨🇿';
    if (loc.includes('deutschland') || loc.includes('germany')) return '🇩🇪';
    return '🌍';
};

function cleanDesc(html: string) {
    if (!html) return "";
    return html.replace(/<[^>]*>?/gm, '').slice(0, 160) + '...';
}
---

<MainLayout title="Camps & Reisen 2026 | Die Brücke">
    
    {/* --- HERO SECTION --- */}
    {featuredCamp && (
        <section class="px-4 sm:px-6 pt-6 pb-20">
            <div class="relative bg-slate-900 rounded-[48px] overflow-hidden min-h-[65vh] flex items-center px-6 md:px-16 py-24 shadow-2xl">
                <div class="absolute inset-0">
                    {featuredCamp.image && (
                         <img src={`${ASSET_URL}/${featuredCamp.image}`} class="w-full h-full object-cover opacity-40" alt="" />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-900/80 to-transparent"></div>
                </div>

                <div class="relative z-10 max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/20 border border-rose-500/30 text-rose-400 text-xs font-bold uppercase tracking-widest mb-8">
                        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> Reise Highlight 2026
                    </div>
                    <h1 class="text-5xl md:text-7xl font-display font-extrabold text-white mb-6 tracking-tight leading-[0.95]">
                        {featuredCamp.title}
                    </h1>
                    
                    <p class="text-xl text-slate-300 mb-10 leading-relaxed font-medium">
                        {cleanDesc(featuredCamp.description)}
                    </p>
                    
                    <div class="flex flex-wrap gap-8 mb-10 text-sm font-bold uppercase tracking-widest text-slate-400">
                        <span class="flex items-center gap-2"><i class="fa-regular fa-calendar text-rose-500"></i> {featuredCamp.date_range}</span>
                        <span class="flex items-center gap-2 text-white">
                           <span class="text-2xl">{getFlag(featuredCamp.location)}</span> {featuredCamp.location}
                        </span>
                    </div>

                    <div class="flex flex-wrap gap-4">
                        <a href={`/camps/${featuredCamp.slug}`} class="bg-rose-600 text-white px-10 py-5 rounded-full font-bold hover:bg-rose-700 transition-all shadow-xl">
                            Details & Anmeldung
                        </a>
                        <span class="px-8 py-5 border border-slate-700 text-white rounded-full font-bold backdrop-blur-sm">
                            € {featuredCamp.price},-
                        </span>
                    </div>
                </div>
            </div>
        </section>
    )}

    {/* --- LISTE ALLER REISEN 2026 --- */}
    <section class="px-6 sm:px-10 py-20">
        <div class="max-w-7xl mx-auto">
            <div class="flex items-end justify-between mb-16 border-b border-slate-100 dark:border-slate-800 pb-8">
                <div>
                    <h2 class="text-4xl md:text-5xl font-display font-bold text-slate-900 dark:text-white tracking-tighter">Unsere Reisen 2026.</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-lg mt-2 font-medium italic">Abenteuer warten auf dich.</p>
                </div>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10">
                {camps.map((camp: any) => (
                    <article class="group bg-white dark:bg-slate-900 rounded-[32px] overflow-hidden border border-slate-100 dark:border-slate-800 hover:shadow-2xl transition-all flex flex-col h-full">
                        <a href={`/camps/${camp.slug}`} class="block relative h-64 overflow-hidden">
                            {camp.image ? (
                                <img src={`${ASSET_URL}/${camp.image}`} alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            ) : (
                                <div class="w-full h-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-300"><i class="fa-solid fa-plane text-4xl"></i></div>
                            )}
                            <div class="absolute top-4 left-4 bg-white/95 backdrop-blur px-3 py-1 rounded-xl text-xs font-bold text-slate-900 shadow-sm flex items-center gap-2">
                                <span class="text-lg">{getFlag(camp.location)}</span> € {camp.price}
                            </div>
                        </a>
                        
                        <div class="p-8 flex flex-col flex-1">
                            <div class="text-[10px] font-bold text-rose-500 uppercase tracking-[0.2em] mb-4">
                                <i class="fa-regular fa-calendar mr-1"></i> {camp.date_range}
                            </div>
                            
                            <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white mb-4 group-hover:text-rose-600 transition-colors">
                                {camp.title}
                            </h3>
                            
                            <div class="text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3 mb-8 text-sm flex-1" set:html={camp.description}></div>
                            
                            <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
                                    {camp.free_spots > 0 ? (
                                        <><span class="w-2 h-2 rounded-full bg-emerald-500"></span> {camp.free_spots} Plätze frei</>
                                    ) : (
                                        <><span class="w-2 h-2 rounded-full bg-rose-500"></span> Warteliste</>
                                    )}
                                </div>
                                <a href={`/camps/${camp.slug}`} class="text-rose-600 font-bold hover:underline inline-flex items-center gap-1 text-sm">
                                    Ansehen <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    {/* --- CITY TRIPS --- */}
    <section class="px-6 sm:px-10 pb-32">
        <div class="max-w-7xl mx-auto">
            <div class="group relative block rounded-[40px] overflow-hidden bg-indigo-900 text-white shadow-2xl transition-all">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-950 via-indigo-900 to-indigo-800 opacity-95"></div>
                <div class="relative z-20 p-10 md:p-16 flex flex-col lg:flex-row items-center justify-between gap-10 text-center lg:text-left">
                    <div>
                        <h3 class="text-3xl md:text-5xl font-display font-bold mb-4 tracking-tight">Kurztrip gefällig?</h3>
                        <p class="text-indigo-100 text-lg max-w-xl font-medium leading-relaxed">
                            Entdecke unsere <span class="text-white border-b-2 border-indigo-400">City Trips 2026</span>. Erlebe Kultur und Action in kleinen Gruppen – ganz ohne langes Packen.
                        </p>
                    </div>
                    <a href="/city-trips" class="bg-white text-indigo-900 px-10 py-5 rounded-full font-bold shadow-lg hover:bg-indigo-50 transition-colors">
                        City Trips entdecken <i class="fa-solid fa-bus ml-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    {/* --- INFO BOX --- */}
    <section class="px-4 sm:px-6 pb-24">
        <div class="max-w-7xl mx-auto bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800 rounded-[48px] py-20 px-8 md:px-16 overflow-hidden relative shadow-sm text-center">
            <div class="max-w-3xl mx-auto relative z-10">
                <h2 class="text-3xl md:text-5xl font-display font-bold text-slate-900 dark:text-white mb-8 tracking-tight">Reise-Sommer 2026</h2>
                <p class="text-slate-500 dark:text-slate-400 text-lg md:text-xl mb-12 leading-relaxed">
                    Die Anmeldung für 2026 startet im Frühjahr. Hast du Fragen zur Finanzierung oder zum Ablauf? Wir beraten dich gerne persönlich.
                </p>
                <a href="/contact" class="inline-flex items-center gap-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-10 py-5 rounded-full font-bold hover:bg-rose-600 dark:hover:bg-rose-400 dark:hover:text-white transition-all shadow-xl">
                    Kontakt aufnehmen <i class="fa-solid fa-comments text-lg"></i>
                </a>
            </div>
        </div>
    </section>

</MainLayout>