---
import MainLayout from '../../layouts/layout.astro';
import { getBlogPosts } from '../../lib/api';
import { Image } from 'astro:assets'; 

const posts = await getBlogPosts();
const [featuredPost, ...otherPosts] = posts;

// Wir nutzen die konsistente API-URL
const ASSET_URL = 'https://api.diebruecke.social/assets';

// Formatierung für das Datum
const formatDate = (dateString: string) => {
    return new Date(dateString).toLocaleDateString('de-DE', {
        day: '2-digit',
        month: 'long',
        year: 'numeric'
    });
};

// --- SEO CONFIG ---
const seoTitle = "Journal für Inklusion & Kultur Graz | Die Brücke";
const seoDescription = "Geschichten, Einblicke und Hintergründe aus dem Verein Die Brücke. Erfahre mehr über Inklusion, Kulturprojekte und das Miteinander in Graz.";
const seoImage = featuredPost ? `${ASSET_URL}/${featuredPost.main_image}` : "/assets/share-journal.jpg";
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>
    <main class="bg-slate-50 dark:bg-slate-950 transition-colors duration-500 relative overflow-hidden rounded-[48px] md:rounded-[64px] m-2 md:m-4 border border-slate-200 dark:border-slate-800 shadow-2xl min-h-screen">        
        
        {/* Background Glow Effect */}
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-rose-500/5 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
       
       {/* --- HEADER --- */}
        <section class="max-w-7xl mx-auto px-6 pt-24 pb-12 relative z-10">
            <div class="flex items-center gap-4 mb-6">
                <div class="flex items-center gap-3">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                    </span>
                    <span class="text-rose-500 font-black uppercase tracking-[0.4em] text-[10px]">Das Brücke Journal</span>
                </div>
                <span class="w-12 h-px bg-slate-200 dark:bg-slate-800"></span>
            </div>
            
            <h1 class="text-5xl sm:text-6xl md:text-8xl lg:text-9xl font-display font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-[1.05] py-2">
                Geschichten <br/> 
                <span class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-indigo-600 italic pb-2 md:pb-4 pr-2 md:pr-12">
                    von uns.
                </span>
            </h1>
        </section>

        {/* --- FEATURED POST (HERO) --- */}
        {featuredPost && (
            <section class="max-w-7xl mx-auto px-6 mb-32 relative z-10">
               <a href={`/blog/${featuredPost.slug}/`} class="group grid lg:grid-cols-12 bg-white dark:bg-slate-900 rounded-[48px] md:rounded-[56px] overflow-hidden shadow-xl hover:shadow-2xl dark:shadow-black/50 border border-slate-100 dark:border-slate-800 transition-all duration-700 hover:-translate-y-1 isolate">
                    
                    {/* BILD BEREICH */}
                    <div class="lg:col-span-7 overflow-hidden h-[350px] sm:h-[450px] lg:h-[650px] relative">
                        <Image 
                            src={`${ASSET_URL}/${featuredPost.main_image}`} 
                            width={1200}
                            height={800}
                            loading="eager"
                            fetchpriority="high"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s]" 
                            alt={featuredPost.title}
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent pointer-events-none"></div>
                    </div>

                    {/* TEXT BEREICH */}
                    <div class="lg:col-span-5 p-8 sm:p-12 md:p-16 flex flex-col justify-center bg-white dark:bg-slate-900 relative z-10">
                        <div class="flex items-center gap-4 mb-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                            <span>{formatDate(featuredPost.date_created)}</span>
                            <span class="w-1 h-1 rounded-full bg-rose-500"></span>
                            <span>Von {featuredPost.author}</span>
                        </div>
                        
                        <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-black text-slate-900 dark:text-white uppercase leading-[1.05] mb-8 group-hover:text-rose-500 transition-colors break-words">
                            {featuredPost.title}
                        </h2>
                        
                        <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-10 line-clamp-3 font-medium">
                            {featuredPost.excerpt}
                        </p>
                        
                        <span class="inline-flex items-center gap-4 text-slate-900 dark:text-white font-black uppercase tracking-widest text-xs group-hover:gap-6 transition-all">
                            Beitrag lesen 
                            <div class="w-10 h-10 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center group-hover:bg-rose-500 group-hover:text-white transition-colors">
                                <i class="fa-solid fa-arrow-right"></i>
                            </div>
                        </span>
                    </div>
                </a>
            </section>
        )}

        {/* --- POST GRID --- */}
        <section class="max-w-7xl mx-auto px-6 pb-40 relative z-10">
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-20">
                {otherPosts.map(post => (
                    <a href={`/blog/${post.slug}/`} class="group block h-full">
                        <div class="relative rounded-[40px] overflow-hidden aspect-[4/5] mb-8 shadow-lg border border-slate-100 dark:border-white/5 transition-all duration-500 group-hover:shadow-2xl group-hover:-translate-y-2 group-hover:border-rose-500/20">
                            <Image 
                                src={`${ASSET_URL}/${post.main_image}`} 
                                width={600}
                                height={750}
                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-[1.5s]" 
                                alt={post.title}
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-10">
                                <span class="text-white font-black uppercase tracking-widest text-[10px] transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                    Lesen <i class="fa-solid fa-chevron-right ml-2"></i>
                                </span>
                            </div>
                        </div>
                        
                        <div class="px-2">
                            <div class="flex items-center gap-3 mb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                                <span>{formatDate(post.date_created)}</span>
                            </div>
                            <h3 class="text-2xl font-display font-black text-slate-900 dark:text-white uppercase leading-[1.1] mb-4 group-hover:text-rose-500 transition-colors tracking-tight">
                                {post.title}
                            </h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-2 leading-relaxed font-medium opacity-80">
                                {post.excerpt}
                            </p>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>
</MainLayout>

{/* --- SCHEMA.ORG: BLOG & ITEMLIST --- */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Die Brücke Journal",
  "description": seoDescription,
  "url": "https://diebruecke.cc/blog",
  "publisher": {
    "@type": "Organization",
    "name": "Verein Die Brücke",
    "logo": "https://diebruecke.cc/logo.png"
  },
  "blogPost": posts.map((post) => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "url": `https://diebruecke.cc/blog/${post.slug}`,
    "datePublished": post.date_created,
    "author": {
      "@type": "Person",
      "name": post.author
    }
  }))
})} />