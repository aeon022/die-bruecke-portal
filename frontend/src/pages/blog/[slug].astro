---
import MainLayout from '../../layouts/layout.astro';
import BlogShare from '../../components/blog/BlogShare.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import BlogSocials from '../../components/blog/BlogSocials.astro';
import ImageGallery from '../../components/common/ImageGallery.astro';
// NEU: VideoPlayer importieren
import VideoPlayer from '../../components/common/VideoPlayer.astro';
import { getBlogPosts, getSidebarEvent, getSidebarService } from '../../lib/api';
import { Image } from 'astro:assets';

export const prerender = false;

const { slug } = Astro.params;

// 1. Post live aus der API suchen
const allPosts = await getBlogPosts();
const post = allPosts?.find((p: any) => p.slug === slug);

// 2. Wenn nicht gefunden -> 404 oder Redirect
if (!post) {
  return Astro.redirect('/blog');
}

// --- TOC LOGIK ---
let modifiedContent = post.content;
const headings: { title: string; id: string }[] = [];
const h2Regex = /<h2[^>]*>(.*?)<\/h2>/g;
let match;
let i = 0;

while ((match = h2Regex.exec(post.content)) !== null) {
  const title = match[1].replace(/<[^>]*>/g, '');
  const id = `section-${i}`;
  headings.push({ title, id });
  modifiedContent = modifiedContent.replace(match[0], `<h2 id="${id}">${match[1]}</h2>`);
  i++;
}

const words = post.content.split(' ').length;
const readingTime = Math.ceil(words / 200);

// Wir nutzen die produktive URL für Assets (Public URL für Browser)
const ASSET_URL = (import.meta.env.PUBLIC_API_URL || 'https://api.diebruecke.social') + '/assets';
const currentUrl = Astro.url.href;

// Normalisierung für das Dataset
const displayCategory = post.category || 'Journal';
const logicCategory = post.category ? post.category.toLowerCase().trim() : 'aktion';

// --- SEO CONFIG ---
const seoTitle = `${post.title} - Journal | Die Brücke Graz`;
const cleanExcerpt = post.excerpt?.replace(/<[^>]*>/g, '') || "";
const seoDescription = cleanExcerpt.length > 160 ? cleanExcerpt.substring(0, 157) + "..." : cleanExcerpt;
const seoImage = post.main_image ? `${ASSET_URL}/${post.main_image}` : "/assets/share-journal.jpg";

// --- DATEN AUS API ---
const sidebarEvent =
  logicCategory === 'kultur'
    ? await getSidebarEvent({ mode: 'highlight', limit: 10, random: true })
    : logicCategory === 'aktion'
      ? await getSidebarEvent({ mode: 'latest', limit: 10, random: true })
      : await getSidebarEvent({ mode: 'latest', limit: 5, random: true });

const sidebarService = await getSidebarService(logicCategory);

const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('de-DE', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
};
---

<MainLayout title={seoTitle} description={seoDescription} image={seoImage}>
  {/* Lesefortschritt-Balken */}
  <div class="fixed top-0 left-0 w-full h-1.5 z-[100] pointer-events-none">
     <div id="progress-bar" class="h-full bg-rose-500 w-0 transition-all duration-150 ease-out shadow-[0_0_10px_rgba(244,63,94,0.5)]"></div>
  </div>
  
  <main class="bg-white dark:bg-slate-950 transition-colors duration-500 rounded-[32px] md:rounded-[48px] lg:rounded-[64px] m-2 md:m-4 border border-slate-200 dark:border-slate-800 shadow-2xl min-h-screen relative overflow-clip">
     
     <header class="pt-24 pb-12 md:pb-16 px-6">
        <div class="absolute top-0 right-0 w-[400px] md:w-[600px] h-[600px] bg-rose-500/5 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <nav class="mb-12">
               <a href="/blog" class="inline-flex items-center gap-3 text-slate-400 hover:text-rose-500 font-black uppercase text-[10px] tracking-[0.4em] transition-colors group font-mono">
                 <i class="fa-solid fa-arrow-left group-hover:-translate-x-2 transition-transform text-[8px]"></i>
                Zurück zum Journal
              </a>
            </nav>
            
            {/* ÄNDERUNG: Titel-Größe reduziert für bessere Lesbarkeit bei langen Headlines */}
            {/* Alt: text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl */}
            {/* Neu: text-3xl sm:text-4xl md:text-5xl lg:text-6xl */}
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-tight mb-8 py-2 break-words hyphens-auto">
              {post.title}
            </h1>
            
            <div class="flex flex-wrap items-center justify-center gap-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
              <time datetime={post.date_created}>{formatDate(post.date_created)}</time>
              <span class="hidden sm:inline w-1 h-1 rounded-full bg-slate-300"></span>
              <span class="text-rose-500">{displayCategory}</span>
              <span class="hidden sm:inline w-1 h-1 rounded-full bg-slate-300"></span>
              <span>Von {post.author || 'Redaktion'}</span>
            </div>
        </div>
    </header>

    {/* Hero Image Section */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-16 md:mb-24 relative z-10">
      <div class="rounded-[32px] md:rounded-[48px] lg:rounded-[64px] overflow-hidden aspect-video shadow-2xl ring-1 ring-slate-200 dark:ring-slate-800">
         <Image 
            src={`${ASSET_URL}/${post.main_image}`} 
            alt={post.title}
            width={1200}
            height={675}
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover" 
         />
      </div>
    </section>

    {/* --- MAIN ARTICLE & SIDEBARS --- */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-col xl:flex-row gap-8 md:gap-12 xl:gap-24 items-start">

        {/* --- LEFT SIDEBAR (TOC - DESKTOP ONLY) --- */}
        <aside class="hidden xl:block w-[240px] shrink-0 sticky top-32 h-fit space-y-10 mb-12">
          <div class="px-2">
            <span class="block text-[10px] font-black uppercase tracking-[0.3em] text-rose-500 mb-2 font-mono font-bold">Kategorie</span>
            <div class="inline-flex items-center gap-2 bg-slate-100 dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-200 dark:border-white/5">
              <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
              <span class="text-xs font-black uppercase tracking-widest text-slate-900 dark:text-white">{displayCategory}</span>
            </div>
          </div>

          {headings.length > 0 && (
            <div class="bg-slate-50 dark:bg-slate-900/50 p-6 rounded-[32px] border border-slate-100 dark:border-white/5 shadow-sm">
              <span class="block text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 mb-6 font-mono font-bold italic">Inhalt</span>
              <ul class="space-y-4">
                {headings.map(h => (
                  <li>
                    <a href={`#${h.id}`} class="text-[11px] font-bold text-slate-600 dark:text-slate-400 leading-snug hover:text-rose-500 transition-colors flex gap-2 group">
                      <span class="text-rose-500 opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                      <span>{h.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          
          <div class="px-2">
            <span class="block text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 mb-4 font-mono font-bold italic">Details</span>
            <p class="text-xs font-bold text-slate-500 italic mb-4 leading-relaxed">Lesezeit: ca. {readingTime} Min.</p>
            <div class="flex flex-wrap gap-2">
              {post.tags?.map((tag: string) => (
                <span class="text-[9px] font-bold text-rose-500 uppercase bg-rose-500/5 px-3 py-1.5 rounded-full border border-rose-500/10 whitespace-nowrap">#{tag}</span>
              ))}
            </div>
          </div>
        </aside>

        {/* --- ARTICLE AREA --- */}
        <article class="flex-1 min-w-0 w-full">
          
          {/* MOBILE/TABLET TOC (Accordion) */}
          {headings.length > 0 && (
            <details class="xl:hidden mb-12 bg-slate-50 dark:bg-slate-900/50 rounded-[32px] border border-slate-200 dark:border-slate-800 group">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-rose-500 font-mono">Inhaltsverzeichnis</span>
                    <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                </summary>
                <div class="px-6 pb-6">
                    <ul class="space-y-3 border-t border-slate-200 dark:border-slate-800 pt-4">
                        {headings.map(h => (
                            <li>
                                <a href={`#${h.id}`} class="text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-rose-500 transition-colors block">
                                    {h.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </details>
          )}

          {/* MAIN CONTENT */}
          <div class="prose prose-lg md:prose-xl dark:prose-invert prose-slate prose-headings:font-display prose-headings:uppercase prose-headings:tracking-tighter prose-headings:font-black prose-a:text-rose-500 prose-img:rounded-[32px] max-w-none prose-p:leading-relaxed prose-p:text-slate-600 dark:prose-p:text-slate-400 mb-12 break-words hyphens-auto">
            <div set:html={modifiedContent} />
          </div>

          {/* --- VIDEO PLAYER --- */}
          {post.video_url && (
            <div class="mb-12">
               <h3 class="font-display font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase mb-6">
                 Video <span class="text-rose-500">Beitrag</span>
               </h3>
               {/* Nutzt das Hauptbild als Poster, falls vorhanden */}
               <VideoPlayer url={post.video_url} poster={post.main_image ? `${ASSET_URL}/${post.main_image}` : undefined} />
            </div>
          )}

          {/* GALERIE */}
          {post.gallery && <ImageGallery gallery={post.gallery} />}
          
          <div class="mt-16 pt-12 border-t border-slate-100 dark:border-slate-800">
             <BlogShare title={post.title} url={currentUrl} />
          </div>
        </article>

        {/* --- RIGHT SIDEBAR (CTA & SOCIALS) --- */}
        <aside class="w-full max-w-2xl mx-auto xl:max-w-none xl:w-[300px] shrink-0 xl:sticky xl:top-32 h-fit mt-8 mb-24 xl:mt-0 xl:mb-12 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-1 gap-8 xl:gap-12 items-start">
          
          {/* Box 1: Dynamic CTA */}
          <div
            id="dynamic-cta-box"
            data-category={logicCategory}
            data-event={sidebarEvent ? JSON.stringify(sidebarEvent) : null}
            data-service={sidebarService ? JSON.stringify(sidebarService) : null}
            class="p-8 md:p-10 bg-slate-900 rounded-[40px] md:rounded-[48px] text-white shadow-2xl relative overflow-hidden group border border-white/5 transition-transform hover:scale-[1.01] duration-500 w-full"
          >
            <div class="absolute -right-8 -top-8 w-40 h-40 bg-rose-500/20 rounded-full blur-3xl group-hover:bg-rose-500/40 transition-all duration-700"></div>
            <span id="cta-label" class="text-[9px] font-black uppercase tracking-[0.3em] text-rose-500 block mb-6 relative z-10 font-mono font-bold">Empfehlung</span>
            <h4 id="cta-title" class="text-xl md:text-2xl font-display font-black uppercase leading-[1.1] mb-4 relative z-10">Lade...</h4>
            <p id="cta-text" class="text-[13px] text-slate-300 mb-8 leading-relaxed relative z-10">Inhalte werden geladen.</p>
            <a id="cta-link" href="#" class="block w-full py-4 bg-white text-slate-900 hover:bg-rose-500 hover:text-white text-center rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all relative z-10 shadow-lg font-bold">
              Mehr erfahren
            </a>
          </div>

          {/* Box 2: Socials */}
          <div class="bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-white/5 rounded-[40px] md:rounded-[48px] p-8 w-full xl:bg-transparent xl:border-0 xl:p-0 xl:rounded-none">
             <BlogSocials />
          </div>

        </aside>
      </div>
    </section>

    {/* --- RELATED POSTS --- */}
    <footer class="max-w-7xl mx-auto px-6 pb-40">
        <RelatedPosts currentSlug={post.slug} category={displayCategory} />
    </footer>
  </main>
</MainLayout>

{/* --- SCHEMA.ORG: BLOGPOSTING --- */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": seoDescription,
  "image": [seoImage],
  "datePublished": post.date_created,
  "dateModified": post.date_updated || post.date_created,
  "author": {
    "@type": "Person",
    "name": post.author || "Redaktion Die Brücke"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Verein Die Brücke",
    "logo": {
      "@type": "ImageObject",
      "url": "https://diebruecke.cc/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentUrl
  }
})} />

{/* --- SCHEMA.ORG: BREADCRUMBS --- */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Journal",
      "item": "https://diebruecke.cc/blog"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": post.title,
      "item": currentUrl
    }
  ]
})} />

<script>
  function safeParseJSON(value) {
    try {
      if (!value || value === "null") return null;
      return JSON.parse(value);
    } catch (e) {
      return null;
    }
  }

  function truncateText(str, max = 100) {
    if (!str) return "";
    let clean = str.replace(/<[^>]*>/g, "");
    return clean.length > max ? clean.substring(0, max) + "…" : clean;
  }

  function updateCTA() {
    const box = document.getElementById("dynamic-cta-box");
    if (!box) return;
    const category = (box.dataset.category || "aktion").toLowerCase().trim();
    const dbEvent = safeParseJSON(box.dataset.event);
    const dbService = safeParseJSON(box.dataset.service);

    const eventOption = (labelText) => {
      if (!dbEvent?.slug) return null;
      return {
        title: dbEvent.title || "Event",
        text: truncateText(dbEvent.description, 100),
        link: `/events/${dbEvent.slug}`,
        btn: "Zum Event",
        label: labelText,
      };
    };

    const serviceOption = (labelText) => {
      if (!dbService?.slug) return null;
      return {
        title: dbService.title || "Angebot",
        text: truncateText(dbService.teaser, 110),
        link: `/services/${dbService.slug}`,
        btn: "Details ansehen",
        label: labelText,
      };
    };

    const ctaOptions = {
      kultur: [eventOption("Nächstes Event"), serviceOption("Unsere Kulturarbeit")].filter(Boolean),
      sozial: [serviceOption("Beratung & Hilfe"), { title: "Wir hören zu.", text: "Unterstützung im Alltag oder Behördenwege.", link: "/services", btn: "Alle Dienste", label: "Support" }],
      aktion: [eventOption("Dabei sein"), { title: "Sommer-Camps 2026", text: "Jetzt Plätze für unsere Reisen sichern.", link: "/camps", btn: "Zu den Reisen", label: "Urlaub" }]
    };

    const options = ctaOptions[category] || ctaOptions.aktion;
    const randomItem = options[Math.floor(Math.random() * options.length)];

    if (randomItem) {
      document.getElementById("cta-label").innerText = randomItem.label;
      document.getElementById("cta-title").innerText = randomItem.title;
      document.getElementById("cta-text").innerText = randomItem.text;
      const linkEl = document.getElementById("cta-link");
      linkEl.innerText = randomItem.btn;
      linkEl.href = randomItem.link;
    }
  }

  function initScripts() {
    updateCTA();
    const bar = document.getElementById("progress-bar");
    const updateProgress = () => {
      if (!bar) return;
      const scrolled = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
      bar.style.width = scrolled + "%";
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  }

  initScripts();
  document.addEventListener("astro:after-swap", initScripts);
</script>

<style is:global>
  html { scroll-behavior: smooth; }
  h2 { scroll-margin-top: 140px !important; }
</style>