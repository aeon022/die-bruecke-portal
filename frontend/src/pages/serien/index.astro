---
// Alle Serien im Überblick (Daten: Directus event_series)
import MainLayout from '../../layouts/layout.astro';
import { getSeries, getEvents } from '../../lib/api';
import { nextEventDate } from '../../lib/recurrence';
import { seriesStyle } from '../../lib/series';

const [series, events] = await Promise.all([getSeries(), getEvents()]);
const today = new Date(); today.setHours(0, 0, 0, 0);
const upcoming = events.map((e: any) => ({ ...e, _date: nextEventDate(e) })).filter((e: any) => e._date >= today);

const tiles = series.map((s: any) => {
  const own = upcoming.filter((e: any) => e.series?.slug === s.slug).sort((a: any, b: any) => a._date - b._date);
  return { ...s, count: own.length, next: own[0] };
});
// Serien mit Terminen zuerst, sonst Reihenfolge aus Directus
tiles.sort((a: any, b: any) => (b.count > 0 ? 1 : 0) - (a.count > 0 ? 1 : 0));
---
<MainLayout title="Serien | Die Brücke Graz" description="BLAUmachen, FeierABEND, LiedGUT, FernWEH, SzenenWECHSEL und mehr: unsere Veranstaltungsserien in der Brücke Graz – Blues, Liedermacher, Folk, Impro-Theater, Kabarett.">
  <section class="px-4 sm:px-6 pt-6 pb-24">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 pt-10">
        <a href="/events" class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-rose-500 transition-colors group mb-8">
          <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i> Zum Kalender
        </a>
        <h1 class="text-5xl md:text-7xl font-display font-bold text-slate-900 dark:text-white tracking-tight leading-[0.95] mb-6">Unsere Serien</h1>
        <p class="text-xl text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">Jede Serie hat ihren eigenen Klang. Such dir deine aus – und abonnier sie gleich im Kalender.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tiles.map((s: any) => (
          <a href={`/serien/${s.slug}`} class="series-surface group relative flex flex-col justify-between min-h-[240px] p-8 rounded-[32px] overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300" style={seriesStyle(s)}>
            <div>
              <h2 class="font-display font-black text-3xl md:text-4xl tracking-tight leading-none mb-4">{s.name}</h2>
              {s.description && <p class="text-sm leading-relaxed opacity-90">{s.description}</p>}
            </div>
            <div class="mt-8 flex items-end justify-between gap-4 text-xs font-bold uppercase tracking-widest">
              <span class="opacity-90">
                {s.next
                  ? <span>Nächster Termin<br /><span class="text-base normal-case tracking-normal">{s.next._date.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: 'long' })}</span></span>
                  : 'Termine folgen'}
              </span>
              <i class="fa-solid fa-arrow-right text-lg group-hover:translate-x-1 transition-transform"></i>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
