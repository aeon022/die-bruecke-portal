---
import MainLayout from '../../layouts/layout.astro';
import { getArchiv } from '../../lib/api';
import { Image } from 'astro:assets';

const archivItems = await getArchiv();
const safeArchivItems = Array.isArray(archivItems) ? archivItems : [];
const availableYears = [...new Set(safeArchivItems.map((item: any) => item.year))].sort((a: any, b: any) => b - a);

const ASSET_URL = import.meta.env.DIRECTUS_URL + '/assets';
---

<MainLayout title="Das Archiv | Verein Die Brücke">
    <main class="bg-white dark:bg-slate-950 transition-colors duration-500 overflow-hidden rounded-[48px] m-2 md:m-4 border border-slate-200 dark:border-slate-800 shadow-2xl min-h-screen relative">
        
        {/* Darkmode Glow Effect */}
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-rose-500/5 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
        
        {/* --- HERO SECTION --- */}
        <section class="px-2 sm:px-6 pt-4 pb-0 relative z-10">
            <div class="relative bg-slate-900 rounded-[40px] overflow-hidden min-h-[50vh] md:min-h-[60vh] flex items-center px-4 md:px-16 py-12 md:py-24 shadow-2xl">
                <div class="absolute inset-0 overflow-hidden pointer-events-none">
                    <div class="absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-rose-600/10 rounded-full blur-[120px]"></div>
                    <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-indigo-600/10 rounded-full blur-[120px]"></div>
                </div>

                <div class="max-w-7xl mx-auto w-full relative z-10">
                    <div class="mb-8">
                        <a href="/about" class="inline-flex items-center text-slate-400 hover:text-white font-bold transition-colors group text-xs uppercase tracking-widest">
                            <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                            Über uns
                        </a>
                    </div>
                    
                    {/* FIX: Titel-Abstand verringert */}
                    <h1 class="font-display font-bold text-white mb-8 tracking-tighter uppercase">
                        <span class="block text-[clamp(2.5rem,8vw,6rem)] leading-none mb-0">Das</span>
                        {/* -mt-2 (mobil) und -mt-6 (Desktop) zieht es nach oben */}
                        <span class="block text-[clamp(2.5rem,10vw,9rem)] leading-tight text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-indigo-400 italic whitespace-nowrap py-4 pr-4 -ml-1 -mt-2 md:-mt-6">
                            Gedächtnis.
                        </span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl font-medium border-l-4 border-rose-500 pl-6">
                        42 Jahre Brücke Graz. Ein lebendiges Mosaik unserer Geschichte.
                    </p>
                </div>
            </div>
        </section>

        {/* --- INTRO TEXT SECTION (Design A - Refined) --- */}
        <section class="px-4 sm:px-10 py-16 md:py-24 max-w-7xl mx-auto relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
                
                {/* Linke Spalte */}
                <div class="md:col-span-5 md:sticky md:top-32">
                    <h2 class="font-display font-black text-3xl md:text-5xl uppercase tracking-tight text-slate-900 dark:text-white mb-6 leading-none">
                        42 Jahre <span class="text-rose-500">Brücke</span>
                    </h2>
                    <p class="text-xl md:text-2xl font-serif italic text-slate-500 dark:text-slate-400 leading-relaxed">
                        „Vom Pioniergeist zur Institution – ein digitales Gedächtnis für das erste barrierefreie Kulturzentrum Österreichs.“
                    </p>
                    <div class="h-1 w-24 bg-rose-500 mt-8 rounded-full"></div>
                </div>

                {/* Rechte Spalte */}
                <div class="md:col-span-7 prose prose-lg prose-slate dark:prose-invert max-w-none">
                    <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300 relative">
                        <span class="float-left text-[7rem] leading-[0.65] font-display font-black text-rose-500 mr-3 mt-3">
                            E
                        </span>
                        <span class="font-bold uppercase tracking-wider text-slate-900 dark:text-white text-sm">s begann an einem</span> kalten Novembertag im Jahr 1983. Die Idee war so simpel wie revolutionär: Einen Ort in Graz zu schaffen, an dem Menschen nach Schicksalsschlägen oder Unfällen nicht isoliert sind, sondern mitten im Leben stehen. Ein "offenes Wohnzimmer" ohne Stufen, ohne Barrieren, aber mit viel Herz.
                    </p>
                    
                    <p class="text-slate-600 dark:text-slate-400">
                        Was damals als mutiges Experiment begann, ist heute – über vier Jahrzehnte später – eine feste Institution in der österreichischen Kultur- und Soziallandschaft. In diesem Archiv blicken wir zurück. Nicht aus Nostalgie, sondern um zu verstehen, was uns zu dem gemacht hat, was wir heute sind.
                    </p>

                    {/* Feature Box */}
                    <div class="bg-slate-50 dark:bg-slate-900/50 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 my-8 not-prose">
                        <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-sm mb-4">Spuren unseres Weges:</h4>
                        <ul class="space-y-3">
                            {[
                                "Vom ersten ‚Reha-Treff‘ der 80er Jahre hin zum modernen soziokulturellen Zentrum.",
                                "Von handkopierten Flugblättern zu professionellen Kampagnen.",
                                "Vom kleinen Konzert im Eckzimmer zu legendären Murwärts-Festivals.",
                                "Die Gesichter der Menschen – Klient:innen, Zivildiener, Vorstände und Visionäre."
                            ].map(point => (
                                <li class="flex items-start gap-3 text-slate-700 dark:text-slate-300">
                                    {/* FIX: Diamond statt Haken.
                                        text-[0.5rem]: Sehr klein für edle Optik.
                                        mt-2.5: Präzise optische Mitte zur ersten Textzeile. 
                                    */}
                                    <i class="fa-solid fa-diamond text-rose-500 mt-2.5 text-[0.5rem] shrink-0 opacity-80"></i>
                                    <span>{point}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <p class="font-medium text-slate-900 dark:text-white">
                        Dieses Archiv ist nicht starr. Es wächst, genau wie wir. Wir laden Sie ein, zu stöbern, zu schmunzeln und vielleicht den einen oder anderen Moment wiederzuentdecken.
                        <br/><br/>
                        <span class="text-rose-500 font-bold">Willkommen in unserer Geschichte.</span>
                    </p>
                </div>
            </div>
        </section>

        {/* --- STICKY FILTER --- */}
        <nav id="archiv-filter-nav" class="sticky top-0 z-50 bg-white/90 dark:bg-slate-950/90 backdrop-blur-xl border-y border-slate-100 dark:border-slate-900 py-4 md:py-6 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-10 flex items-center justify-between gap-8">
                <div class="flex gap-6 md:gap-8 overflow-x-auto hide-scrollbar py-2 w-full touch-pan-x">
                    <button class="filter-btn active text-[10px] font-black uppercase tracking-[0.3em] text-rose-600 whitespace-nowrap flex-shrink-0" data-year="all">Alle Jahre</button>
                    {availableYears.map((year: any) => (
                        <button class="filter-btn text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 whitespace-nowrap flex-shrink-0 hover:text-rose-500 transition-colors" data-year={year}>{year}</button>
                    ))}
                </div>
            </div>
        </nav>

        {/* --- BENTO GRID --- */}
        <section class="px-4 sm:px-10 py-12 md:py-24 bg-white dark:bg-slate-950 relative z-10">
            <div class="max-w-[1600px] mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-12 auto-rows-[400px] md:auto-rows-[350px]" id="archiv-grid">
                    {safeArchivItems.map((item: any) => (
                        <a 
                            href={`/archiv/${item.slug || item.id}/`}
                            class={`archiv-card group relative rounded-[40px] md:rounded-[64px] overflow-hidden transition-all duration-700 bg-slate-50 dark:bg-slate-900 block
                            ${item.aspect === 'wide' ? 'md:col-span-2 md:row-span-2' : ''} 
                            ${item.aspect === 'tall' ? 'md:row-span-2' : ''}
                            hover:shadow-2xl hover:-translate-y-2 border border-transparent dark:border-white/5`}
                            data-year={item.year}
                        >
                            <div class="absolute inset-0 pointer-events-none">
                                <Image 
                                    src={`${ASSET_URL}/${item.image}`} 
                                    width={item.aspect === 'wide' ? 1200 : 800}
                                    height={item.aspect === 'wide' ? 800 : 1000}
                                    alt={item.title}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
                            </div>

                            <div class="absolute inset-0 p-8 md:p-10 flex flex-col justify-end z-10 pointer-events-none">
                                <span class="text-[10px] font-black text-rose-500 uppercase tracking-[0.4em] mb-4">{item.year}</span>
                                <h3 class={`font-display font-black text-white uppercase tracking-tighter leading-tight mb-4
                                    ${item.aspect === 'wide' ? 'text-4xl md:text-6xl' : 'text-3xl'}`}>
                                    {item.title}
                                </h3>
                                {item.description && (
                                    <p class="text-slate-300 text-sm opacity-100 md:opacity-0 md:group-hover:opacity-100 md:translate-y-4 md:group-hover:translate-y-0 transition-all duration-500 line-clamp-2">
                                        {item.description}
                                    </p>
                                )}
                            </div>

                            <div class="absolute top-6 right-6 md:top-10 md:right-10 z-20 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-all duration-500 pointer-events-none">
                                <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-2xl">
                                    <i class="fa-solid fa-plus text-sm md:text-xl"></i>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>
</MainLayout>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    function initArchiv() {
        const filterNav = document.getElementById('archiv-filter-nav');
        const cards = document.querySelectorAll('.archiv-card');

        if (!filterNav) return;

        filterNav.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('.filter-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            const year = btn.getAttribute('data-year');
            const allBtns = filterNav.querySelectorAll('.filter-btn');
            
            allBtns.forEach(b => {
                b.classList.remove('text-rose-600', 'active');
                b.classList.add('text-slate-400');
            });
            btn.classList.add('text-rose-600', 'active');
            btn.classList.remove('text-slate-400');

            cards.forEach(card => {
                const cardYear = card.getAttribute('data-year');
                (card as HTMLElement).style.display = (year === 'all' || cardYear === year) ? 'block' : 'none';
            });
        });
    }

    initArchiv();
    document.addEventListener('astro:after-swap', initArchiv);
</script>