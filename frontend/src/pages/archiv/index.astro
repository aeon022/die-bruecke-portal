---
import MainLayout from '../../layouts/layout.astro';
import { getArchiv } from '../../lib/api';
import { Image } from 'astro:assets';

const archivItems = await getArchiv();
const safeArchivItems = Array.isArray(archivItems) ? archivItems : [];

const ASSET_URL = import.meta.env.DIRECTUS_URL + '/assets';

// --- HELPER: HTML Tags entfernen ---
const stripHtml = (html: string) => {
    if (!html) return '';
    return html.replace(/<[^>]*>?/gm, ''); 
};

// --- DATA PROCESSING ---
const filterCategories = [
    { key: 'early_years', label: 'Pionierjahre', range: '1983–1990' },
    { key: 'first_years', label: 'Etablierung', range: '1991–2000' },
    { key: 'pro_years', label: 'Professionalisierung', range: '2001–2010' },
    { key: 'modern_years', label: 'Die Moderne', range: '2011–heute' },
];

const processedItems = safeArchivItems.map((item: any) => {
    let displayText = item.teaser;
    if (!displayText && item.description) {
        displayText = stripHtml(item.description);
    }

    return {
        ...item,
        category: item.category || 'other',
        cardText: displayText
    };
});

// Zufalls-ID
const randomItem = processedItems.length > 0 
    ? processedItems[Math.floor(Math.random() * processedItems.length)]
    : null;
---

<MainLayout title="Das Archiv | Verein Die Brücke">
    <main class="bg-white dark:bg-slate-950 transition-colors duration-500 overflow-hidden rounded-[48px] m-2 md:m-4 border border-slate-200 dark:border-slate-800 shadow-2xl min-h-screen relative isolate">
        
        {/* --- FILM GRAIN TEXTURE --- */}
        <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.07] pointer-events-none z-0 mix-blend-overlay"
             style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22 opacity=%221%22/%3E%3C/svg%3E');">
        </div>

        {/* Darkmode Glow Effect */}
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-rose-500/5 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2 z-0"></div>
        
        {/* --- HERO SECTION --- */}
        <section class="px-2 sm:px-6 pt-4 pb-0 relative z-10">
            <div class="relative bg-slate-900 rounded-[40px] overflow-hidden min-h-[50vh] md:min-h-[60vh] flex items-center px-4 md:px-16 py-12 md:py-24 shadow-2xl">
                <div class="absolute inset-0 overflow-hidden pointer-events-none">
                    <div class="absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-rose-600/10 rounded-full blur-[120px] animate-pulse-slow"></div>
                    <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-indigo-600/10 rounded-full blur-[120px] animate-pulse-slower"></div>
                </div>

                <div class="max-w-7xl mx-auto w-full relative z-10">
                    <div class="mb-8 flex justify-between items-start">
                        <a href="/about" class="inline-flex items-center text-slate-400 hover:text-white font-bold transition-colors group text-xs uppercase tracking-widest">
                            <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                            Über uns
                        </a>
                        
                        {randomItem && (
                            <a href={`/archiv/${randomItem.slug || randomItem.id}/`} class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 hover:bg-white/10 text-white text-xs font-bold uppercase tracking-wider transition-all hover:scale-105 backdrop-blur-sm">
                                <i class="fa-solid fa-shuffle text-rose-400"></i>
                                <span>Zufalls-Moment</span>
                            </a>
                        )}
                    </div>
                    
                    <h1 class="font-display font-bold text-white mb-8 tracking-tighter uppercase">
                        <span class="block text-[clamp(2.5rem,8vw,6rem)] leading-none mb-0 reveal-text">Das</span>
                        <span class="block text-[clamp(2.5rem,10vw,9rem)] leading-tight text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-indigo-400 italic whitespace-nowrap py-4 pr-4 -ml-1 -mt-2 md:-mt-6 reveal-text delay-100">
                            Gedächtnis.
                        </span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl font-medium border-l-4 border-rose-500 pl-6 reveal-text delay-200">
                        42 Jahre Brücke Graz. Ein lebendiges Mosaik unserer Geschichte.
                    </p>
                </div>
            </div>
        </section>

        {/* --- INTRO TEXT SECTION --- */}
        <section class="px-4 sm:px-10 py-16 md:py-24 max-w-7xl mx-auto relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
                
                <div class="md:col-span-5 md:sticky md:top-32">
                    <h2 class="font-display font-black text-3xl md:text-5xl uppercase tracking-tight text-slate-900 dark:text-white mb-6 leading-none reveal-on-scroll">
                        42 Jahre <span class="text-rose-500">Brücke</span>
                    </h2>
                    <p class="text-xl md:text-2xl font-serif italic text-slate-500 dark:text-slate-400 leading-relaxed reveal-on-scroll delay-100">
                        „Vom Pioniergeist zur Institution – ein digitales Gedächtnis für das erste barrierefreie Kulturzentrum Österreichs.“
                    </p>
                    <div class="h-1 w-24 bg-rose-500 mt-8 rounded-full reveal-on-scroll delay-200"></div>
                </div>

                <div class="md:col-span-7 prose prose-lg prose-slate dark:prose-invert max-w-none">
                    <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300 relative reveal-on-scroll">
                        <span class="float-left text-[7rem] leading-[0.65] font-display font-black text-rose-500 mr-3 mt-3">
                            E
                        </span>
                        <span class="font-bold uppercase tracking-wider text-slate-900 dark:text-white text-sm">s begann an einem</span> kalten Novembertag im Jahr 1983. Die Idee war so simpel wie revolutionär: Einen Ort in Graz zu schaffen, an dem Menschen nach Schicksalsschlägen oder Unfällen nicht isoliert sind, sondern mitten im Leben stehen.
                    </p>
                    
                    <p class="text-slate-600 dark:text-slate-400 reveal-on-scroll">
                        Was damals als mutiges Experiment begann, ist heute – über vier Jahrzehnte später – eine feste Institution in der österreichischen Kultur- und Soziallandschaft. In diesem Archiv blicken wir zurück.
                    </p>

                    <div class="bg-slate-50 dark:bg-slate-900/50 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 my-8 not-prose reveal-on-scroll">
                        <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-sm mb-4">Spuren unseres Weges:</h4>
                        <ul class="space-y-3">
                            {[
                                "Vom ersten ‚Reha-Treff‘ der 80er Jahre hin zum modernen soziokulturellen Zentrum.",
                                "Von handkopierten Flugblättern zu professionellen Kampagnen.",
                                "Vom kleinen Konzert im Eckzimmer zu legendären Murwärts-Festivals.",
                                "Die Gesichter der Menschen – Klient:innen, Zivildiener, Vorstände und Visionäre."
                            ].map(point => (
                                <li class="flex items-start gap-3 text-slate-700 dark:text-slate-300">
                                    <i class="fa-solid fa-diamond text-rose-500 mt-2.5 text-[0.5rem] shrink-0 opacity-80"></i>
                                    <span>{point}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <p class="font-medium text-slate-900 dark:text-white reveal-on-scroll">
                        Wir laden Sie ein, zu stöbern, zu schmunzeln und vielleicht den einen oder anderen Moment wiederzuentdecken.
                        <br/><br/>
                        <span class="text-rose-500 font-bold">Willkommen in unserer Geschichte.</span>
                    </p>
                </div>
            </div>
        </section>

        {/* --- STICKY FILTER --- */}
        <nav id="archiv-filter-nav" class="sticky top-0 z-50 bg-white/90 dark:bg-slate-950/90 backdrop-blur-xl border-y border-slate-100 dark:border-slate-900 py-4 md:py-6 overflow-hidden transition-all duration-300">
            <div class="max-w-7xl mx-auto px-4 sm:px-10">
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 w-full">
                    
                    {/* ALLE Button */}
                    <button class="filter-btn cursor-pointer active group flex flex-col items-center justify-center px-2 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-900 w-full border border-transparent hover:border-slate-200 dark:hover:border-slate-800" data-category="all">
                        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-rose-600 mb-1 group-[.active]:text-rose-600 group-[.active]:scale-105 transition-transform">Alles</span>
                        <span class="text-[9px] text-slate-400 font-mono">Gesamtes Archiv</span>
                    </button>

                    {/* KATEGORIE Buttons */}
                    {filterCategories.map(cat => (
                        <button class="filter-btn cursor-pointer group flex flex-col items-center justify-center px-2 py-3 rounded-xl transition-all hover:bg-slate-50 dark:hover:bg-slate-900 w-full border border-transparent hover:border-slate-200 dark:hover:border-slate-800" data-category={cat.key}>
                            <span class="text-[10px] font-black uppercase tracking-[0.1em] text-slate-400 mb-1 group-hover:text-rose-500 group-[.active]:text-rose-500 transition-colors whitespace-nowrap">{cat.label}</span>
                            <span class="text-[9px] text-slate-400/60 font-mono group-hover:text-slate-500 group-[.active]:text-slate-500 transition-colors">{cat.range}</span>
                        </button>
                    ))}
                </div>
            </div>
        </nav>

        {/* --- BENTO GRID --- */}
        <section class="px-4 sm:px-10 py-12 md:py-24 bg-white dark:bg-slate-950 relative z-10">
            {/* FIX: Volle Breite (w-full) statt max-w und grid-flow-dense für Lückenschluss */}
            <div class="w-full">
                {processedItems.length === 0 && (
                    <div class="text-center py-24 text-slate-400">
                        <p>Das Archiv wird gerade kuratiert.</p>
                    </div>
                )}
                
                {/* GRID LOGIC:
                   - grid-flow-dense: Füllt Lücken automatisch auf
                   - auto-rows-[300px]: Basis-Höhe für Standard-Items (1x1)
                   - md:grid-cols-4: Auf Desktop 4 Spalten
                */}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 auto-rows-[300px] grid-flow-dense" id="archiv-grid">
                    {processedItems.map((item: any, index: number) => (
                        <a 
                            href={`/archiv/${item.slug || item.id}/`}
                            class={`archiv-card group relative rounded-[40px] md:rounded-[64px] overflow-hidden transition-all duration-700 bg-slate-50 dark:bg-slate-900 block
                            
                            /* ASPECT RATIO LOGIC */
                            ${item.aspect === 'wide' ? 'md:col-span-2 md:row-span-2' : ''} 
                            ${item.aspect === 'tall' ? 'md:row-span-2' : ''}
                            /* Standard (kein Match) ist automatisch 1x1 */

                            hover:shadow-2xl hover:-translate-y-2 border border-transparent dark:border-white/5
                            opacity-0 translate-y-8`} 
                            data-year={item.year}
                            data-category={item.category} 
                            style={`transition-delay: ${(index % 4) * 50}ms`} 
                        >
                            <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-[inherit]">
                                <Image 
                                    src={`${ASSET_URL}/${item.image}`} 
                                    width={item.aspect === 'wide' ? 1200 : 800}
                                    height={item.aspect === 'wide' ? 800 : 1000}
                                    alt={item.title}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-1000 ease-out"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-700"></div>
                            </div>

                            <div class="absolute inset-0 p-8 md:p-10 flex flex-col justify-end z-10 pointer-events-none">
                                <span class="text-[10px] font-black text-rose-500 uppercase tracking-[0.4em] mb-4 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">{item.year}</span>
                                <h3 class={`font-display font-black text-white uppercase tracking-tighter leading-tight mb-4 transition-transform duration-500 group-hover:-translate-y-2
                                    ${item.aspect === 'wide' ? 'text-4xl md:text-6xl' : 'text-3xl'}`}>
                                    {item.title}
                                </h3>
                                
                                {item.cardText && (
                                    <p class="text-slate-300 text-sm opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-100 line-clamp-2">
                                        {item.cardText}
                                    </p>
                                )}
                            </div>

                            <div class="absolute top-6 right-6 md:top-10 md:right-10 z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none scale-50 group-hover:scale-100">
                                <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-2xl">
                                    <i class="fa-solid fa-arrow-right -rotate-45 group-hover:rotate-0 transition-transform duration-500 text-sm md:text-xl"></i>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>
</MainLayout>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Animation Utilities */
    .reveal-text {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
    .archiv-card.is-visible {
        opacity: 1; 
        transform: translateY(0);
    }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }
    .delay-100 { animation-delay: 100ms; transition-delay: 100ms; }
    .delay-200 { animation-delay: 200ms; transition-delay: 200ms; }
</style>

<script>
    function initArchiv() {
        const filterNav = document.getElementById('archiv-filter-nav');
        const cards = document.querySelectorAll('.archiv-card');
        const scrollElements = document.querySelectorAll('.reveal-on-scroll');

        // --- 1. SCROLL OBSERVER ---
        const observerOptions = { threshold: 0.1, rootMargin: "0px 0px -50px 0px" };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        scrollElements.forEach(el => observer.observe(el));
        cards.forEach(card => observer.observe(card));

        // --- 2. FILTER LOGIC ---
        if (!filterNav) return;

        filterNav.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('.filter-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            const category = btn.getAttribute('data-category');
            const allBtns = filterNav.querySelectorAll('.filter-btn');
            
            allBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            cards.forEach(card => {
                const cardCategory = card.getAttribute('data-category');
                const shouldShow = (category === 'all' || cardCategory === category);
                
                if (shouldShow) {
                    (card as HTMLElement).style.display = 'block';
                    requestAnimationFrame(() => {
                        card.classList.remove('opacity-0', 'scale-95');
                        card.classList.add('is-visible'); 
                    });
                } else {
                    card.classList.remove('is-visible'); 
                    card.classList.add('opacity-0', 'scale-95'); 
                    setTimeout(() => {
                        (card as HTMLElement).style.display = 'none';
                    }, 500);
                }
            });
        });
    }

    initArchiv();
    document.addEventListener('astro:after-swap', initArchiv);
</script>