---
import MainLayout from '../../layouts/layout.astro';
import { getArchiv } from '../../lib/api';
import { Image } from 'astro:assets';

const archivItems = await getArchiv();
const safeArchivItems = Array.isArray(archivItems) ? archivItems : [];

// FIX: Bilder über Public URL laden
const ASSET_URL = (import.meta.env.PUBLIC_API_URL || 'https://api.diebruecke.social') + '/assets';

// --- HELPER ---
const stripHtml = (html: string) => {
    if (!html) return '';
    return html.replace(/<[^>]*>?/gm, ''); 
};

// --- DATA PROCESSING ---
const epochFilters = [
    { key: 'early_years', label: 'Pionierjahre', range: '1983–1990' },
    { key: 'first_years', label: 'Etablierung', range: '1991–2000' },
    { key: 'pro_years', label: 'Professionalisierung', range: '2001–2010' },
    { key: 'modern_years', label: 'Die Moderne', range: '2011–heute' },
];

const typeFilters = [
    { key: 'reports', label: 'Jahresberichte', icon: 'fa-file-pdf' },
    { key: 'gallery', label: 'Galerien & Fotos', icon: 'fa-images' },
];

const processedItems = safeArchivItems.map((item: any) => {
    let displayText = item.teaser;
    if (!displayText && item.description) {
        displayText = stripHtml(item.description);
    }

    const hasPdf = !!item.pdf_file;
    const hasGallery = Array.isArray(item.gallery) && item.gallery.length > 0;

    return {
        ...item,
        category: item.category || 'other',
        cardText: displayText,
        hasPdf,
        hasGallery
    };
});

const randomItem = processedItems.length > 0 
    ? processedItems[Math.floor(Math.random() * processedItems.length)]
    : null;
---

<MainLayout title="Das Archiv | Verein Die Brücke">
    <main class="bg-white dark:bg-slate-950 transition-colors duration-500 overflow-hidden rounded-[48px] m-2 md:m-4 border border-slate-200 dark:border-slate-800 shadow-2xl min-h-screen relative isolate">
        
        {/* --- FILM GRAIN & GLOW --- */}
        <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.07] pointer-events-none z-0 mix-blend-overlay"
             style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22 opacity=%221%22/%3E%3C/svg%3E');">
        </div>
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-rose-500/5 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2 z-0"></div>
        
        {/* --- HERO SECTION --- */}
        <section class="px-2 sm:px-6 pt-4 pb-0 relative z-10">
            <div class="relative bg-slate-900 rounded-[40px] overflow-hidden min-h-[50vh] md:min-h-[60vh] flex items-center px-4 md:px-16 py-12 md:py-24 shadow-2xl">
                <div class="absolute inset-0 overflow-hidden pointer-events-none">
                    <div class="absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-rose-600/10 rounded-full blur-[120px] animate-pulse-slow"></div>
                    <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-indigo-600/10 rounded-full blur-[120px] animate-pulse-slower"></div>
                </div>

                <div class="max-w-7xl mx-auto w-full relative z-10">
                    <div class="mb-8 flex justify-between items-start">
                        <a href="/about" class="inline-flex items-center text-slate-400 hover:text-white font-bold transition-colors group text-xs uppercase tracking-widest">
                            <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                            Über uns
                        </a>
                        
                        {randomItem && (
                            <a href={`/archiv/${randomItem.slug || randomItem.id}/`} class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 hover:bg-white/10 text-white text-xs font-bold uppercase tracking-wider transition-all hover:scale-105 backdrop-blur-sm">
                                <i class="fa-solid fa-shuffle text-rose-400"></i>
                                <span>Zufalls-Moment</span>
                            </a>
                        )}
                    </div>
                    
                    <h1 class="font-display font-bold text-white mb-8 tracking-tighter uppercase">
                        <span class="block text-[clamp(2.5rem,8vw,6rem)] leading-none mb-0 reveal-text">Das</span>
                        <span class="block text-[clamp(2.5rem,10vw,9rem)] leading-tight text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-indigo-400 italic whitespace-nowrap py-4 pr-4 -ml-1 -mt-2 md:-mt-6 reveal-text delay-100">
                            Gedächtnis.
                        </span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl font-medium border-l-4 border-rose-500 pl-6 reveal-text delay-200">
                        42 Jahre Brücke Graz. Ein lebendiges Mosaik unserer Geschichte.
                    </p>
                </div>
            </div>
        </section>

        {/* --- INTRO TEXT SECTION --- */}
        <section class="px-4 sm:px-10 py-16 md:py-24 max-w-7xl mx-auto relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
                
                <div class="md:col-span-5 md:sticky md:top-32">
                    <h2 class="font-display font-black text-3xl md:text-5xl uppercase tracking-tight text-slate-900 dark:text-white mb-6 leading-none reveal-on-scroll">
                        42 Jahre <span class="text-rose-500">Brücke</span>
                    </h2>
                    <p class="text-xl md:text-2xl font-serif italic text-slate-500 dark:text-slate-400 leading-relaxed reveal-on-scroll delay-100">
                        „Vom Pioniergeist zur Institution – ein digitales Gedächtnis für das erste barrierefreie Kulturzentrum Österreichs.“
                    </p>
                    <div class="h-1 w-24 bg-rose-500 mt-8 rounded-full reveal-on-scroll delay-200"></div>
                </div>

                <div class="md:col-span-7 prose prose-lg prose-slate dark:prose-invert max-w-none">
                    <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300 relative reveal-on-scroll">
                        <span class="float-left text-[7rem] leading-[0.65] font-display font-black text-rose-500 mr-3 mt-3">E</span>
                        <span class="font-bold uppercase tracking-wider text-slate-900 dark:text-white text-sm">s begann an einem</span> kalten Novembertag im Jahr 1983. Die Idee war so simpel wie revolutionär: Einen Ort in Graz zu schaffen, an dem Menschen nach Schicksalsschlägen oder Unfällen nicht isoliert sind, sondern mitten im Leben stehen.
                    </p>
                    
                    <p class="text-slate-600 dark:text-slate-400 reveal-on-scroll">
                        Was damals als mutiges Experiment begann, ist heute – über vier Jahrzehnte später – eine feste Institution in der österreichischen Kultur- und Soziallandschaft. In diesem Archiv blicken wir zurück.
                    </p>

                    {/* Work in Progress */}
                    <div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-800 reveal-on-scroll">
                        <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
                            <div class="w-16 h-16 rounded-full bg-rose-50 dark:bg-rose-900/20 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-hammer text-rose-500 text-2xl animate-pulse-slow"></i>
                            </div>
                            <div>
                                <h4 class="font-display font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2">Work in Progress</h4>
                                <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed">
                                    Ein Archiv baut sich nicht von alleine. Wir arbeiten kontinuierlich daran, unsere Geschichte aufzuarbeiten. 
                                    Schaut öfters vorbei – es gibt immer wieder etwas <span class="text-rose-500 font-bold italic">„neues Altes“</span> zu entdecken!
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* --- STICKY FILTER BAR (Optimiert: Labels in Rot + Doppelpunkt) --- */}
        <nav id="archiv-filter-nav" class="sticky top-0 z-50 bg-white/95 dark:bg-slate-950/95 backdrop-blur-xl border-y border-slate-100 dark:border-slate-900 transition-all duration-300 shadow-sm">
            <div class="max-w-7xl mx-auto">
                
                {/* ZEILE 1: EPOCHEN (ZEIT) */}
                <div class="overflow-x-auto hide-scrollbar border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-5 min-w-max px-4 sm:px-10 py-5">
                        {/* ÄNDERUNG: Text in Rose + Doppelpunkt */}
                        <span class="text-[10px] font-black uppercase tracking-widest text-rose-600 dark:text-rose-500 mr-2 shrink-0 select-none">Zeitraum:</span>
                        
                        {/* Alle Jahre */}
                        <button class="time-btn active group cursor-pointer flex items-center justify-center px-5 py-3 rounded-full transition-all duration-300 bg-slate-50 dark:bg-slate-900 hover:bg-rose-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 hover:border-rose-200 hover:-translate-y-0.5" data-time="all">
                            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 group-[.active]:text-rose-600 transition-colors">Alle Jahre</span>
                        </button>

                        {/* Epochen Buttons */}
                        {epochFilters.map(cat => (
                            <button class="time-btn group cursor-pointer flex items-center justify-center px-5 py-3 rounded-full transition-all duration-300 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700 hover:-translate-y-0.5" data-time={cat.key}>
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white group-[.active]:text-rose-500 transition-colors mr-2">{cat.label}</span>
                                <span class="text-[10px] text-slate-300 font-mono group-[.active]:text-rose-400/60">{cat.range}</span>
                            </button>
                        ))}
                    </div>
                </div>

                {/* ZEILE 2: ARTEN (TYP) */}
                <div class="overflow-x-auto hide-scrollbar bg-slate-50/50 dark:bg-slate-900/30">
                    <div class="flex items-center gap-4 min-w-max px-4 sm:px-10 py-4">
                        {/* ÄNDERUNG: Text in Rose + Doppelpunkt */}
                        <span class="text-[10px] font-black uppercase tracking-widest text-rose-600 dark:text-rose-500 mr-2 shrink-0 select-none">Inhalt:</span>

                        {/* Alle Arten */}
                        <button class="type-btn active group cursor-pointer flex items-center gap-2 px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700 hover:shadow-sm" data-type="all">
                            <i class="fa-solid fa-layer-group text-slate-400 group-[.active]:text-rose-600 text-xs"></i>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 group-[.active]:text-rose-600 transition-colors">Alle Arten</span>
                        </button>

                        {/* Typen Buttons */}
                        {typeFilters.map(type => (
                            <button class="type-btn group cursor-pointer flex items-center gap-2 px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700 hover:shadow-sm" data-type={type.key}>
                                <i class={`fa-solid ${type.icon} text-slate-300 group-hover:text-rose-500 group-[.active]:text-rose-500 text-xs transition-colors`}></i>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white group-[.active]:text-rose-600 transition-colors">{type.label}</span>
                            </button>
                        ))}
                    </div>
                </div>

            </div>
        </nav>

        {/* --- BENTO GRID --- */}
        <section class="px-4 sm:px-10 py-12 md:py-24 bg-white dark:bg-slate-950 relative z-10">
            <div class="w-full">
                {processedItems.length === 0 && (
                    <div class="text-center py-24 text-slate-400">
                        <p>Das Archiv wird gerade kuratiert.</p>
                    </div>
                )}
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 auto-rows-[300px] grid-flow-dense" id="archiv-grid">
                    {processedItems.map((item: any, index: number) => (
                        <a 
                            href={`/archiv/${item.slug || item.id}/`}
                            class={`archiv-card group relative rounded-[40px] md:rounded-[64px] overflow-hidden transition-all duration-700 bg-slate-50 dark:bg-slate-900 block
                            ${item.aspect === 'wide' ? 'md:col-span-2 md:row-span-2' : ''} 
                            ${item.aspect === 'tall' ? 'md:row-span-2' : ''}
                            hover:shadow-2xl hover:-translate-y-2 border border-transparent dark:border-white/5
                            opacity-0 translate-y-8`} 
                            
                            data-year={item.year}
                            data-category={item.category}
                            data-has-pdf={item.hasPdf ? 'true' : 'false'}
                            data-has-gallery={item.hasGallery ? 'true' : 'false'}
                            
                            style={`transition-delay: ${(index % 4) * 50}ms`} 
                        >
                            {/* BILD */}
                            <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-[inherit]">
                                <Image 
                                    src={`${ASSET_URL}/${item.image}`} 
                                    width={item.aspect === 'wide' ? 1200 : 800}
                                    height={item.aspect === 'wide' ? 800 : 1000}
                                    alt={item.title}
                                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-1000 ease-out"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-700"></div>
                            </div>

                            {/* BADGES */}
                            <div class="absolute top-6 left-6 flex gap-2 z-20">
                                {item.hasPdf && (
                                    <div class="w-8 h-8 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white border border-white/20" title="Dokument verfügbar">
                                        <i class="fa-solid fa-file-pdf text-xs"></i>
                                    </div>
                                )}
                                {item.hasGallery && (
                                    <div class="w-8 h-8 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white border border-white/20" title="Galerie verfügbar">
                                        <i class="fa-solid fa-images text-xs"></i>
                                    </div>
                                )}
                            </div>

                            {/* CONTENT */}
                            <div class="absolute inset-0 p-8 md:p-10 flex flex-col justify-end z-10 pointer-events-none">
                                <span class="text-[10px] font-black text-rose-500 uppercase tracking-[0.4em] mb-4 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">{item.year}</span>
                                <h3 class={`font-display font-black text-white uppercase tracking-tighter leading-tight mb-4 transition-transform duration-500 group-hover:-translate-y-2
                                    ${item.aspect === 'wide' ? 'text-4xl md:text-6xl' : 'text-3xl'}`}>
                                    {item.title}
                                </h3>
                                {item.cardText && (
                                    <p class="text-slate-300 text-sm opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-100 line-clamp-2">
                                        {item.cardText}
                                    </p>
                                )}
                            </div>

                            {/* ARROW */}
                            <div class="absolute top-6 right-6 md:top-10 md:right-10 z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none scale-50 group-hover:scale-100">
                                <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-2xl">
                                    <i class="fa-solid fa-arrow-right -rotate-45 group-hover:rotate-0 transition-transform duration-500 text-sm md:text-xl"></i>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>
</MainLayout>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Animation Utilities */
    .reveal-text {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
    .archiv-card.is-visible {
        opacity: 1; 
        transform: translateY(0);
    }

    /* Active State Styles */
    .time-btn.active {
        background-color: #fff1f2; /* rose-50 */
        border-color: #fecdd3; /* rose-200 */
        box-shadow: 0 4px 6px -1px rgb(244 63 94 / 0.1);
        transform: scale(1.02);
    }
    :global(.dark) .time-btn.active {
        background-color: #1e293b; /* slate-800 */
        border-color: #334155; /* slate-700 */
        box-shadow: none;
    }

    .type-btn.active {
        background-color: #ffffff;
        border-color: #fecdd3; /* rose-200 */
        box-shadow: 0 2px 4px 0 rgb(0 0 0 / 0.05);
    }
    :global(.dark) .type-btn.active {
        background-color: #1e293b; /* slate-800 */
        border-color: #334155; /* slate-700 */
    }

    /* Soft transition for buttons */
    button {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }
    .delay-100 { animation-delay: 100ms; transition-delay: 100ms; }
    .delay-200 { animation-delay: 200ms; transition-delay: 200ms; }
</style>

<script>
    function initArchiv() {
        const filterNav = document.getElementById('archiv-filter-nav');
        if (!filterNav) return; // Guard clause

        const cards = document.querySelectorAll('.archiv-card');
        const scrollElements = document.querySelectorAll('.reveal-on-scroll');

        // Status Variables
        let activeTime = 'all';
        let activeType = 'all';

        // --- 1. FILTER FUNCTION ---
        const applyFilters = () => {
            cards.forEach(card => {
                const cardEl = card as HTMLElement;
                
                // 1. Check Time
                const cardCategory = cardEl.getAttribute('data-category');
                const matchesTime = (activeTime === 'all') || (cardCategory === activeTime);

                // 2. Check Type
                const hasPdf = cardEl.getAttribute('data-has-pdf') === 'true';
                const hasGallery = cardEl.getAttribute('data-has-gallery') === 'true';
                
                let matchesType = false;
                if (activeType === 'all') {
                    matchesType = true;
                } else if (activeType === 'reports') {
                    matchesType = hasPdf;
                } else if (activeType === 'gallery') {
                    matchesType = hasGallery;
                }

                // SHOW / HIDE Logic (AND Verknüpfung)
                if (matchesTime && matchesType) {
                    cardEl.style.display = 'block';
                    requestAnimationFrame(() => {
                        cardEl.classList.remove('opacity-0', 'scale-95');
                        cardEl.classList.add('is-visible'); 
                    });
                } else {
                    cardEl.classList.remove('is-visible'); 
                    cardEl.classList.add('opacity-0', 'scale-95'); 
                    setTimeout(() => {
                        if (!cardEl.classList.contains('is-visible')) {
                            cardEl.style.display = 'none';
                        }
                    }, 500);
                }
            });
        };

        // --- 2. EVENT LISTENERS ---
        
        // Time Buttons (Zeile 1)
        const timeBtns = filterNav.querySelectorAll('.time-btn');
        timeBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                // Toggle UI
                timeBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                // Set State & Filter
                activeTime = btn.getAttribute('data-time') || 'all';
                applyFilters();
            });
        });

        // Type Buttons (Zeile 2)
        const typeBtns = filterNav.querySelectorAll('.type-btn');
        typeBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                // Toggle UI
                typeBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // Set State & Filter
                activeType = btn.getAttribute('data-type') || 'all';
                applyFilters();
            });
        });


        // --- 3. SCROLL OBSERVER (Visuals) ---
        const observerOptions = { threshold: 0.1, rootMargin: "0px 0px -50px 0px" };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        scrollElements.forEach(el => observer.observe(el));
        cards.forEach(card => observer.observe(card));
    }

    initArchiv();
    document.addEventListener('astro:after-swap', initArchiv);
</script>