---
import MainLayout from '../../layouts/layout.astro';
import ImageGallery from '../../components/common/ImageGallery.astro';
import { getArchiv } from '../../lib/api';

// WICHTIG: Damit sagst du Astro, dass dies eine statische Seite ist
export const prerender = true;

export async function getStaticPaths() {
    const archivItems = await getArchiv();
    return (archivItems || []).map((item: any) => ({
        params: { slug: String(item.slug || item.id).trim() },
        props: { item },
    }));
}

const { slug } = Astro.params;
let { item } = Astro.props;

if (!item) {
    const allItems = await getArchiv();
    item = allItems.find((a: any) => String(a.slug || a.id) === slug);
}

const ASSET_URL = import.meta.env.DIRECTUS_URL + '/assets';
const currentUrl = Astro.url.href;
---

<MainLayout title={item ? `${item.title} | Archiv` : "Ladefehler"}>
    <main class="bg-white dark:bg-slate-950 min-h-screen transition-colors duration-500 pb-32">
        
        {!item ? (
            <div class="h-screen flex flex-col items-center justify-center">
                <h1 class="text-rose-500 font-display text-9xl font-black">404</h1>
                <a href="/archiv" class="mt-8 text-slate-500 uppercase tracking-widest font-black text-xs">Zurück</a>
            </div>
        ) : (
            <>
                {/* --- HERO --- */}
                <section class="px-4 sm:px-6 pt-6 pb-12">
                    <div class="relative bg-slate-900 rounded-[48px] overflow-hidden min-h-[60vh] flex items-end px-6 md:px-16 py-24 shadow-2xl">
                        <div class="absolute inset-0 z-0">
                            <img 
                                src={`${ASSET_URL}/${item.image}`} 
                                class="w-full h-full object-cover grayscale brightness-[0.3]"
                                alt={item.title}
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                        </div>

                        <div class="max-w-7xl mx-auto w-full relative z-10">
                            <div class="mb-8">
                                <a href="/archiv" class="inline-flex items-center text-slate-400 hover:text-white font-bold transition-colors group text-xs uppercase tracking-widest">
                                    <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                                    Zurück zum Archiv
                                </a>
                            </div>
                            <h1 class="text-6xl md:text-[8rem] font-display font-bold text-white mb-8 leading-[0.85] tracking-tighter uppercase">
                                {item.title}
                            </h1>
                            <div class="flex items-center gap-4 text-rose-500 font-mono text-xl">
                                <span class="font-bold">ID-{item.id.toString().padStart(3, '0')}</span>
                                <span class="text-white/20">/</span>
                                <span class="text-white/40 uppercase tracking-[0.3em] text-[10px] font-black">{item.year}</span>
                            </div>
                        </div>
                    </div>
                </section>

                {/* --- CONTENT SECTION --- */}
                <section class="max-w-7xl mx-auto px-6 sm:px-10 mt-24">
                    <div class="grid lg:grid-cols-12 gap-12 md:gap-24">
                        
                        {/* LEFT: INFO & SOCIALS */}
                        <aside class="lg:col-span-4 lg:border-r border-slate-100 dark:border-slate-900 lg:pr-16">
                            <div class="sticky top-32 space-y-12">
                                <div>
                                    <h4 class="text-rose-500 text-[10px] font-black uppercase tracking-[0.4em] mb-4">Zeitpunkt</h4>
                                    <p class="text-3xl font-display font-bold text-slate-950 dark:text-white uppercase tracking-tight">Erschienen {item.year}</p>
                                </div>

                                <div>
                                    <h4 class="text-rose-500 text-[10px] font-black uppercase tracking-[0.4em] mb-4">Sammlungs-Info</h4>
                                    {/* FIX: div statt p und set:html nutzen */}
                                    <div 
                                        class="text-sm text-slate-500 dark:text-slate-400 font-medium leading-relaxed italic"
                                        set:html={item.info_text || "Hinter jedem Fragment in unserem Archiv steckt eine echte Begegnung."}
                                    />
                                </div>

                                <div class="pt-8 border-t border-slate-50 dark:border-slate-900">
                                    <h4 class="text-slate-400 text-[10px] font-black uppercase tracking-[0.4em] mb-6">Teilen</h4>
                                    <div class="flex gap-3">
                                        <a href={`https://wa.me/?text=${currentUrl}`} target="_blank" class="w-10 h-10 rounded-full border border-slate-100 dark:border-slate-800 flex items-center justify-center hover:bg-green-500 hover:text-white transition-all text-slate-400 text-sm"><i class="fa-brands fa-whatsapp"></i></a>
                                        <a href={`https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`} target="_blank" class="w-10 h-10 rounded-full border border-slate-100 dark:border-slate-800 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all text-slate-400 text-sm"><i class="fa-brands fa-facebook-f"></i></a>
                                        <a href={`https://twitter.com/intent/tweet?url=${currentUrl}`} target="_blank" class="w-10 h-10 rounded-full border border-slate-100 dark:border-slate-800 flex items-center justify-center hover:bg-black hover:text-white transition-all text-slate-400 text-sm"><i class="fa-brands fa-x-twitter"></i></a>
                                        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${currentUrl}`} target="_blank" class="w-10 h-10 rounded-full border border-slate-100 dark:border-slate-800 flex items-center justify-center hover:bg-blue-700 hover:text-white transition-all text-slate-400 text-sm"><i class="fa-brands fa-linkedin-in"></i></a>
                                    </div>
                                </div>
                            </div>
                        </aside>

                        {/* RIGHT: CONTENT */}
                        <article class="lg:col-span-8">
                            {item.teaser && (
                                <div class="mb-12">
                                    <h2 class="text-3xl md:text-5xl font-display font-black text-slate-900 dark:text-white leading-[1.1] uppercase tracking-tighter">
                                        {item.teaser}
                                    </h2>
                                    <div class="w-20 h-1 bg-rose-500 mt-12"></div>
                                </div>
                            )}

                            {/* FIX: Haupttext - set:html nutzen, Klassen direkt auf Wrapper anwenden */}
                            <div 
                                class="max-w-3xl text-lg md:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-medium [&>p]:mb-4"
                                set:html={item.description}
                            />

                            {/* UNTERES BILD */}
                            <div class="mt-24 mb-16 rounded-[48px] overflow-hidden bg-slate-50 dark:bg-slate-900 p-2 shadow-sm border border-slate-100 dark:border-slate-900">
                                <img 
                                    src={`${ASSET_URL}/${item.image}?key=system-large-cover`} 
                                    class="w-full h-auto rounded-[40px] grayscale hover:grayscale-0 transition-all duration-700" 
                                    alt="Fragment Detail"
                                />
                            </div>

                            {/* GALERIE KOMPONENTE */}
                            <ImageGallery gallery={item.gallery} />

                        </article>
                    </div>
                </section>
            </>
        )}
    </main>
</MainLayout>