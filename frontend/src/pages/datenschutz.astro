---
import MainLayout from '../layouts/layout.astro';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

let page;
try {
    const pages = await directus.request(readItems('pages', {
        filter: { slug: { _eq: 'datenschutz' } }
    }));
    page = pages[0];
} catch (error) {
    console.error("Datenschutz: Content nicht geladen", error);
}
---

<MainLayout title={page?.title || "Datenschutz"}>
    
    {/* --- HERO SECTION --- */}
    <section class="relative pt-32 pb-20 px-6 sm:px-10 overflow-hidden">
        <div class="max-w-4xl mx-auto relative z-10">
            {/* Tag / Badge */}
            <span class="inline-block px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-6">
                Privatsphäre & Sicherheit
            </span>
            
            {/* Headline */}
            <h1 class="text-4xl md:text-6xl font-display font-extrabold text-slate-900 dark:text-white mb-6 tracking-tight">
                {page?.title || "Datenschutz."}
            </h1>
            
            {/* Subline */}
            <p class="text-xl text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed">
                Wir gehen sorgsam mit deinen Daten um. Hier findest du unsere Datenschutzerklärung.
            </p>
        </div>
        
        {/* Background Blob (Dark Mode angepasst) */}
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-slate-50 dark:bg-slate-800/30 rounded-full blur-3xl opacity-60 pointer-events-none -translate-y-1/2 translate-x-1/4"></div>
    </section>

    {/* --- CONTENT SECTION --- */}
    <section class="px-6 sm:px-10 pb-24">
        <div class="max-w-4xl mx-auto">
            
            {page?.content ? (
                /* INHALT AUS DIRECTUS */
                /* WICHTIG: dark:prose-invert sorgt für weiße Schrift im Darkmode */
                <div class="prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-headings:font-bold prose-a:text-rose-600 dark:prose-a:text-rose-400 prose-li:marker:text-rose-500">
                    <div set:html={page.content} />
                </div>
            ) : (
                /* FALLBACK */
                <div class="text-center p-12 bg-slate-50 dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800">
                    <i class="fa-solid fa-file-contract text-4xl text-slate-300 dark:text-slate-700 mb-4"></i>
                    <h3 class="text-xl font-bold text-slate-700 dark:text-white">Inhalt wird geladen...</h3>
                    <p class="text-slate-500 dark:text-slate-400">Bitte pflege den Inhalt für die Seite "datenschutz" im Directus Backend ein.</p>
                </div>
            )}

        </div>
    </section>

</MainLayout>