---
import MainLayout from '../layouts/layout.astro';
---

<MainLayout title="Mitmachen | Die Brücke">
    
    <div class="home-content px-4 md:px-6">
        
        {/* --- HERO SECTION --- */}
        <section class="relative z-10 px-6 sm:px-10 pt-32 pb-32 bg-white rounded-t-[32px] md:rounded-t-[64px] overflow-hidden">
            <div class="max-w-7xl mx-auto relative z-10">
                
                <div class="mb-12">
                    <a href="/" class="inline-flex items-center text-slate-500 hover:text-slate-900 font-bold transition-colors group text-sm uppercase tracking-widest">
                        <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                        Zurück zur Startseite
                    </a>
                </div>

                <div class="max-w-6xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-50 border border-slate-200 text-xs font-bold text-rose-500 mb-8 uppercase tracking-widest shadow-sm">
                        <span class="text-[10px] mb-0.5">●</span> Teil der Bewegung werden
                    </div>
                    
                    <h1 class="text-6xl md:text-8xl font-display font-extrabold text-slate-900 tracking-tighter leading-[0.9] mb-12">
                        Dein Einsatz. <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 via-indigo-500 to-indigo-600">Unser Miteinander.</span>
                    </h1>
                    
                    <p class="text-xl text-slate-500 max-w-2xl leading-relaxed border-l-4 border-rose-500 pl-8 font-medium">
                        Inklusion ist kein Zuschauer-Sport. Ob als Ehrenamtliche:r, Praktikant:in oder Spender:in – dein Engagement schafft den Raum, in dem Barrieren verschwinden.
                    </p>
                </div>
            </div>
        </section>

        {/* --- MITMACH-OPTIONEN GRID --- */}
        <section class="px-6 sm:px-10 py-24 bg-white">
            <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                
                {/* 1. Ehrenamt */}
                <div class="group bg-slate-50 rounded-[40px] p-10 border border-slate-100 hover:shadow-xl transition-all duration-500">
                    <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center text-slate-900 text-xl mb-8 shadow-sm group-hover:bg-rose-500 group-hover:text-white transition-all">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>
                    <h3 class="text-2xl font-display font-bold text-slate-900 mb-4 tracking-tight">Ehrenamt</h3>
                    <p class="text-slate-500 text-sm leading-relaxed font-medium">Schenke Zeit. Begleite uns bei Ausflügen, im Café oder bei unseren Kultur-Events in Graz.</p>
                </div>

                {/* 2. Praktikum */}
                <div class="group bg-slate-50 rounded-[40px] p-10 border border-slate-100 hover:shadow-xl transition-all duration-500">
                    <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center text-slate-900 text-xl mb-8 shadow-sm group-hover:bg-rose-500 group-hover:text-white transition-all">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3 class="text-2xl font-display font-bold text-slate-900 mb-4 tracking-tight">Praktikum</h3>
                    <p class="text-slate-500 text-sm leading-relaxed font-medium">Lerne Inklusion von den Pionieren. Wir bieten Praktikumsplätze für soziale Berufe & Studium.</p>
                </div>

                {/* 3. Mitgliedschaft */}
                <div class="group bg-slate-50 rounded-[40px] p-10 border border-slate-100 hover:shadow-xl transition-all duration-500">
                    <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center text-slate-900 text-xl mb-8 shadow-sm group-hover:bg-rose-500 group-hover:text-white transition-all">
                        <i class="fa-solid fa-id-card"></i>
                    </div>
                    <h3 class="text-2xl font-display font-bold text-slate-900 mb-4 tracking-tight">Mitgliedschaft</h3>
                    <p class="text-slate-500 text-sm leading-relaxed font-medium">Werde Teil des Vereins. Mit deinem Beitrag sicherst du unsere unabhängige Arbeit seit 1983.</p>
                </div>

                {/* 4. SPONSORING (UPDATED TEXT) */}
                <div class="group relative bg-white rounded-[40px] p-10 border-2 border-rose-500/20 shadow-2xl shadow-rose-500/10 hover:shadow-rose-500/20 hover:-translate-y-1 transition-all duration-500 overflow-hidden">
                    {/* Background Glow */}
                    <div class="absolute top-0 right-0 w-32 h-32 bg-rose-100 rounded-full blur-3xl -mr-16 -mt-16 opacity-50"></div>
                    
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-rose-500 flex items-center justify-center text-white text-xl mb-8 shadow-lg shadow-rose-500/30 animate-pulse-slow">
                            <i class="fa-solid fa-handshake"></i>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-rose-500 mb-2 block">Für Unternehmen</span>
                        <h3 class="text-2xl font-display font-bold text-slate-900 mb-4 tracking-tight">Helden gesucht</h3>
                        
                        <p class="text-slate-600 text-sm leading-relaxed font-medium mb-6">
                            Inklusion ist verdammt gut fürs Karma – und für dein Image. Werde unser Lieblings-Partner und investiere in Momente, die wirklich zählen, statt in heiße Luft.
                        </p>
                        
                        <a href="mailto:office@diebruecke.cc?subject=Sponsoring%20Anfrage" class="inline-flex items-center text-rose-600 font-bold text-sm hover:underline decoration-2 underline-offset-4">
                            Lass uns reden <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
                        </a>
                    </div>
                </div>

            </div>
        </section>

        {/* --- SPENDEN-SEKTION (UPDATED IMAGE) --- */}
        <section class="mb-10 rounded-[48px] px-6 sm:px-10 py-32 bg-slate-900 text-white relative overflow-hidden shadow-2xl">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-rose-600/5 skew-x-12 translate-x-1/4"></div>
            <div class="max-w-7xl mx-auto relative z-10 grid lg:grid-cols-2 gap-24 items-center">
                <div>
                    <span class="text-rose-500 font-bold tracking-widest uppercase text-xs mb-6 block underline decoration-rose-500 decoration-2 underline-offset-8">Support & Spenden</span>
                    <h2 class="text-4xl md:text-6xl font-display font-extrabold mb-8 tracking-tighter leading-tight">
                        Ermögliche <br><span class="text-rose-500 italic">neue Wege.</span>
                    </h2>
                    <p class="text-xl text-slate-400 leading-relaxed mb-10 max-w-xl font-medium">
                        Manche Projekte wie unsere Urlaubsaktionen (Camps) oder spezielle Kultur-Events brauchen finanzielle Starthilfe. Deine Spende kommt direkt dort an, wo sie Barrieren abbaut.
                    </p>
                    <div class="space-y-6">
                        <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10">
                            <i class="fa-solid fa-certificate text-rose-500 text-xl"></i>
                            <span class="font-bold">Spenden steuerlich absetzbar</span>
                        </div>
                        <a href="/contact" class="inline-block px-10 py-4 bg-rose-600 text-white rounded-full font-bold hover:bg-white hover:text-slate-900 transition-all shadow-xl">
                            Jetzt Spenden-Info anfordern
                        </a>
                    </div>
                </div>
                
                {/* --- NEUES BILD --- */}
                <div class="relative rounded-[48px] overflow-hidden border-4 border-white/10 shadow-2xl aspect-square md:aspect-auto h-full min-h-[400px]">
                    <img 
                        src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?q=80&w=1200&auto=format&fit=crop" 
                        class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000" 
                        alt="Gemeinsam Wege gehen" 
                    />
                </div>
            </div>
        </section>

        {/* --- KONTAKT / ORIENTIERUNG --- */}
        <section class="px-6 sm:px-10 pb-12">
            <div class="max-w-7xl mx-auto">
                <div class="p-10 md:p-16 bg-slate-50 rounded-[48px] border border-slate-100 flex flex-col lg:flex-row items-center gap-12">
                    <div class="flex-1 text-center lg:text-left">
                        <h3 class="text-3xl font-display font-bold text-slate-900 mb-6 tracking-tight">
                            Lass uns <span class="text-rose-500">reden.</span>
                        </h3>
                        <p class="text-slate-500 leading-relaxed max-w-2xl font-medium">
                            Du bist dir noch nicht sicher, wie du dich am besten einbringen kannst? Kein Problem. Komm auf einen Kaffee vorbei oder schreib uns eine Nachricht. Wir finden den Platz, der zu dir passt.
                        </p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4 shrink-0">
                        <a href="/contact" class="px-8 py-4 bg-slate-900 text-white rounded-full font-bold hover:bg-rose-600 transition-all shadow-lg text-center">
                            Anfrage schicken
                        </a>
                        <a href="tel:+43316672248" class="px-8 py-4 bg-white border border-slate-200 text-slate-900 rounded-full font-bold hover:border-slate-900 transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-phone text-rose-500"></i> Beratung
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </div>
</MainLayout>