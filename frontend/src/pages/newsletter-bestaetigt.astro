---
import MainLayout from '../layouts/layout.astro';
---

<MainLayout title="Newsletter bestätigt" description="Deine Newsletter-Anmeldung ist bestätigt.">
    <div class="px-4 md:px-6">
        <section class="max-w-2xl mx-auto py-32 text-center">
            <i class="fa-solid fa-paper-plane text-4xl text-rose-500 mb-6" aria-hidden="true"></i>
            <h1 class="text-4xl font-display font-black text-slate-900 dark:text-white mb-4">Du bist dabei!</h1>
            <p class="text-slate-700 dark:text-slate-400 mb-8">Danke, deine Anmeldung zum Newsletter ist bestätigt.</p>
            <a href="/" class="inline-flex bg-slate-900 hover:bg-rose-600 dark:bg-white dark:hover:bg-rose-500 dark:text-slate-950 dark:hover:text-white text-white font-black uppercase tracking-widest px-6 py-3 rounded-xl text-xs transition-all">Zur Startseite</a>
        </section>
    </div>
</MainLayout>
