---
export const prerender = false;

import MainLayout from '../../layouts/layout.astro';
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets'; 

const ASSET_URL = "https://api.diebruecke.social/assets";
const getImg = (id, w = 800) => id ? `${ASSET_URL}/${id}?width=${w}&format=webp&quality=80` : null;

// --- WICHTIG: Variablen HIER definieren, damit sie überall verfügbar sind ---
let services = [];
let pageSettings = null;

try {
  const [servicesData, pagesData] = await Promise.all([
    // 1. Alle Services laden
    directus.request(readItems('services', {
      sort: ['sort'], 
      filter: { status: { _eq: 'published' } }
    })),
    // 2. Page-Settings laden
    directus.request(readItems('pages', {
      filter: { 
        slug: { _eq: 'services' },
        status: { _eq: 'Live' } // Haben wir vorhin auf 'Live' angepasst
      },
      limit: 1
    }))
  ]);

  services = servicesData;
  
  if (pagesData && pagesData.length > 0) {
      pageSettings = pagesData[0];
  }

} catch (error) {
  console.warn("Fehler beim Laden der Daten:", error.message);
}

// --- LOGIK FÜR HERO BILD ---
const fallbackImage = "https://images.pexels.com/photos/1438072/pexels-photo-1438072.jpeg?auto=compress&cs=tinysrgb&w=1200";

// Jetzt ist pageSettings bekannt
const heroImage = pageSettings?.hero_image 
    ? getImg(pageSettings.hero_image, 1600) 
    : fallbackImage;

const seoTitle = pageSettings?.title || "Soziale Dienste & Freizeitassistenz Graz | Angebote";
const seoDescription = "Dein Partner für ein selbstbestimmtes Leben in Graz. Freizeitassistenz, Wohnassistenz, Familienentlastung und inklusive Camps.";
const seoImage = heroImage;


// 2. Kombinierte Services
const allServices = [
  ...services,
  {
    title: "Camps & Reisen",
    slug: "camps",
    color: "from-rose-500 to-rose-600",
    icon: "fa-plane-departure",
    teaser: "Raus aus dem Alltag, rein ins Abenteuer. Wir organisieren barrierefreie Reisen und Camps mit professioneller Begleitung."
  }
];

const serviceColors = ["bg-rose-500", "bg-amber-500", "bg-emerald-500", "bg-sky-500", "bg-purple-500"];

const highlights = [
  {
    title: "City Trips",
    subtitle: "Europa ruft.",
    desc: "Prag, Wien oder Ljubljana? Wir warten nicht auf den Bus, wir starten das Abenteuer.",
    image: "https://images.unsplash.com/photo-1541849546-216549ae216d?q=80&w=1000&auto=format&fit=crop", 
    tags: ["Travel", "Culture"]
  },
  {
    title: "Adventure Time",
    subtitle: "Adrenalin statt Alltag.",
    desc: "Ob beim Segeln oder am Fels – hier geht es nicht um 'Barrierefrei', sondern um 'Grenzenlos'.",
    image: "https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=1000&auto=format&fit=crop", 
    tags: ["Action", "Sport"]
  }
];
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>
    
    {/* --- HERO SECTION: SERVICES --- */}
    <section class="px-4 sm:px-6 pt-6 pb-32">
        <div class="relative bg-slate-900 rounded-[48px] overflow-hidden min-h-[60vh] flex items-center px-6 md:px-16 py-20">
            
            {/* BILD CONTAINER */}
            <div class="absolute top-0 right-0 w-full lg:w-2/3 h-full pointer-events-none overflow-hidden [mask-image:linear-gradient(to_left,black_40%,transparent)]">
                <Image 
                    src={heroImage} 
                    alt={seoTitle}
                    width={1200}
                    height={800}
                    loading="eager"
                    class="w-full h-full object-cover opacity-30 lg:opacity-40 grayscale"
                />
            </div>

            <div class="max-w-7xl mx-auto w-full relative z-20">
                <div class="max-w-none lg:max-w-5xl"> 
                    <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-rose-300 text-[10px] font-bold uppercase tracking-[0.2em] mb-8 backdrop-blur-md">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                        </span>
                        Soziale Dienste seit 1983
                    </div>
                    
                    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-display font-black text-white mb-8 leading-[0.95] tracking-tighter uppercase">
                        <span class="block">Rückenwind für</span>
                        <span class="block">
                            dein 
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-indigo-400">eigenes Ding.</span>
                        </span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-10 max-w-lg font-medium">
                        Vergiss klassische „Betreuung“. Wir liefern dir den Support für Freizeit, Wohnen und Alltag in Graz – genau so, wie du ihn brauchst.
                    </p>
                    
                    <div class="flex flex-wrap gap-4">
                        <a href="#dienste" class="px-10 py-5 bg-white text-slate-900 rounded-full font-bold hover:bg-rose-500 hover:text-white transition-all shadow-xl text-lg transform hover:-translate-y-1">
                            Angebote entdecken
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>


    {/* --- INTRO --- */}
    <section class="px-6 sm:px-10 pt-32 pb-20 bg-white dark:bg-slate-950 transition-colors duration-500">
        <div class="max-w-4xl mx-auto text-center">
            <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] font-black text-rose-500 uppercase tracking-[0.2em] mb-10 shadow-sm">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                </span>
                Mobile Dienste Steiermark
            </div>

            <h2 class="text-5xl md:text-7xl font-display font-black text-slate-900 dark:text-white tracking-tighter leading-[0.9] uppercase mb-10">
                Menschlich. Einfach. <br/>
                <span class="text-rose-500 italic">Dein Weg.</span>
            </h2>

            <p class="text-xl md:text-2xl text-slate-500 dark:text-slate-400 font-medium leading-relaxed max-w-2xl mx-auto mb-12">
                Vergiss den Papierkram. Wir sind dein anerkannter Träger nach dem <strong>Steiermärkischen Behindertengesetz</strong>. Mit Rat, Tat und dem nötigen <span class="text-slate-900 dark:text-white font-bold underline decoration-rose-500 decoration-4 underline-offset-4">Rückenwind</span> für dein Abenteuer Alltag.
            </p>

            <div class="flex flex-col items-center gap-3 text-slate-300 dark:text-slate-700">
                <div class="w-px h-12 bg-gradient-to-b from-rose-500 to-transparent"></div>
            </div>
        </div>
    </section>

    {/* --- SERVICE GRID --- */}
    <section id="angebote" class="px-6 sm:px-10 py-24 transition-colors duration-300">
        <div class="max-w-7xl mx-auto">
            
            <div id="dienste" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-24 text-left">
                
                {allServices.map((service, index) => {
                    const colorClass = serviceColors[index % serviceColors.length];
                    return (
                        <a href={service.slug === 'camps' ? '/camps' : `/services/${service.slug}`} 
                           class="group bg-white dark:bg-slate-900 p-6 md:p-8 rounded-[32px] border border-slate-100 dark:border-slate-800 hover:border-rose-500/30 hover:shadow-2xl hover:shadow-rose-500/5 transition-all duration-500 block flex flex-col h-full relative overflow-hidden">
                            
                            <div class="flex-1 relative z-10">
                                <div class={`w-12 h-12 rounded-2xl ${colorClass} text-white flex items-center justify-center text-xl mb-6 shadow-lg group-hover:rotate-6 transition-transform`}>
                                    <i class={`fa-solid ${service.icon || 'fa-hand-holding-heart'}`}></i>
                                </div>
                                
                                <h3 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-2 group-hover:text-rose-600 transition-colors uppercase leading-tight">
                                    {service.title}
                                </h3>
                                
                                <div class="text-[10px] font-bold text-rose-700 dark:text-rose-400 uppercase tracking-tight mb-4 opacity-0 group-hover:opacity-100 transition-all transform translate-y-2 group-hover:translate-y-0">
                                    Jetzt Details ansehen
                                </div>

                                <p class="text-slate-700 dark:text-slate-400 text-sm leading-relaxed line-clamp-4 font-medium">
                                    {service.teaser || service.description?.replace(/<[^>]*>/g, '')}
                                </p>
                            </div>
                            
                            <div class="mt-8 pt-6 border-t border-slate-50 dark:border-slate-800 flex items-center justify-between">
                                <span class="text-slate-900 dark:text-white font-bold text-xs uppercase tracking-widest">Mehr erfahren</span>
                                <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 group-hover:bg-rose-600 group-hover:text-white transition-all">
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>

            {/* INFO HUB BANNER */}
            <a href="/info" class="group relative bg-slate-900 rounded-[48px] p-10 md:p-14 overflow-hidden flex flex-col md:flex-row items-center justify-between gap-12 shadow-2xl hover:-translate-y-1 transition-all duration-500">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(244,63,94,0.1),transparent)] pointer-events-none"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-8 text-center md:text-left">
                    <div class="w-20 h-20 rounded-3xl bg-white/10 flex items-center justify-center text-rose-500 text-3xl border border-white/10 backdrop-blur-sm shrink-0">
                        <i class="fa-solid fa-circle-info animate-pulse"></i>
                    </div>
                    <div>
                        <h2 class="text-3xl font-display font-bold text-white mb-3 tracking-tight uppercase">Noch unsicher?</h2>
                        <p class="text-slate-400 max-w-xl font-medium leading-relaxed text-lg">
                            Unser Infozentrum ist deine Anlaufstelle für Orientierung & Rechte. Wir finden gemeinsam die passende Unterstützung für deine Pläne.
                        </p>
                    </div>
                </div>
                <div class="relative z-10">
                    <span class="px-8 py-4 bg-rose-600 text-white rounded-full font-bold group-hover:bg-white group-hover:text-slate-900 transition-all inline-flex items-center gap-3 shadow-lg">
                        Zum Infozentrum
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </span>
                </div>
            </a>
        </div>
    </section>

    {/* --- FEATURED CAMPS --- */}
    <section class="px-4 sm:px-6 mb-40">
        <div class="mx-0 md:mx-0 rounded-[48px] px-6 py-16 md:px-8 md:py-32 bg-slate-900 border border-slate-800 relative overflow-hidden shadow-2xl">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-rose-600/10 skew-x-12 translate-x-1/4 pointer-events-none"></div>
            <div class="max-w-7xl mx-auto relative z-10 grid lg:grid-cols-2 gap-16 md:gap-20 items-center text-left">
                <div>
                    <span class="text-rose-500 font-bold tracking-widest uppercase text-[10px] md:text-xs mb-6 block underline decoration-rose-500 decoration-2 underline-offset-8">
                        Highlight der Saison
                    </span>
                    <h2 class="text-4xl md:text-7xl font-display font-extrabold text-white mb-8 tracking-tighter leading-tight uppercase">
                        Der Sommer <br/>gehört <span class="text-rose-500">dir.</span>
                    </h2>
                    <p class="text-lg md:text-xl text-slate-400 leading-relaxed mb-10 max-w-xl">
                        Egal ob Chillen am Balaton oder Action in den Bergen. Wir organisieren Wochen, von denen du noch im Winter erzählen wirst. 
                    </p>
                    <a href="/camps" class="px-10 py-4 bg-rose-600 text-white rounded-full font-bold hover:bg-white hover:text-slate-900 transition-all shadow-xl inline-block hover:scale-105 transform">
                        Alle Camps entdecken
                    </a>
                </div>

                <div class="grid grid-cols-2 gap-3 md:gap-4">
                    {[
                        { name: "Italien", flag: "🇮🇹" },
                        { name: "Tschechien", flag: "🇨🇿" },
                        { name: "Österreich", flag: "🇦🇹" },
                        { name: "Ungarn", flag: "🇭🇺" }
                    ].map(loc => (
                        <div class="bg-white/5 border border-white/10 p-4 md:p-8 rounded-3xl text-center font-bold text-white backdrop-blur-sm hover:bg-white/10 transition-all cursor-default flex flex-col items-center justify-center gap-2">
                            <span class="text-sm md:text-lg uppercase tracking-wider">{loc.name}</span>
                            <span class="text-2xl md:text-3xl">{loc.flag}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    {/* --- HIGHLIGHTS --- */}
    <section class="px-6 sm:px-10 pb-40">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-4xl md:text-6xl font-display font-black text-slate-900 dark:text-white tracking-tighter mb-20 text-center uppercase">
                Next Level <span class="text-rose-500">Specials.</span>
            </h2>
            <div class="grid lg:grid-cols-2 gap-10">
                {highlights.map((item) => (
                    <div class="group relative h-[500px] md:h-[600px] rounded-[48px] overflow-hidden shadow-xl">
                        <Image 
                            src={item.image} 
                            alt={item.title} 
                            width={1000}
                            height={800}
                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-1000 grayscale-0 md:grayscale group-hover:grayscale-0" 
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 md:via-slate-900/20 to-transparent"></div>
                        
                        <div class="absolute bottom-0 left-0 p-8 md:p-12 w-full">
                            <div class="flex gap-2 mb-4 md:mb-6">
                                {item.tags.map(tag => (
                                    <span class="px-3 py-1 rounded-full bg-white/20 backdrop-blur text-white text-[10px] font-bold uppercase tracking-widest border border-white/10">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                            <h3 class="text-3xl md:text-4xl font-display font-bold text-white mb-2 uppercase tracking-tighter">{item.title}</h3>
                            <p class="text-rose-400 font-bold text-lg md:text-xl mb-6 uppercase tracking-tight">{item.subtitle}</p>
                            
                            <p class="text-slate-200 text-base md:text-lg max-w-lg leading-relaxed opacity-100 md:opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-0 md:translate-y-4 group-hover:translate-y-0 line-clamp-3 md:line-clamp-none">
                                {item.desc}
                            </p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
    
    {/* --- KONTAKT INFO --- */}
    <section class="px-6 sm:px-10 pb-24">
        <div class="max-w-7xl mx-auto">
            <div class="p-10 md:p-20 bg-white dark:bg-slate-900 rounded-[48px] border border-slate-100 dark:border-slate-800 flex flex-col lg:flex-row items-center gap-16 text-center lg:text-left shadow-sm">
                
                <div class="flex-1">
                    <h3 class="text-4xl font-display font-black text-slate-900 dark:text-white mb-6 tracking-tight uppercase">
                        Noch Fragen? <br/> <span class="text-rose-500 italic">Kein Stress.</span>
                    </h3>
                    <p class="text-slate-500 dark:text-slate-400 leading-relaxed max-w-2xl font-medium text-xl">
                        Finanzierung, Ablauf oder einfach mal reinschnuppern? Wir klären das unbürokratisch. Wir schaffen die Basis, damit du dich voll auf deinen Weg konzentrieren kannst.
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 shrink-0">
                    <a href="/contact" class="px-10 py-5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full font-bold hover:bg-rose-600 dark:hover:bg-rose-500 dark:hover:text-white transition-all shadow-lg text-center transform hover:-translate-y-1">
                        Termin vereinbaren
                    </a>
                    <a href="tel:+43316672248" class="px-10 py-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white rounded-full font-bold hover:border-slate-900 dark:hover:border-slate-500 transition-all flex items-center justify-center gap-2 transform hover:-translate-y-1">
                        <i class="fa-solid fa-phone text-rose-500"></i> 
                        0316 67 22 48
                    </a>
                </div>

            </div>
        </div>
    </section>
</MainLayout>

{/* --- SCHEMA.ORG STRUCTURED DATA --- */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allServices.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": service.title,
    "description": service.teaser || service.description?.replace(/<[^>]*>/g, '').substring(0, 160),
    "url": `https://diebruecke.cc${service.slug === 'camps' ? '/camps' : '/services/' + service.slug}`
  }))
})} />