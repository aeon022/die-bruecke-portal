---
import MainLayout from '../layouts/layout.astro';
import LocationCard from '../components/LocationCard.astro'; // <-- HIER IST DER IMPORT
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';
import { Image } from 'astro:assets'; 

// 1. Lokale Bilder
import seminarImg from '../assets/seminar.webp';
import partyImg from '../assets/party.webp';

// --- DIRECTUS LOGIK ---
const ASSET_URL = "https://api.diebruecke.social/assets";
const getImg = (id: string, w = 1200) => id ? `${ASSET_URL}/${id}?width=${w}&format=webp&quality=80` : null;

let pageSettings = null;

try {
    const pagesData = await directus.request(readItems('pages', {
        filter: { 
            slug: { _eq: 'space' }
        },
        // WICHTIG: Wir holen explizit die gallery-Relationen mit
        fields: ['*', 'gallery.*'],
        limit: 1
    }));
    
    if (pagesData && pagesData.length > 0) {
        pageSettings = pagesData[0];
    }
} catch (error) {
    console.error("Fehler beim Laden der Space-Daten:", error);
}

// --- EQUIPMENT GRID ---
const equipment = [
    { icon: "fa-users", label: "Bis 400 Gäste", desc: "150 Innenraum / 250 Garten" },
    { icon: "fa-chair", label: "Flexibler Saal", desc: "30-80 Pers. (Bistro bis Reihe)" },
    { icon: "fa-utensils", label: "Catering Bereich", desc: "Buffet räumlich abtrennbar" },
    { icon: "fa-wheelchair", label: "100% Barrierefrei", desc: "Rollstuhlgerechtes WC" },
    { icon: "fa-video", label: "HD Beamer", desc: "Lichtstark für Präsentationen" },
    { icon: "fa-expand", label: "Große Leinwand", desc: "Motorisiert, 16:9 Format" },
    { icon: "fa-user-gear", label: "Technik-Support", desc: "Techniker auf Wunsch vermittelbar" },
    { icon: "fa-microphone-lines", label: "Profi-Audio", desc: "Mikrofone & PA-Anlage" }
];

// --- USE CASES ---
const useCases = [
    {
        title: "Seminare & Workshops",
        subtitle: "Dein Raum am Vormittag",
        desc: "Nutze unsere zentrale Lage für deine Business-Events. Helle Atmosphäre, Bestuhlung nach Wunsch und volle technische Ausstattung.",
        features: ["Flipchart buchbar", "Kaffee-Catering möglich", "Barrierefreier Zugang", "Technischer Betreuer möglich"], 
        image: seminarImg 
    },
    {
        title: "Private Feiern",
        subtitle: "Dein Raum am Abend",
        desc: "Geburtstage, Jubiläen oder Vereinsfeiern. Die Brücke verwandelt sich abends in einen stimmungsvollen Partyraum.",
        features: ["Flexibel für dich", "Essen: Dein Caterer oder DIY", "Lichttechnik für Stimmung", "Eigener Tontechniker zubuchbar"], 
        image: partyImg
    }
];

// --- SEO & BILD KONFIGURATION ---
const fallbackImage = "https://images.unsplash.com/photo-1517457373958-b7bdd4587205";

const heroImage = (pageSettings && pageSettings.hero_image) 
    ? getImg(pageSettings.hero_image, 1600) 
    : fallbackImage;

const seoTitle = pageSettings?.title || "Raumvermietung Graz | Seminarraum & Eventlocation";
const seoDescription = pageSettings?.seo_description || "Dein Raum im Zentrum von Graz. Perfekt für Seminare, Workshops und private Feiern. 150m² flexibel nutzbar, 100% barrierefrei, inkl. Profi-Technik & Garten.";
const seoImage = heroImage;
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>
    
    {/* --- HERO SECTION --- */}
    <section class="px-4 sm:px-6 pt-6 pb-20 dark:bg-slate-900">
        <div class="relative bg-slate-900 rounded-[48px] overflow-hidden min-h-[60vh] flex items-center px-6 md:px-16 py-24">
            
            <div class="absolute top-0 right-0 w-full lg:w-2/3 h-full pointer-events-none overflow-hidden [mask-image:linear-gradient(to_left,black_30%,transparent)]">
                <Image 
                    src={heroImage}
                    alt="Eventlocation Die Brücke Graz"
                    width={1200}
                    height={800}
                    loading="eager"
                    class="w-full h-full object-cover opacity-30 lg:opacity-50 grayscale"
                />
            </div>

            <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
                <div class="absolute top-[-10%] right-[-10%] w-[600px] h-[600px] bg-indigo-500/20 rounded-full blur-[120px] animate-pulse-slow"></div>
                <div class="absolute bottom-[-10%] right-[10%] w-[500px] h-[500px] bg-rose-500/10 rounded-full blur-[100px]"></div>
                <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 mix-blend-overlay"></div>
            </div>

            <div class="max-w-7xl mx-auto w-full relative z-20">
                <div class="max-w-3xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-rose-300 text-xs font-bold uppercase tracking-widest mb-8 backdrop-blur-md">
                        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                        Infrastruktur & Technik
                    </div>
                    
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-display font-black text-white mb-8 leading-[0.95] tracking-tighter uppercase">
                        Dein Raum für <br class="hidden sm:block"/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-indigo-400 whitespace-nowrap">große Ideen.</span>
                    </h1>
                    
                    <p class="text-xl text-slate-300 leading-relaxed mb-10 max-w-lg font-medium">
                        Ob Business-Seminar am Vormittag oder private Feier am Abend. 
                        Die Brücke bietet dir Platz, Technik und zentrale Lage in Graz.
                    </p>
                    
                    <div class="flex flex-wrap gap-4">
                        <a href="#details" class="px-10 py-5 bg-white text-slate-900 rounded-full font-bold hover:bg-rose-500 hover:text-white transition-all shadow-xl text-lg transform hover:-translate-y-1">
                            Ausstattung ansehen
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* --- EQUIPMENT GRID --- */}
    <section class="px-4 sm:px-6 -mt-10 relative z-20 pb-24">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {equipment.map(item => (
                    <div class="tech-card bg-white dark:bg-slate-900 p-6 md:p-8 rounded-[32px] shadow-xl border border-slate-100 dark:border-slate-800 text-center hover:-translate-y-1 transition-transform duration-300 group">
                        <div class="w-14 h-14 mx-auto bg-slate-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center text-rose-600 mb-4 group-hover:scale-110 transition-transform">
                            <i class={`fa-solid ${item.icon} text-2xl`}></i>
                        </div>
                        <h3 class="font-bold text-slate-900 dark:text-white mb-2 text-lg">{item.label}</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wide">{item.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    {/* --- USE CASES --- */}
    <section id="details" class="px-4 sm:px-6 pb-24">
        <div class="max-w-7xl mx-auto space-y-32">
            {useCases.map((useCase, idx) => (
                <div class={`flex flex-col md:flex-row gap-16 items-center ${idx % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
                    
                    <div class="flex-1 w-full">
                        <div class="relative aspect-[4/3] rounded-[48px] overflow-hidden shadow-2xl group border border-slate-100 dark:border-slate-800">
                            <Image 
                                src={useCase.image}
                                alt={useCase.title}
                                width={1200}  
                                height={900}  
                                format="webp"
                                quality={90}  
                                densities={[1.5, 2]} 
                                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-[1.5s]"
                            />
                            <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition"></div>
                        </div>
                    </div>

                    <div class="flex-1 space-y-8">
                        <div class="inline-block px-4 py-2 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-rose-600 dark:text-rose-400 font-bold text-xs uppercase tracking-widest">
                            {useCase.subtitle}
                        </div>
                        
                        <div>
                            <h2 class="text-4xl md:text-5xl font-display font-bold text-slate-900 dark:text-white leading-tight mb-6">
                                {useCase.title}
                            </h2>
                            <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed font-medium">
                                {useCase.desc}
                            </p>
                        </div>

                        <ul class="space-y-4 pt-2">
                            {useCase.features.map(feat => (
                                <li class="flex items-center gap-4 text-slate-700 dark:text-slate-300 font-medium">
                                    <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm shrink-0">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                    {feat}
                                </li>
                            ))}
                        </ul>

                        <div class="pt-4">
                            <a href="mailto:office@diebruecke.cc?subject=Anfrage%20Raummiete" class="inline-flex items-center gap-3 text-slate-900 dark:text-white font-bold hover:text-rose-600 dark:hover:text-rose-400 transition-colors uppercase tracking-widest text-sm group">
                                Verfügbarkeit anfragen 
                                <span class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center group-hover:bg-slate-100 dark:group-hover:bg-slate-800 transition-colors">
                                    <i class="fa-solid fa-arrow-right group-hover:translate-x-0.5 transition-transform"></i>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>

    {/* --- BILDERGALERIE (DIRECTUS) --- */}
    {pageSettings?.gallery && pageSettings.gallery.length > 0 && (
        <section class="px-4 sm:px-6 pb-24">
            <div class="max-w-7xl mx-auto">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-display font-bold text-slate-900 dark:text-white">
                        Eindrücke aus der Location
                    </h2>
                </div>
                
                {/* Masonry-Style Grid */}
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[200px] md:auto-rows-[250px]">
                    {pageSettings.gallery.map((item: any, index: number) => {
                        const fileId = item.directus_files_id || item; 
                        if (!fileId || typeof fileId !== 'string') return null;

                        const isLarge = index === 0 || index === 3;

                        return (
                            <div class={`relative rounded-[32px] overflow-hidden group shadow-lg border border-slate-100 dark:border-slate-800 ${isLarge ? 'col-span-2 row-span-2' : 'col-span-1 row-span-1'}`}>
                                <Image 
                                    src={getImg(fileId, isLarge ? 1200 : 600)}
                                    alt="Impression Eventlocation Die Brücke"
                                    width={isLarge ? 1200 : 600}
                                    height={isLarge ? 1200 : 600}
                                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-[1.5s]"
                                />
                                <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition"></div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </section>
    )}

    {/* --- LOCATION & DOWNLOADS --- */}
    <section class="px-4 sm:px-6 pb-24 relative z-10">
        <div class="max-w-7xl mx-auto">
            <div class="grid md:grid-cols-2 gap-12 md:gap-16">
                
                {/* Left: Anfahrt & Erreichbarkeit via Komponente */}
                <LocationCard />

                {/* Right: Downloads & Hard Facts */}
                {/* Right: Downloads & Hard Facts (ZWISCHENLÖSUNG) */}
                <div class="bg-slate-50 dark:bg-slate-800/20 p-8 md:p-10 rounded-[32px] border border-slate-100 dark:border-slate-800 flex flex-col justify-center">
                    <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white mb-2">Details & Planung</h3>
                    <p class="text-slate-500 dark:text-slate-400 mb-8 text-sm">Unsere Info-Mappen mit allen Hard Facts werden aktuell überarbeitet. Wir senden dir die aktuellen Details für deine Planung gerne direkt zu.</p>
                    
                    <div class="p-8 bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 text-center shadow-sm relative overflow-hidden group">
                        {/* Deko-Hintergrund */}
                        <div class="absolute -right-4 -top-4 w-24 h-24 bg-rose-50 dark:bg-rose-500/5 rounded-full blur-xl group-hover:bg-rose-100 dark:group-hover:bg-rose-500/10 transition-colors"></div>

                        <div class="relative z-10">
                            <div class="w-16 h-16 mx-auto bg-slate-50 dark:bg-slate-800 text-slate-400 dark:text-slate-500 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 group-hover:text-rose-500 transition-all duration-300">
                                <i class="fa-regular fa-folder-open text-2xl"></i>
                            </div>
                            
                            <ul class="text-sm text-slate-600 dark:text-slate-400 font-medium mb-6 space-y-2 inline-block text-left">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-rose-500 text-xs"></i> Raumplan & Maße</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-rose-500 text-xs"></i> Technik-Rider</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-rose-500 text-xs"></i> Preise & Konditionen</li>
                            </ul>

                            <a href="mailto:office@diebruecke.cc?subject=Anfrage%20Infomaterial%20Raummiete" class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl font-bold text-sm hover:bg-rose-600 dark:hover:bg-rose-400 dark:hover:text-white transition-all w-full shadow-lg hover:shadow-rose-500/25">
                                <i class="fa-regular fa-envelope"></i> Info-Paket anfragen
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {/* --- DYNAMISCHER CMS CONTENT --- */}
    {pageSettings?.content && (
        <section class="px-4 sm:px-6 pb-24">
            <div class="max-w-4xl mx-auto prose prose-lg prose-slate dark:prose-invert" set:html={pageSettings.content}></div>
        </section>
    )}

    {/* --- CTA BOX --- */}
    <section class="px-4 sm:px-6 pb-24">
        <div class="max-w-7xl mx-auto">
            <div class="p-10 md:p-20 bg-slate-50 dark:bg-slate-900 rounded-[48px] border border-slate-100 dark:border-slate-800 text-center shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-rose-500/10 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>

                <div class="relative z-10 max-w-3xl mx-auto">
                    <h2 class="text-3xl md:text-5xl font-display font-bold text-slate-900 dark:text-white mb-6 tracking-tight">
                        Mach es zu <span class="text-rose-500">deinem Raum.</span>
                    </h2>
                    <p class="text-slate-500 dark:text-slate-400 text-lg mb-12 leading-relaxed">
                        Ob Workshop, Tagung oder Feier: Jede Veranstaltung hat ihren eigenen Rhythmus. Wir sorgen für den passenden Rahmen und helfen dir bei dem, was du wirklich brauchst. 
                        <br class="hidden md:block"/>
                    </p>
                    <a href="mailto:office@diebruecke.cc?subject=Anfrage%20Raummiete" class="bg-rose-600 text-white px-10 py-5 rounded-full font-bold shadow-xl hover:bg-slate-900 dark:hover:bg-white dark:hover:text-slate-900 transition-all transform hover:scale-105 inline-flex items-center gap-3">
                        <i class="fa-regular fa-paper-plane"></i>
                        Schreib uns eine Nachricht
                    </a>
                </div>
            </div>
        </div>
    </section>

    <style is:global>
        html.dark .tech-card {
            background-color: #0f172a !important; 
            border-color: rgba(255,255,255,0.1) !important;
        }
    </style>

</MainLayout>