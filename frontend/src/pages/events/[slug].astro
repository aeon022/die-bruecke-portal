---
import MainLayout from '../../layouts/layout.astro';
import { getEventBySlug, getEvents } from '../../lib/api';
// NEU: Directus Imports für Global Settings
import { directus } from '../../lib/directus';
import { readSingleton } from '@directus/sdk';

import { Image } from 'astro:assets'; 
import { eventDates } from '../../lib/recurrence';
import { cleanHtml } from '../../lib/cleanHtml';
import { seriesStyle } from '../../lib/series';
import SeriesBadge from '../../components/events/SeriesBadge.astro';
import EventMiniCard from '../../components/events/EventMiniCard.astro';

// Video Player Import
import VideoPlayer from '../../components/common/VideoPlayer.astro';
import GutscheinHinweis from '../../components/common/GutscheinHinweis.astro';

const { slug } = Astro.params;

// URL Parameter prüfen
const urlDateParam = Astro.url.searchParams.get('date');

// --- DATEN LADEN (PARALLEL) ---
// Wir laden Event, Alle Events UND Global Settings gleichzeitig
const [event, allEvents, globalSettings] = await Promise.all([
    getEventBySlug(slug as string),
    getEvents(),
    directus.request(readSingleton('global_settings')).catch(() => null) // Fehlertolerant
]);

if (!event) {
  return Astro.redirect('/404');
}

// --- ASSET URL ---
const ASSET_URL = 'https://api.diebruecke.social/assets';

// --- HERO IMAGE LOGIK ---
const heroImage = event.hero_image || event.image;

// --- PRETIX HELPERS ---
const normalizeInt = (val: any): number | null => {
  if (val === null || val === undefined) return null;
  if (typeof val === 'number' && !isNaN(val)) return val;
  const parsed = parseInt(String(val), 10);
  return isNaN(parsed) ? null : parsed;
};

// Pretix Daten aus Directus (Fallbacks)
const pretixLink =
  event.pretix_link ||
  (event.pretix_slug ? 'https://pretix.eu/diebruecke/' + event.pretix_slug + '/' : null);

const ticketsLeft = normalizeInt(event.tickets_left);

// Ticket CTA Fallback
const ticketUrl = pretixLink || '/contact';
const ticketTarget = pretixLink ? '_blank' : undefined;
const ticketRel = pretixLink ? 'noopener noreferrer' : undefined;

// Optional: sold out
const isSoldOut = ticketsLeft !== null && ticketsLeft <= 0;

// --- WIEDERHOLUNGS-LOGIK (RRule) ---
const dbStartDate = new Date(event.start_date);
const dbEndDate = event.end_date ? new Date(event.end_date) : null;
const duration = dbEndDate
  ? dbEndDate.getTime() - dbStartDate.getTime()
  : 2 * 60 * 60 * 1000;

const allDates: Date[] = eventDates(event);

// --- ANZEIGE DATUM ---
const now = new Date();
let displayDate = dbStartDate;

if (urlDateParam) {
  const parsed = new Date(urlDateParam);
  if (!isNaN(parsed.getTime())) {
    parsed.setHours(dbStartDate.getHours(), dbStartDate.getMinutes());
    displayDate = parsed;
  }
} else {
  const nextUpcoming = allDates.find((d) => d >= now);
  if (nextUpcoming) {
    displayDate = nextUpcoming;
  } else {
    displayDate = allDates[allDates.length - 1];
  }
}

const displayEndDate = new Date(displayDate.getTime() + duration);

// --- SEO CONFIG ---
// Datum im Titel: wiederkehrende Events (z. B. Mord vor Ort) haben sonst identische Titel
const seoTitle = `${event.title} am ${displayDate.toLocaleDateString("de-AT", { day: "2-digit", month: "2-digit", year: "numeric" })} | Die Brücke Graz`;
const rawDesc = event.subtitle || event.description || "Veranstaltung im soziokulturellen Zentrum Die Brücke Graz.";
const seoDescription = rawDesc.replace(/<[^>]*>/g, '').substring(0, 160).trim() + "...";
const seoImage = heroImage ? `${ASSET_URL}/${heroImage}` : "/social-fallback.jpg";

// --- FORMATIERUNG ---
const dateString = displayDate.toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const timeString = displayDate.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
// Zeiten laut Büro/AGENTS.md (08.11.2026): Vereinsbuffet 60 Min. vor Beginn, Saal 30 Min.;
// Open Air (Murwärts): Grillen & Chillen ab 19:00. Ziel: Leute früher ins Haus holen.
const hhmm = (min: number) => new Date(displayDate.getTime() - min * 60000).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
const saalMin = 30; // immer 30 Min. (AGENTS.md, Korrektur 26.10.2026), auch Iris hört zu
const einlassText = event.series?.slug === 'murwaerts-festival'
  ? 'Grillen & Chillen ab 19:00 · bei Schlechtwetter im Saal'
  : `Einstimmen am Vereinsbuffet ab ${hhmm(Math.max(60, saalMin))} · Saal ab ${hhmm(saalMin)}`;
const weekday = displayDate.toLocaleDateString('de-DE', { weekday: 'long' });

// Zuerst Termine derselben Serie, dann die nächsten anderen
const others = allEvents.filter((e: any) => e.id !== event.id);
const sameSeries = event.series?.slug ? others.filter((e: any) => e.series?.slug === event.series.slug) : [];
const relatedEvents = [...sameSeries, ...others.filter((e: any) => !sameSeries.includes(e))].slice(0, 3);
const relatedTitle = sameSeries.length ? `Mehr aus ${event.series.name}` : 'Das könnte dich auch interessieren';

// Preis für Google (schema.org): frei = 0, sonst Normalpreis; unbekannt = weglassen
const schemaPrice = event.is_free_entry ? '0' : event.price_regular != null ? String(event.price_regular) : null;

const eventCategories = event.categories || event.event_categories || [];
const getCatName = (cat: any) => cat.event_categories_id?.name || cat.event_categories_id?.title || 'Event';

const formatGCalDate = (date: Date) => date.toISOString().replace(/-|:|\.\d\d\d/g, '');

const gCalUrl =
  'https://www.google.com/calendar/render?action=TEMPLATE' +
  '&text=' +
  encodeURIComponent(event.title) +
  '&dates=' +
  formatGCalDate(displayDate) +
  '/' +
  formatGCalDate(displayEndDate) +
  '&details=' +
  encodeURIComponent('Infos: https://diebruecke.cc/events/' + slug) +
  '&location=' +
  encodeURIComponent(event.location || 'Die Brücke, Grabenstraße 39a, Graz') +
  '&sf=true&output=xml';

// .ics für Apple-Kalender und Outlook (gleiche Zeiten wie der Google-Link, also auch für Serientermine richtig)
// shortcut: als data-URL statt eigener Route; reicht für einen Termin, eigene /events/[slug].ics erst bei Abo-Kalender
const icsEscape = (t: string) => String(t || '').replace(/[\\;,]/g, (m) => '\\' + m).replace(/\r?\n/g, '\\n');
const icsText = [
  'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Die Bruecke Graz//Events//DE', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
  'BEGIN:VEVENT',
  `UID:${slug}-${formatGCalDate(displayDate)}@diebruecke.social`,
  `DTSTAMP:${formatGCalDate(new Date())}`,
  `DTSTART:${formatGCalDate(displayDate)}`,
  `DTEND:${formatGCalDate(displayEndDate)}`,
  `SUMMARY:${icsEscape(event.title)}`,
  `LOCATION:${icsEscape(/grabenstra/i.test(event.location || '') ? event.location : [event.location || 'Die Brücke', 'Grabenstraße 39a, 8010 Graz'].join(', '))}`,
  `URL:https://diebruecke.social/events/${slug}`,
  `DESCRIPTION:${icsEscape('Infos und Tickets: https://diebruecke.social/events/' + slug)}`,
  'END:VEVENT', 'END:VCALENDAR',
].join('\r\n');
const icsUrl = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(icsText);
const icsName = `${slug}.ics`;

const currentUrl = 'https://diebruecke.social/events/' + slug;
// Ort: Standard „Die Brücke“ (Feld enthält meist nur das); Adresse und Route immer darunter
const placeName = event.location && !/br(ü|ue)cke|grabenstra/i.test(event.location) ? event.location : 'Die Brücke';
const routeUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent('Die Brücke, Grabenstraße 39a, 8010 Graz');
// Einfache Sprache: eigenes Feld in Directus (description_leicht)
const leichtText = cleanHtml(event.description_leicht);
const shareText = encodeURIComponent('Event-Tipp: ' + event.title);

const shareWhatsApp = 'https://wa.me/?text=' + shareText + '%20' + encodeURIComponent(currentUrl);
const shareFacebook = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(currentUrl);
const shareX = 'https://twitter.com/intent/tweet?text=' + shareText + '&url=' + encodeURIComponent(currentUrl);
const shareLinkedIn = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(currentUrl);
const shareMail = 'mailto:?subject=' + encodeURIComponent(event.title + ' – Die Brücke') + '&body=' + encodeURIComponent(`${event.title}\n${weekday}, ${dateString}, ${timeString} Uhr\n${currentUrl}`);
---

<MainLayout title={seoTitle} description={seoDescription} image={seoImage} leicht={Boolean(leichtText)}>
  
  {/* --- HERO SECTION --- */}
  <section class="relative h-[50vh] lg:h-[70vh] min-h-[400px] overflow-hidden bg-slate-900 group" aria-hidden="true">
    
    {/* 1. Blur Hintergrund (Performance: tiny thumbnail) */}
    {heroImage && (
      <div class="absolute inset-0 opacity-40 blur-3xl scale-110 pointer-events-none">
        <Image 
            src={`${ASSET_URL}/${heroImage}`} 
            width={100} 
            height={60} 
            class="w-full h-full object-cover" 
            alt="" 
            fetchpriority="low"
        />
      </div>
    )}

    {/* 2. Main Hero Image (Performance: Eager & Priority) */}
    {heroImage ? (
      <Image
        src={`${ASSET_URL}/${heroImage}`}
        alt={event.title}
        width={1600}
        height={900}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover relative z-10 transition-transform duration-[3s] group-hover:scale-105"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center z-10">
        <i class="fa-regular fa-image text-8xl text-white/20"></i>
      </div>
    )}
    
    <div class="absolute inset-0 bg-gradient-to-t from-slate-50 via-slate-50/10 to-transparent dark:from-slate-950 dark:via-slate-900/40 z-20"></div>
  </section>

  {/* MAIN CONTENT AREA */}
  <article class="relative z-30 -mt-24 sm:-mt-32 px-4 sm:px-6 md:px-10 pb-32 lg:pb-24">
    <div class="max-w-7xl mx-auto">
      <div class="bg-white dark:bg-slate-900 rounded-[40px] shadow-2xl shadow-slate-200/50 dark:shadow-black/50 border border-slate-100 dark:border-slate-800 overflow-visible transition-colors duration-300">
        
        <div class="grid lg:grid-cols-12 gap-0 items-start relative">
          
          {/* LINKER CONTENT BLOCK */}
          <div class="lg:col-span-8 p-8 md:p-14 min-h-[50vh]">
            
            <header>
                <div class="mb-6 no-print">
                  <a
                    href="/events"
                    class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-rose-500 transition-colors group"
                  >
                    <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
                    Zurück zur Übersicht
                  </a>
                </div>

                <div class="flex flex-wrap gap-3 mb-8 no-print">
                  <SeriesBadge series={event.series} link size="md" />
                  {eventCategories?.map((cat: any) => (
                    <span class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                      {getCatName(cat)}
                    </span>
                  ))}
                  {allDates.length > 1 && (
                    <span class="bg-rose-50 dark:bg-rose-900/20 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-900/30 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                      <i class="fa-solid fa-repeat mr-1"></i> Mehrere Termine
                    </span>
                  )}
                </div>

                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-slate-900 dark:text-white tracking-tighter leading-[1.1] mb-8 break-words hyphens-auto">
                  {event.title}
                </h1>
                
                {/* Semantische Meta-Daten */}
                <div class="flex flex-col gap-2 mb-10 text-slate-500 dark:text-slate-400 font-medium no-screen-only">
                   <p class="flex items-center gap-2">
                     <i class="fa-regular fa-calendar text-rose-500 no-print"></i>
                     <span>{weekday}, {dateString} um {timeString} Uhr</span>
                   </p>
                   <p class="flex items-center gap-2">
                     <i class="fa-solid fa-location-dot text-rose-500 no-print"></i>
                     <span>{event.location || 'Die Brücke, Graz'}</span>
                   </p>
                </div>
            </header>

            {leichtText && (
              <div class="show-on-ll einfach-event mb-8 p-6 rounded-3xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800">
                <p class="text-xs font-bold uppercase tracking-widest text-amber-800 dark:text-amber-200 mb-3">In einfacher Sprache</p>
                <div class="text-xl leading-relaxed text-slate-900 dark:text-slate-100 space-y-4" set:html={leichtText}></div>
              </div>
            )}
            <div
              class:list={["prose prose-lg prose-slate dark:prose-invert max-w-none font-medium leading-relaxed text-slate-600 dark:text-slate-300 prose-headings:font-display prose-headings:font-bold prose-a:text-rose-600 hover:prose-a:text-rose-700", { 'hide-on-ll': leichtText }]}
              set:html={cleanHtml(event.description)}
            ></div>

            {event.series?.name && (
                <a href={`/serien/${event.series.slug}`} class="no-print mt-12 flex items-center gap-5 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 hover:shadow-lg transition-shadow group">
                    <span class="shrink-0 w-14 h-14 rounded-2xl flex items-center justify-center font-display font-black text-xl" style={seriesStyle(event.series)} aria-hidden="true">{event.series.name.slice(0, 1)}</span>
                    <span class="flex-1">
                        <span class="block text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Teil der Serie</span>
                        <span class="block font-display font-bold text-xl text-slate-900 dark:text-white group-hover:text-rose-600 transition-colors">{event.series.name}</span>
                        {event.series.description && <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">{event.series.description}</span>}
                    </span>
                    <i class="fa-solid fa-arrow-right text-slate-500 dark:text-slate-400 group-hover:translate-x-1 transition-transform"></i>
                </a>
            )}

            {/* VIDEO PLAYER BEREICH */}
            {event.video_url && (
                <div class="mt-16 pt-8 border-t border-slate-100 dark:border-slate-800">
                    <h3 class="font-display font-black text-2xl md:text-3xl text-slate-900 dark:text-white uppercase mb-6">
                        Event <span class="text-rose-500">Video</span>
                    </h3>
                    <VideoPlayer url={event.video_url} poster={heroImage ? `${ASSET_URL}/${heroImage}` : undefined} />
                </div>
            )}

          </div>

          {/* --- ASIDE: Facts & Tickets & Sticky Logic --- */}
          
          <div id="sidebar-sentinel" class="absolute top-0 right-0 h-32 w-1 pointer-events-none opacity-0"></div>

          <aside 
            id="event-sidebar"
            class="lg:col-span-4 bg-slate-50/80 dark:bg-slate-900/50 backdrop-blur-md border-t lg:border-t-0 lg:border-l border-slate-100 dark:border-slate-800 p-8 md:p-14 w-full rounded-tr-[40px] rounded-br-[40px] no-print transition-all duration-500 ease-out"
          >
            <h3 class="text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-8">Hard Facts</h3>

            <div class="space-y-8 mb-12">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-rose-600 dark:text-rose-400 shadow-sm shrink-0">
                  <i class="fa-regular fa-calendar text-xl"></i>
                </div>
                <div>
                  <span class="block font-bold text-slate-900 dark:text-white text-lg">{weekday}</span>
                  <span class="block text-slate-500 dark:text-slate-400">{dateString}</span>
                  {displayDate.getTime() !== dbStartDate.getTime() && (
                    <span class="text-xs text-rose-500 font-bold uppercase tracking-wide mt-1 block">Wiederkehrender Termin</span>
                  )}
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-rose-600 dark:text-rose-400 shadow-sm shrink-0">
                  <i class="fa-regular fa-clock text-xl"></i>
                </div>
                <div>
                  <span class="block font-bold text-slate-900 dark:text-white text-lg">{timeString} Uhr</span>
                  <span class="block text-slate-500 dark:text-slate-400">{einlassText}</span>
                  <span class="block text-xs font-bold text-rose-600 dark:text-rose-400 mt-1">Freie Platzwahl</span>
                  <span class="block text-xs text-slate-500 dark:text-slate-400 mt-2 leading-snug">Jeder Euro am Vereinsbuffet und jede <a href="/join/mitgliedschaft" class="underline underline-offset-2 hover:text-rose-600">Mitgliedschaft</a> kommt direkt unseren Projekten zugute – sozial wie kulturell.</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-rose-600 dark:text-rose-400 shadow-sm shrink-0">
                  <i class="fa-solid fa-location-dot text-xl"></i>
                </div>
                <div>
                  <span class="block font-bold text-slate-900 dark:text-white text-lg">{placeName}</span>
                  <span class="block text-slate-500 dark:text-slate-400 text-sm mt-1">Grabenstraße 39a, 8010 Graz</span>
                  <span class="flex gap-4 mt-2 text-sm font-bold">
                    <a href={routeUrl} target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 hover:underline underline-offset-4"><i class="fa-solid fa-route mr-1" aria-hidden="true"></i>Route</a>
                    <a href="/contact" class="text-slate-500 dark:text-slate-400 hover:text-rose-600 hover:underline underline-offset-4">Anfahrt & Barrierefreiheit</a>
                  </span>
                </div>
              </div>
            </div>

            {/* --- TICKETS & ACTIONS --- */}
            <div class="space-y-4">
              <a
                href={isSoldOut ? '/contact' : ticketUrl}
                target={isSoldOut ? undefined : ticketTarget}
                rel={isSoldOut ? undefined : ticketRel}
                class:list={[
                  'group relative block w-full text-center font-bold text-lg py-5 rounded-2xl transition-all shadow-xl transform overflow-hidden',
                  pretixLink && !isSoldOut
                    ? 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-rose-600 dark:hover:bg-rose-400 dark:hover:text-white hover:shadow-rose-500/40 hover:-translate-y-1'
                    : 'bg-slate-300 dark:bg-slate-800 text-slate-600 dark:text-slate-300 cursor-not-allowed opacity-80',
                ]}
              >
                <span class="relative z-10 flex items-center justify-center gap-2">
                  <i class="fa-solid fa-ticket"></i>
                  {isSoldOut ? 'Ausverkauft' : pretixLink ? 'Tickets kaufen' : 'Tickets derzeit nicht verfügbar'}
                </span>
                {pretixLink && !isSoldOut && (
                  <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 dark:via-black/10 to-transparent -translate-x-full group-hover:animate-shine"></div>
                )}
              </a>

              {/* Nur bei knappen Karten anzeigen (tickets_left kommt alle 15 Min. aus pretix) */}
              {pretixLink && ticketsLeft !== null && ticketsLeft <= 30 && (
                <div class="flex justify-center">
                  <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-300 border border-rose-100 dark:border-rose-800">
                    {ticketsLeft <= 0 ? 'Keine Tickets mehr verfügbar' : 'Noch ' + ticketsLeft + ' Tickets verfügbar'}
                  </span>
                </div>
              )}

              {pretixLink && !isSoldOut && <GutscheinHinweis />}

              {/* --- NEU: ERMÄßIGUNGEN (GLOBAL SETTINGS) --- */}
              {/* Zeigt die Ermäßigungen nur an, wenn in global_settings 'event_discounts_info' gefüllt ist */}
              {globalSettings?.event_discounts_info && (
                <div class="bg-yellow-50 dark:bg-yellow-900/10 border border-yellow-100 dark:border-yellow-900/30 rounded-xl p-4 mt-4">
                   <div class="flex items-center gap-2 mb-2 text-yellow-800 dark:text-yellow-200 font-bold text-sm uppercase tracking-wider">
                       <i class="fa-solid fa-percent text-yellow-600 dark:text-yellow-400"></i>
                       <span>Ermäßigungen</span>
                   </div>
                   <div 
                      class="prose prose-sm prose-yellow dark:prose-invert leading-snug text-slate-600 dark:text-slate-400"
                      set:html={globalSettings.event_discounts_info}
                   ></div>
                </div>
              )}

              <a
                href={gCalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold py-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors text-sm flex items-center justify-center gap-2"
              >
                <i class="fa-brands fa-google"></i> Google Kalender
              </a>
              <a
                href={icsUrl}
                download={icsName}
                class="mt-2 block w-full text-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold py-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors text-sm flex items-center justify-center gap-2"
              >
                <i class="fa-regular fa-calendar-plus"></i> Apple- oder Outlook-Kalender
              </a>
            </div>

            {/* --- ALLE TERMINE LISTE (Nur wenn Serie) --- */}
            {allDates.length > 1 && (
              <div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-700">
                <h4 class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4">
                  Alle Termine ({allDates.length})
                </h4>
                <div class="space-y-2 max-h-40 overflow-y-auto custom-scrollbar pr-2">
                  {allDates
                    .filter((d) => d >= now || d.getTime() === displayDate.getTime())
                    .slice(0, 10)
                    .map((date) => {
                      const isSelected = date.getTime() === displayDate.getTime();
                      const isoDate = date.toISOString().split('T')[0];

                      return (
                        <a
                          href={'?date=' + isoDate}
                          class:list={[
                            'flex items-center justify-between text-sm p-2 rounded-lg transition-colors',
                            isSelected
                              ? 'bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 font-bold'
                              : 'hover:bg-white dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400',
                          ]}
                        >
                          <span>
                            {date.toLocaleDateString('de-DE', {
                              day: '2-digit',
                              month: '2-digit',
                              year: '2-digit',
                            })}
                          </span>
                          <span>{date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' })}</span>
                        </a>
                      );
                    })}
                </div>
              </div>
            )}

            <div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-700">
              <p class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4 text-center">Freunde einladen</p>
              {/* Am Handy: eingebautes Teilen (WhatsApp, Signal, Instagram-Story …); per JS eingeblendet, wenn verfügbar */}
              <button id="share-native" type="button" class="hidden w-full mb-3 py-3 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-sm flex items-center justify-center gap-2 hover:bg-rose-600 dark:hover:bg-rose-400 transition-colors">
                <i class="fa-solid fa-share-nodes" aria-hidden="true"></i> Teilen …
              </button>
              <div class="grid grid-cols-5 gap-2">
                <a href={shareWhatsApp} target="_blank" rel="noopener noreferrer" class="h-10 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500 hover:text-white transition-all flex items-center justify-center" title="Per WhatsApp teilen" aria-label="Per WhatsApp teilen"><i class="fa-brands fa-whatsapp text-lg"></i></a>
                <a href={shareFacebook} target="_blank" rel="noopener noreferrer" class="h-10 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 hover:bg-blue-600 hover:text-white transition-all flex items-center justify-center" title="Auf Facebook teilen" aria-label="Auf Facebook teilen"><i class="fa-brands fa-facebook-f text-lg"></i></a>
                <a href={shareMail} class="h-10 rounded-lg bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 hover:bg-amber-500 hover:text-white transition-all flex items-center justify-center" title="Per E-Mail teilen" aria-label="Per E-Mail teilen"><i class="fa-regular fa-envelope text-lg"></i></a>
                <a href={shareX} target="_blank" rel="noopener noreferrer" class="h-10 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white hover:bg-black hover:text-white transition-all flex items-center justify-center" title="Auf X teilen" aria-label="Auf X teilen"><i class="fa-brands fa-x-twitter text-lg"></i></a>
                <a href={shareLinkedIn} target="_blank" rel="noopener noreferrer" class="h-10 rounded-lg bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400 hover:bg-sky-700 hover:text-white transition-all flex items-center justify-center" title="Auf LinkedIn teilen" aria-label="Auf LinkedIn teilen"><i class="fa-brands fa-linkedin-in text-lg"></i></a>
              </div>
              <button id="share-copy" type="button" class="mt-3 w-full py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold text-sm flex items-center justify-center gap-2 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                <i class="fa-regular fa-copy" aria-hidden="true"></i><span>Link kopieren (z. B. für Instagram)</span>
              </button>
              <p id="share-status" class="sr-only" aria-live="polite"></p>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </article>

  {/* Handy/Tablet: Datum + Tickets immer erreichbar (Sidebar kommt sonst erst weit unten) */}
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 no-print border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-3 flex items-center gap-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
    <div class="flex-1 min-w-0">
      <span class="block text-sm font-bold text-slate-900 dark:text-white truncate">{weekday}, {dateString}</span>
      <span class="block text-xs text-slate-500 dark:text-slate-400">{timeString} Uhr · Die Brücke</span>
    </div>
    <a href={isSoldOut ? '/contact' : ticketUrl} target={isSoldOut ? undefined : ticketTarget} rel={isSoldOut ? undefined : ticketRel}
      class:list={['shrink-0 inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm', pretixLink && !isSoldOut ? 'bg-rose-600 text-white' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300']}>
      <i class="fa-solid fa-ticket" aria-hidden="true"></i>{isSoldOut ? 'Ausverkauft' : pretixLink ? 'Tickets' : 'Infos'}
    </a>
  </div>

  {/* RELATED EVENTS */}
  {relatedEvents.length > 0 && (
    <section class="px-6 sm:px-10 pb-24 bg-white dark:bg-slate-950 transition-colors no-print" aria-hidden="true">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-12 border-b border-slate-100 dark:border-slate-800 pb-6">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-slate-900 dark:text-white">
            {relatedTitle}
          </h2>
          <a
            href={sameSeries.length ? `/serien/${event.series.slug}` : '/events'}
            class="hidden md:inline-flex items-center gap-2 text-rose-600 font-bold hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            Alles ansehen <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedEvents.map((rel: any) => <EventMiniCard event={rel} />)}
        </div>
      </div>
    </section>
  )}
</MainLayout>

{/* --- SCHEMA.ORG --- */}
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.title,
  "startDate": displayDate.toISOString(),
  "endDate": displayEndDate.toISOString(),
  "location": { "@type": "Place", "name": "Die Brücke Graz", "address": { "@type": "PostalAddress", "streetAddress": "Grabenstraße 39a", "addressLocality": "Graz", "postalCode": "8010", "addressCountry": "AT" } },
  "image": [seoImage],
  "description": seoDescription,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "offers": { "@type": "Offer", "url": pretixLink || currentUrl, ...(schemaPrice !== null && { "price": schemaPrice }), "priceCurrency": "EUR", "availability": isSoldOut ? "https://schema.org/OutOfStock" : "https://schema.org/InStock" },
  ...(event.series?.name && { "superEvent": { "@type": "EventSeries", "name": event.series.name, "url": `https://diebruecke.social/serien/${event.series.slug}` } }),
  "organizer": { "@type": "Organization", "name": "Die Brücke - soziokulturelles Zentrum", "url": "https://diebruecke.cc" }
})} />

<script>
  // Teilen: am Handy das eingebaute Menü, überall „Link kopieren“ mit sichtbarer Bestätigung
  const btnNative = document.getElementById('share-native');
  const btnCopy = document.getElementById('share-copy');
  const status = document.getElementById('share-status');
  if (btnNative && navigator.share) {
    btnNative.classList.remove('hidden');
    btnNative.addEventListener('click', () => navigator.share({ title: document.title, url: location.href }).catch(() => {}));
  }
  if (btnCopy) {
    const label = btnCopy.querySelector('span');
    btnCopy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); } catch { prompt('Link kopieren:', location.href); return; }
      const before = label.textContent;
      label.textContent = 'Link kopiert ✓';
      if (status) status.textContent = 'Link in die Zwischenablage kopiert';
      setTimeout(() => (label.textContent = before), 2500);
    });
  }
  const sidebar = document.getElementById('event-sidebar');
  const sentinel = document.getElementById('sidebar-sentinel');

  // Sticky Sidebar Logic
  if (sidebar && sentinel) {
    new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) sidebar.classList.add('is-stuck');
            else sidebar.classList.remove('is-stuck');
        });
    }, { threshold: 0, rootMargin: "-100px 0px 0px 0px" }).observe(sentinel);
  }
</script>

<style>
  @keyframes shine { 100% { transform: translateX(100%); } }
  .animate-shine { animation: shine 1.5s infinite; }
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
  html.dark .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #475569; }
  .is-stuck { border-top-left-radius: 40px; border-bottom-left-radius: 40px; box-shadow: -5px 0 20px -5px rgba(0,0,0,0.05); border-left: 1px solid rgba(255,255,255,0.1); }
  @media screen { .no-screen-only { display: none; } }
  @media print { .no-print { display: none !important; } }
  /* Platz für die feste Ticket-Leiste am Handy, damit der Footer nicht verdeckt wird */
  @media (max-width: 1023px) { :global(footer) { padding-bottom: 5rem; } }
</style>
