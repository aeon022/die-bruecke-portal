---
import MainLayout from '../layouts/layout.astro';
// Druckvorlage: alles passiert im Browser, nichts wird gespeichert oder gesendet.
---

<MainLayout title="Gutschein drucken" description="Mach aus deinem Brücke-Gutscheincode einen Gutschein zum Ausdrucken und Verschenken.">
  <div class="px-6 pt-32 md:pt-40 pb-24">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-10 items-start">
      <form id="gs-form" class="no-print min-w-0 bg-white dark:bg-slate-900 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-800 space-y-5">
        <div>
          <p class="text-xs font-black uppercase tracking-widest text-rose-600 dark:text-rose-400 mb-2">Druckvorlage</p>
          <h1 class="text-3xl md:text-4xl font-display font-black text-slate-900 dark:text-white">Gutschein zum Ausdrucken</h1>
          <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">Trag den Code aus deiner Bestellbestätigung ein. Nichts davon wird gespeichert oder verschickt – die Seite läuft nur in deinem Browser.</p>
        </div>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Betrag</span>
          <select name="betrag" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white">
            <option value="25">25 €</option><option value="50" selected>50 €</option><option value="100">100 €</option>
          </select></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Gutscheincode</span>
          <input name="code" required autocomplete="off" placeholder="z. B. ABCD1234EFGH" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 font-mono uppercase tracking-widest placeholder:normal-case placeholder:tracking-normal placeholder:font-sans text-slate-900 dark:text-white" /></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Für</span>
          <input name="fuer" maxlength="40" placeholder="Name der beschenkten Person" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white" /></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Von</span>
          <input name="von" maxlength="40" placeholder="Dein Name" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white" /></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Persönliche Nachricht (optional)</span>
          <textarea name="nachricht" maxlength="120" rows="3" placeholder="Für einen Abend mit guter Musik!" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white"></textarea></label>
        <button type="submit" class="w-full inline-flex items-center justify-center gap-3 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-bold py-4 transition-colors"><i class="fa-solid fa-print" aria-hidden="true"></i>Drucken oder als PDF sichern</button>
        <p class="text-xs text-slate-500 dark:text-slate-400">Noch keinen Gutschein? <a href="/shop" class="underline font-bold">Hier kaufen</a></p>
      </form>

      <div class="gs-vorschau min-w-0 lg:sticky lg:top-28">
        <p class="no-print text-sm font-bold text-slate-500 dark:text-slate-400 mb-3">Vorschau</p>
        <article id="gs-karte" class="gs-karte" aria-live="polite">
          <div class="gs-links">
            <p class="gs-kicker">Die Brücke · Graz</p>
            <p class="gs-titel">Gutschein</p>
            <p class="gs-betrag"><span data-out="betrag">50</span><small>€</small></p>
            <p class="gs-unter">für einen Abend in der Brücke</p>
          </div>
          <div class="gs-rechts">
            <p class="gs-label">Für</p><p class="gs-name" data-out="fuer">…</p>
            <p class="gs-label">Von</p><p class="gs-name" data-out="von">…</p>
            <p class="gs-nachricht" data-out="nachricht"></p>
            <p class="gs-label">Code</p><p class="gs-code" data-out="code">XXXX XXXX XXXX</p>
            <p class="gs-info">Einlösbar für alle Veranstaltungen – online auf diebruecke.social (Zahlungsart „Gutschein“) oder an der Abendkasse. Ohne Ablaufdatum.<br/>Grabenstraße 39a · 8010 Graz</p>
          </div>
        </article>
      </div>
    </div>
  </div>

  <style is:inline id="gs-css">
    .gs-karte { container-type:inline-size; display:grid; grid-template-columns: 1fr 1.15fr; aspect-ratio: 210/99; width:100%; border-radius:20px; overflow:hidden; background:#fff; color:#0f172a; font-family:'Avenir Next','Inter','Helvetica Neue',Arial,sans-serif; -webkit-print-color-adjust:exact; print-color-adjust:exact; box-sizing:border-box; }
    .gs-karte * { box-sizing:border-box; margin:0; }
    .gs-links { position:relative; overflow:hidden; padding:4.5cqw 4cqw; background:linear-gradient(135deg,#f97316 0%,#e11d48 55%,#9f1239 100%); color:#fff; display:flex; flex-direction:column; justify-content:space-between; border-right:.35cqw dashed rgba(255,255,255,.65); }
    .gs-links::after { content:''; position:absolute; right:-14cqw; top:-14cqw; width:30cqw; height:30cqw; border-radius:50%; background:rgba(255,255,255,.12); }
    .gs-kicker { font-size:1.4cqw; font-weight:900; letter-spacing:.25em; text-transform:uppercase; opacity:.9; }
    .gs-titel { font-size:3.4cqw; font-weight:900; text-transform:uppercase; letter-spacing:-.01em; margin-top:1cqw; }
    .gs-betrag { font-size:12cqw; font-weight:900; line-height:.9; letter-spacing:-.04em; white-space:nowrap; }
    .gs-betrag small { font-size:.45em; vertical-align:top; margin-left:.08em; }
    .gs-unter { font-size:1.7cqw; font-weight:700; }
    .gs-rechts { padding:4cqw 4.5cqw; display:flex; flex-direction:column; justify-content:center; min-width:0; }
    .gs-label { font-size:1.3cqw; font-weight:900; letter-spacing:.2em; text-transform:uppercase; color:#e11d48; margin-top:1.3cqw; }
    .gs-label:first-child { margin-top:0; }
    .gs-name { font-size:2.7cqw; font-weight:800; border-bottom:.12cqw solid #cbd5e1; padding-bottom:.3cqw; min-height:3.4cqw; overflow-wrap:anywhere; }
    .gs-nachricht { font-size:1.8cqw; font-style:italic; color:#475569; margin-top:1.3cqw; overflow-wrap:anywhere; }
    .gs-nachricht:empty { display:none; }
    .gs-code { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:2.6cqw; font-weight:800; letter-spacing:.12em; background:#f1f5f9; border-radius:.8cqw; padding:.5cqw 1cqw; align-self:flex-start; margin-top:.4cqw; white-space:nowrap; }
    .gs-info { font-size:1.4cqw; color:#64748b; margin-top:1.6cqw; line-height:1.45; }
  </style>
  <style>
    .gs-vorschau .gs-karte { box-shadow:0 30px 60px -20px rgba(225,29,72,.35); }
    @media (max-width: 640px) {
      .gs-vorschau .gs-karte { grid-template-columns:1fr; aspect-ratio:auto; }
      .gs-vorschau .gs-links { border-right:0; border-bottom:.8cqw dashed rgba(255,255,255,.65); gap:4cqw; }
      .gs-vorschau .gs-kicker{font-size:2.6cqw} .gs-vorschau .gs-titel{font-size:6cqw} .gs-vorschau .gs-betrag{font-size:20cqw} .gs-vorschau .gs-unter{font-size:3.4cqw}
      .gs-vorschau .gs-label{font-size:2.4cqw;margin-top:3cqw} .gs-vorschau .gs-name{font-size:5cqw;min-height:7cqw} .gs-vorschau .gs-nachricht{font-size:3.4cqw} .gs-vorschau .gs-code{font-size:5cqw} .gs-vorschau .gs-info{font-size:3.1cqw}
    }
  </style>

  <script>
    const form = document.getElementById('gs-form') as HTMLFormElement;
    const karte = document.getElementById('gs-karte') as HTMLElement;
    const out = (k: string) => karte.querySelector(`[data-out="${k}"]`) as HTMLElement;
    const fmt = (c: string) => c.toUpperCase().replace(/[^A-Z0-9]/g, '').replace(/(.{4})(?=.)/g, '$1 ');
    const render = () => {
      const d = new FormData(form);
      out('betrag').textContent = String(d.get('betrag'));
      out('fuer').textContent = String(d.get('fuer') || '…');
      out('von').textContent = String(d.get('von') || '…');
      out('nachricht').textContent = String(d.get('nachricht') || '');
      out('code').textContent = fmt(String(d.get('code') || '')) || 'XXXX XXXX XXXX';
    };

    // Druck in einem eigenen, unsichtbaren Dokument: nur die Karte, ohne Header/Footer der Seite.
    const drucke = () => {
      const css = document.getElementById('gs-css')?.textContent ?? '';
      const frame = document.createElement('iframe');
      frame.setAttribute('aria-hidden', 'true');
      frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
      document.body.appendChild(frame);
      const doc = frame.contentDocument!;
      doc.open();
      doc.write(`<!doctype html><html lang="de"><head><meta charset="utf-8"><title>Brücke-Gutschein</title><style>${css}
        @page { size: A4 landscape; margin: 12mm; }
        html,body { margin:0; background:#fff; }
        .gs-karte { width:273mm; border:0.3mm solid #e2e8f0; border-radius:5mm; }
      </style></head><body>${karte.outerHTML}</body></html>`);
      doc.close();
      const los = () => {
        frame.contentWindow!.focus();
        frame.contentWindow!.print();
        setTimeout(() => frame.remove(), 1000);
      };
      (doc.fonts?.ready ?? Promise.resolve()).then(() => setTimeout(los, 50));
    };

    form.addEventListener('input', render);
    form.addEventListener('submit', (e) => { e.preventDefault(); if (!form.reportValidity()) return; render(); drucke(); });
    render();
  </script>
</MainLayout>
