---
import MainLayout from '../layouts/layout.astro';
// Druckvorlage: alles passiert im Browser, nichts wird gespeichert oder gesendet.
---

<MainLayout title="Gutschein drucken" description="Mach aus deinem Brücke-Gutscheincode einen Gutschein zum Ausdrucken und Verschenken.">
  <div class="px-6 pt-32 md:pt-40 pb-24">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.3fr] gap-10 items-start">
      <form id="gs-form" class="no-print bg-white dark:bg-slate-900 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-800 space-y-5">
        <div>
          <p class="text-xs font-black uppercase tracking-widest text-rose-600 dark:text-rose-400 mb-2">Druckvorlage</p>
          <h1 class="text-3xl md:text-4xl font-display font-black text-slate-900 dark:text-white">Gutschein zum Ausdrucken</h1>
          <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">Trag den Code aus deiner Bestellbestätigung ein. Nichts davon wird gespeichert oder verschickt – die Seite läuft nur in deinem Browser.</p>
        </div>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Betrag</span>
          <select name="betrag" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white">
            <option value="25">25 €</option><option value="50" selected>50 €</option><option value="100">100 €</option>
          </select></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Gutscheincode</span>
          <input name="code" required autocomplete="off" placeholder="z. B. ABCD1234EFGH" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 font-mono uppercase tracking-widest text-slate-900 dark:text-white" /></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Für</span>
          <input name="fuer" maxlength="40" placeholder="Name der beschenkten Person" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white" /></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Von</span>
          <input name="von" maxlength="40" placeholder="Dein Name" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white" /></label>
        <label class="block"><span class="text-sm font-bold text-slate-900 dark:text-white">Persönliche Nachricht (optional)</span>
          <textarea name="nachricht" maxlength="160" rows="3" placeholder="Für einen Abend mit guter Musik!" class="mt-1 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent px-4 py-3 text-slate-900 dark:text-white"></textarea></label>
        <button type="submit" class="w-full inline-flex items-center justify-center gap-3 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-bold py-4 transition-colors"><i class="fa-solid fa-print" aria-hidden="true"></i>Drucken oder als PDF sichern</button>
        <p class="text-xs text-slate-500 dark:text-slate-400">Noch keinen Gutschein? <a href="/shop" class="underline font-bold">Hier kaufen</a></p>
      </form>

      <div>
        <p class="no-print text-sm font-bold text-slate-500 dark:text-slate-400 mb-3">Vorschau</p>
        <article id="gs-karte" class="gs-karte" aria-live="polite">
          <div class="gs-links">
            <p class="gs-kicker">Die Brücke · Graz</p>
            <p class="gs-titel">Gutschein</p>
            <p class="gs-betrag"><span data-out="betrag">50</span><small>€</small></p>
            <p class="gs-unter">für einen Abend in der Brücke</p>
          </div>
          <div class="gs-rechts">
            <p class="gs-label">Für</p><p class="gs-name" data-out="fuer">…</p>
            <p class="gs-label">Von</p><p class="gs-name" data-out="von">…</p>
            <p class="gs-nachricht" data-out="nachricht"></p>
            <p class="gs-label">Code</p><p class="gs-code" data-out="code">XXXX XXXX XXXX</p>
            <p class="gs-info">Einlösbar für alle Veranstaltungen – online auf diebruecke.social (Zahlungsart „Gutschein“) oder an der Abendkasse. Ohne Ablaufdatum.<br/>Grabenstraße 39a · 8010 Graz</p>
          </div>
        </article>
      </div>
    </div>
  </div>

  <style>
    .gs-karte { display:grid; grid-template-columns: 1fr 1.15fr; aspect-ratio: 210/99; width:100%; border-radius:24px; overflow:hidden; box-shadow:0 30px 60px -20px rgba(225,29,72,.35); background:#fff; color:#0f172a; font-family: inherit; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .gs-links { position:relative; padding:6% 7%; background: linear-gradient(135deg,#f97316 0%,#e11d48 55%,#9f1239 100%); color:#fff; display:flex; flex-direction:column; justify-content:space-between; border-right: 3px dashed rgba(255,255,255,.6); }
    .gs-links::after { content:''; position:absolute; right:-30%; top:-30%; width:80%; aspect-ratio:1; border-radius:50%; background:rgba(255,255,255,.12); }
    .gs-kicker { font-size: clamp(8px,1.1vw,12px); font-weight:900; letter-spacing:.25em; text-transform:uppercase; opacity:.85; }
    .gs-titel { font-size: clamp(16px,2.6vw,30px); font-weight:900; text-transform:uppercase; letter-spacing:-.02em; }
    .gs-betrag { font-size: clamp(48px,9vw,110px); font-weight:900; line-height:.9; letter-spacing:-.04em; }
    .gs-betrag small { font-size:.45em; vertical-align:top; margin-left:.1em; }
    .gs-unter { font-size: clamp(10px,1.3vw,15px); font-weight:700; }
    .gs-rechts { padding:6% 7%; display:flex; flex-direction:column; justify-content:center; gap:.15em; }
    .gs-label { font-size: clamp(7px,.9vw,10px); font-weight:900; letter-spacing:.2em; text-transform:uppercase; color:#e11d48; margin-top:.6em; }
    .gs-name { font-size: clamp(13px,1.9vw,22px); font-weight:800; border-bottom:1px solid #e2e8f0; padding-bottom:.15em; min-height:1.3em; }
    .gs-nachricht { font-size: clamp(10px,1.3vw,15px); font-style:italic; color:#475569; margin-top:.5em; min-height:0; }
    .gs-code { font-family: ui-monospace, Menlo, monospace; font-size: clamp(13px,2vw,24px); font-weight:800; letter-spacing:.15em; background:#f1f5f9; border-radius:8px; padding:.25em .5em; display:inline-block; }
    .gs-info { font-size: clamp(7px,.9vw,10px); color:#64748b; margin-top:1em; line-height:1.5; }
    @media (max-width: 640px) { .gs-karte { grid-template-columns:1fr; aspect-ratio:auto; } .gs-links { border-right:0; border-bottom:3px dashed rgba(255,255,255,.6); } }
    @media print {
      @page { size: A4 landscape; margin: 15mm; }
      body * { visibility: hidden; }
      #gs-karte, #gs-karte * { visibility: visible; }
      #gs-karte { position: fixed; left: 0; top: 0; width: 267mm; box-shadow:none; border:1px solid #e2e8f0; }
      .gs-kicker{font-size:11pt} .gs-titel{font-size:26pt} .gs-betrag{font-size:96pt} .gs-unter{font-size:13pt}
      .gs-label{font-size:9pt} .gs-name{font-size:20pt} .gs-nachricht{font-size:13pt} .gs-code{font-size:22pt} .gs-info{font-size:9pt}
    }
  </style>

  <script>
    const form = document.getElementById('gs-form') as HTMLFormElement;
    const out = (k: string) => document.querySelector(`[data-out="${k}"]`) as HTMLElement;
    const fmt = (c: string) => c.toUpperCase().replace(/[^A-Z0-9]/g, '').replace(/(.{4})(?=.)/g, '$1 ');
    const render = () => {
      const d = new FormData(form);
      out('betrag').textContent = String(d.get('betrag'));
      out('fuer').textContent = String(d.get('fuer') || '…');
      out('von').textContent = String(d.get('von') || '…');
      out('nachricht').textContent = String(d.get('nachricht') || '');
      out('code').textContent = fmt(String(d.get('code') || '')) || 'XXXX XXXX XXXX';
    };
    form.addEventListener('input', render);
    form.addEventListener('submit', (e) => { e.preventDefault(); render(); window.print(); });
    render();
  </script>
</MainLayout>
