---
export const prerender = false;

import MainLayout from '../layouts/layout.astro';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

// 1. Team-Daten aus Directus holen
let team = [];
try {
    team = await directus.request(readItems('team', {
        filter: { status: { _eq: 'published' } },
        sort: ['sort'] 
    }));
} catch (error) {
    console.error("Fehler beim Laden des Teams:", error);
}

const boardMembers = team.filter(m => m.type === 'board');
const leadership = team.filter(m => m.type === 'operative');
const ASSET_URL = "https://api.diebruecke.social/assets";

const history = [
    { year: "1983", title: "Die Geburtsstunde", desc: "Gegründet als 'Kommunikationszentrum für Menschen mit und ohne Behinderung'. Waltraud Klasnic und Partner legen den Grundstein für Österreichs erstes inklusives Haus." },
    { year: "1988", title: "Kultur als Brücke", desc: "Die Brücke etabliert sich als Grazer Top-Adresse für akustische Musik und Kleinkunst. Inklusion wird durch gemeinsame Kulturerlebnisse lebendig." },
    { year: "1992", title: "Das Infozentrum", desc: "Eröffnung des Informationszentrums für Behindertenfragen. Wir werden zur zentralen Anlaufstelle für unbürokratische Hilfe in der Steiermark." },
    { year: "2004", title: "Anerkannter Träger", desc: "Ein Meilenstein: Das Land Steiermark erkennt uns als Träger für mobile Dienste an (FASS, WASS, FED)." },
    { year: "2007", title: "Neuer Glanz", desc: "Nach umfassender Renovierung und Zubau erstrahlt die Brücke barrierefrei und modern – bereit für die nächsten Jahrzehnte." },
    { year: "Heute", title: "42 Jahre Pionierarbeit", desc: "Vom Visionär zum Fels in der Brandung. Mit Urlaubsaktionen, mobilen Diensten und über 300 Events pro Jahr sind wir Graz' Herz für Inklusion." }
];

// --- SEO KONFIGURATION ---
const seoTitle = "Über uns | Die Brücke Graz";
const seoDescription = "Ein Haus voller Kultur, Begleitung und echter Begegnungen. Seit über 42 Jahren sind wir der Ort in Graz, an dem Autonomie und Gemeinschaft keine Widersprüche sind.";
const seoImage = "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?q=80&w=1200"; 
---

<MainLayout 
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
>
    
    <div class="home-content">
        {/* --- HERO --- */}
        <section class="px-2 sm:px-6 pt-4 pb-6 transition-colors duration-500">
            <div class="relative bg-white dark:bg-slate-900 rounded-[48px] overflow-hidden px-4 md:px-12 lg:px-16 py-24 md:py-32 shadow-2xl shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-800">
                
                {/* Background Pattern */}
                <div class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.05]">
                    <svg class="w-full h-full" width="100%" height="100%">
                        <pattern id="archive-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <circle cx="2" cy="2" r="1" fill="currentColor" />
                        </pattern>
                        <rect width="100%" height="100%" fill="url(#archive-grid)" />
                    </svg>
                </div>

                <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-rose-500/5 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>

                <div class="max-w-7xl mx-auto relative z-10">
                    <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-[10px] font-black text-rose-500 uppercase tracking-[0.2em] mb-12 shadow-sm">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                        </span>
                        Seit 1983
                    </div>
                    
                    <div class="max-w-7xl">
                        {/* HERO: Final State */}
                        <h1 class="font-display font-black text-slate-900 dark:text-white tracking-tighter leading-none mb-12 w-full max-w-full">
                            <span class="block md:hidden drop-shadow-sm w-full">
                                <span class="block text-[11vw] font-black leading-[0.85] tracking-tighter break-words">
                                    Unabhängigkeit
                                </span>
                                <span class="block text-4xl font-black text-slate-900 dark:text-white leading-[0.9] my-1 pl-1">
                                    ist keine
                                </span>
                                <span class="block text-[11vw] font-black leading-[0.85] tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-indigo-600 pb-2 pr-2 break-words">
                                    Einzelleistung.
                                </span>
                            </span>
                            <span class="hidden md:block text-[clamp(3rem,7.5vw,9rem)] leading-[0.95] -ml-1 w-full">
                                <span class="block">Unabhängigkeit ist</span>
                                <span class="block text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-indigo-600 pb-4 pr-6">keine Einzelleistung.</span>
                            </span>
                        </h1>
                    </div>

                    <div class="w-full h-px bg-slate-100 dark:bg-slate-800 my-16"></div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
                        <div class="max-w-2xl">
                            <h2 class="text-3xl font-bold text-slate-900 dark:text-white leading-tight tracking-tight mb-8" style="text-wrap: balance;">
                                Wir sind die Brücke in deine Unabhängigkeit.
                            </h2>
                            <p class="text-xl text-slate-500 dark:text-slate-400 leading-relaxed font-medium">
                                {seoDescription}
                            </p>
                        </div>

                        <div class="flex flex-col justify-between items-start lg:items-end text-left lg:text-right">
                            <div class="space-y-8">
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-rose-500 mb-2 block">Die Adresse</span>
                                    <p class="text-lg font-bold text-slate-900 dark:text-white break-words">
                                        Grabenstraße 39a <br/> 8010 Graz, Österreich
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                {/* WATERMARK */}
                <div class="absolute right-0 top-1/2 -translate-y-1/2 hidden 2xl:block opacity-[0.03] dark:opacity-[0.06] pointer-events-none select-none">
                    <span class="text-[10rem] font-black uppercase origin-center rotate-90 inline-block whitespace-nowrap tracking-widest text-slate-900 dark:text-white">VEREIN</span>
                </div>
            </div>
        </section>  
            
        {/* --- WERTE GRID --- */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-left p-6 mb-12">
            {[
                { 
                    title: "Menschlichkeit", 
                    icon: "fa-heart", 
                    accent: "border-rose-500/20",
                    iconBg: "bg-rose-500",
                    text: "Wir verwalten keine Akten, wir begleiten Menschen. Unbürokratisch, herzlich und immer auf Augenhöhe. Seit 1983 ist echtes Miteinander unser Fundament." 
                },
                { 
                    title: "Selbstbestimmung", 
                    icon: "fa-wind", 
                    accent: "border-slate-200",
                    iconBg: "bg-slate-900",
                    text: "Dein Weg. Unser Rückenwind. Wir bevormunden nicht, wir unterstützen dich professionell dabei, dein Leben nach deinen eigenen Regeln zu gestalten." 
                },
                { 
                    title: "Kultur & Begegnung", 
                    icon: "fa-masks-theater", 
                    accent: "border-slate-200",
                    iconBg: "bg-rose-600",
                    text: "Ein Haus voller Leben. Wir schaffen den Raum in Graz, in dem Kunst und Kultur Barrieren einfach verschwinden lassen. Mittendrin statt nur dabei." 
                }
            ].map(card => (
                <div 
                    class="group flip-card h-[420px] [perspective:1000px]" 
                    onclick="this.classList.toggle('is-flipped')"
                >
                    <div class="relative h-full w-full rounded-[48px] transition-all duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-[.is-flipped]:[transform:rotateY(180deg)] cursor-pointer shadow-sm hover:shadow-2xl hover:shadow-rose-500/5">
                        
                        {/* Front */}
                        <div class="absolute inset-0 h-full w-full rounded-[48px] bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex flex-col items-center justify-center p-12 [backface-visibility:hidden]">
                            <div class={`w-20 h-20 ${card.iconBg} text-white rounded-[28px] flex items-center justify-center text-3xl mb-8 shadow-lg group-hover:scale-110 transition-transform duration-500`}>
                                <i class={`fa-solid ${card.icon}`}></i>
                            </div>
                            <h3 class="text-2xl font-display font-black text-slate-900 dark:text-white uppercase tracking-tight">{card.title}</h3>
                            <div class="mt-8 flex items-center gap-2 text-rose-500 font-black text-[10px] uppercase tracking-[0.2em] opacity-50 group-hover:opacity-100 transition-opacity">
                                <span>Details</span>
                                <i class="fa-solid fa-chevron-right text-[8px]"></i>
                            </div>
                        </div>

                        {/* Back */}
                        <div class="absolute inset-0 h-full w-full rounded-[48px] bg-slate-900 dark:bg-slate-800 p-12 text-white [transform:rotateY(180deg)] [backface-visibility:hidden] flex flex-col items-center justify-center text-center border border-slate-800">
                            <h3 class="text-xl font-display font-black mb-6 uppercase tracking-tight text-rose-500">{card.title}</h3>
                            <p class="text-slate-300 leading-relaxed font-medium text-lg">
                                {card.text}
                            </p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        {/* --- TIMELINE --- */}
        <section class="px-6 sm:px-10 py-32 bg-slate-50 dark:bg-slate-900 relative overflow-hidden transition-colors duration-500">
            <div class="max-w-4xl mx-auto relative">
                <div class="text-center mb-24">
                    <span class="text-rose-500 font-bold tracking-widest uppercase text-xs mb-4 block underline decoration-rose-500 decoration-2 underline-offset-8">Unsere Geschichte</span>
                    <h2 class="text-4xl md:text-6xl font-display font-bold text-slate-900 dark:text-white tracking-tighter">Vom Visionär <br>zum Fels in der Brandung.</h2>
                </div>
                
                <div class="relative" id="timelineContainer">
                    <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 -translate-x-1/2"></div>
                    <div id="timelineProgress" class="absolute left-6 md:left-1/2 top-0 w-1 bg-rose-600 -translate-x-1/2 transition-all duration-100 ease-out shadow-[0_0_15px_rgba(225,29,72,0.6)]" style="height: 0%;"></div>
                    
                    <div class="space-y-16 md:space-y-32 relative z-10 pt-10">
                        {history.map((item, idx) => (
                            <div class={`relative flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-16 timeline-item opacity-20 transition-all duration-700 transform translate-y-8 ${idx % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                                <div class={`flex-1 pl-12 md:pl-0 ${idx % 2 === 0 ? 'md:text-right' : 'md:text-left'} text-left w-full`}>
                                    <span class="text-[clamp(3.5rem,5vw,6rem)] font-display font-black text-slate-200 dark:text-slate-800/50 block mb-2 transition-colors leading-none tracking-tighter">{item.year}</span>
                                    <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3 mt-[-0.5rem] relative z-10">{item.title}</h3>
                                    <p class="text-slate-500 dark:text-slate-400 leading-relaxed font-medium text-sm md:text-base">{item.desc}</p>
                                </div>
                                <div class="absolute left-6 md:left-1/2 top-14 md:top-1/2 w-4 h-4 rounded-full bg-white dark:bg-slate-950 border-[3px] border-slate-300 dark:border-slate-700 -translate-x-1/2 -translate-y-1/2 transition-all duration-500 z-20 group-[.active]:border-rose-500 group-[.active]:scale-125 shadow-sm"></div>
                                <div class="flex-1 hidden md:block"></div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        {/* --- STATS --- */}
        <section class="px-6 sm:px-10 py-24 md:py-32 bg-slate-900 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-full md:w-1/2 h-full bg-rose-600/5 skew-x-12 translate-x-1/4 pointer-events-none"></div>

            <div class="max-w-7xl mx-auto relative z-10 text-left">
                <div class="grid lg:grid-cols-2 gap-12 md:gap-20 items-center">
                    <div class="max-w-2xl">
                        <h2 class="text-5xl md:text-7xl font-display font-black mb-8 tracking-tighter uppercase leading-[0.9]">
                            42 Jahre <br><span class="text-rose-500 italic text-4xl md:text-7xl">Eigensinn & Mut.</span>
                        </h2>
                        <p class="text-lg md:text-xl text-slate-400 leading-relaxed max-w-xl font-medium">
                            Wir verwalten keine Fälle, wir gestalten Lebensräume. Die Brücke ist der Beweis, dass Inklusion dann am besten funktioniert, wenn man sie gemeinsam feiert – auf der Bühne und im echten Leben.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
                        <div class="bg-white/5 p-6 sm:p-8 lg:p-10 rounded-[32px] md:rounded-[40px] border border-white/10 group hover:border-rose-500/50 transition-all">
                            <span class="block text-[clamp(2rem,8vw,3rem)] font-display font-black text-white mb-1 leading-none group-hover:scale-105 transition-transform origin-left uppercase">Echt</span>
                            <span class="text-[10px] font-bold uppercase text-rose-500 tracking-widest block mb-4 italic">Seit der ersten Stunde</span>
                            <p class="text-slate-400 text-sm font-medium leading-snug">Über 40 Jahre Graz. Über 40 Jahre Brüche im System und echte Begegnungen auf Augenhöhe.</p>
                        </div>
                        <div class="bg-white/5 p-6 sm:p-8 lg:p-10 rounded-[32px] md:rounded-[40px] border border-white/10 group hover:border-white/30 transition-all">
                            <span class="block text-[clamp(2.5rem,10vw,4rem)] font-display font-black text-white mb-1 leading-none group-hover:scale-105 transition-transform origin-left">80+</span>
                            <span class="text-[10px] font-bold uppercase text-slate-400 tracking-widest block mb-4 italic">Kultur-Momente</span>
                            <p class="text-slate-400 text-sm font-medium leading-snug">Von SofaKino bis StageDIVE. Jedes Jahr schaffen wir Räume, in denen Unterschiede keine Rolle spielen.</p>
                        </div>
                        <div class="bg-rose-600 p-6 sm:p-8 lg:p-10 rounded-[32px] md:rounded-[40px] shadow-2xl col-span-1 sm:col-span-2 flex flex-col sm:flex-row items-start sm:items-center gap-6 group hover:scale-[1.01] transition-transform">
                            <div class="text-6xl md:text-7xl font-display font-black text-white shrink-0 leading-none">5x</div>
                            <div class="text-left">
                                <span class="text-[10px] font-bold uppercase text-rose-200 block mb-2 tracking-widest italic">Wöchentlicher Rückenwind</span>
                                <p class="text-white font-bold text-lg leading-tight">So oft sind wir im Schnitt mit der Freizeitassistenz in Graz unterwegs. Wir liefern den Support für deinen eigenen Weg.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* --- DAS MANIFEST --- */}
        <section class="px-4 sm:px-10 py-24 bg-white dark:bg-slate-950 transition-colors duration-500">
            <div class="max-w-6xl mx-auto">
                <div class="flex items-center gap-6 mb-16">
                    <div class="h-[1px] w-12 bg-rose-500"></div>
                    <span class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400">Das Manifest</span>
                </div>

                <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-end mb-24">
                    <div class="lg:col-span-8 min-w-0">
                        <div class="block md:hidden text-left drop-shadow-sm w-full overflow-hidden">
                            <span class="block text-[14vw] font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-[0.8] mb-1">
                                Haltung
                            </span>
                            <span class="block text-4xl font-black text-slate-900 dark:text-white leading-none mb-1 pl-1">
                                ist bei uns
                            </span>
                            {/* FIX: pr-12 auf pr-2 reduziert für Mobile, damit es nicht den Rahmen sprengt */}
                            <span class="block whitespace-nowrap text-transparent bg-clip-text bg-gradient-to-r from-rose-500 via-fuchsia-600 to-indigo-600 italic font-black text-[11vw] leading-[0.85] pb-2 pr-2 sm:pr-12">
                                kein Standard.
                            </span>
                        </div>
                        <h2 class="hidden md:block font-display font-black text-slate-900 dark:text-white tracking-tighter leading-[1.1] uppercase text-[clamp(2rem,5.5vw,6rem)]">
                            <span class="block whitespace-nowrap">Haltung ist bei uns</span>
                            <span class="block whitespace-nowrap text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-indigo-600 italic pb-2 pr-6">kein Standard.</span>
                        </h2>
                    </div>
                    {/* FIX: min-w-0 verhindert Grid-Blowout auf kleinen Screens */}
                    <div class="lg:col-span-4 min-w-0">
                        {/* FIX: pl-4 statt pl-6 für Mobile, break-words für Sicherheit */}
                        <p class="text-slate-500 dark:text-slate-400 font-medium leading-relaxed border-l border-slate-100 dark:border-slate-800 pl-4 md:pl-6 text-sm break-words hyphens-auto">
                            Wir haben Barrieren in den Köpfen eingerissen, lange bevor Inklusion zum Modewort wurde. Wir sind stolz auf unsere Geschichte, aber bleiben hungrig auf Veränderung.
                        </p>
                    </div>
                </div>

                <div class="grid md:grid-cols-3 gap-12 lg:gap-16 border-t border-slate-50 dark:border-slate-900 pt-16 mb-20">
                    <div class="space-y-4">
                        <span class="text-rose-500 font-mono text-[10px]">01 —</span>
                        <h3 class="text-xl font-display font-black text-slate-900 dark:text-white uppercase tracking-tight">Pioniere mit Schmäh</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                            Was man heute schick „Inklusion“ nennt, war bei uns von Anfang an Standard: Der Mensch in seiner ganzen bunten Vielfalt steht im Mittelpunkt.
                        </p>
                    </div>
                    <div class="space-y-4">
                        <span class="text-rose-500 font-mono text-[10px]">02 —</span>
                        <h3 class="text-xl font-display font-black text-slate-900 dark:text-white uppercase tracking-tight">Kunst zum Angreifen</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                            Künstlerischer Anspruch und soziale Verantwortung sind bei uns wie Gitarre und Verstärker: Unzertrennlich. Wir betreuen nicht nur – wir ermöglichen.
                        </p>
                    </div>
                    <div class="space-y-4">
                        <span class="text-rose-500 font-mono text-[10px]">03 —</span>
                        <h3 class="text-xl font-display font-black text-slate-900 dark:text-white uppercase tracking-tight">Von Mensch zu Mensch</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                            Wir bieten Freiraum ohne Bürokratie. Wir bleiben der Ort, an dem Inklusion kein kompliziertes Konzept ist, sondern ein Zuhause hat.
                        </p>
                    </div>
                </div>

                <div class="flex justify-start">
                    <a 
                        href="/Leitbild-2026.pdf" 
                        target="_blank"
                        class="group inline-flex items-center gap-4 px-8 py-4 bg-slate-50 dark:bg-slate-900 hover:bg-rose-500 transition-all duration-500 rounded-full border border-slate-100 dark:border-slate-800 hover:border-rose-500 shadow-sm w-full sm:w-auto justify-center sm:justify-start"
                    >
                        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-900 dark:text-white group-hover:text-white">Das ganze Leitbild lesen</span>
                        <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-800 flex items-center justify-center group-hover:translate-x-2 transition-transform shadow-sm flex-shrink-0">
                            <i class="fa-solid fa-arrow-down-long text-xs text-rose-500"></i>
                        </div>
                    </a>
                </div>
            </div>
        </section>

{/* --- NEU: BUFFET / UNVERZICHTBARER HILFSBETRIEB --- */}
        <section class="mt-20 px-6 sm:px-10 pb-32">
            <div class="max-w-5xl mx-auto">
                {/* Dezent: Warmes Orange/Amber (Sandfarben), sehr hell, wirkt gemütlich/warm (Kaffee-Vibe) */}
                <div class="relative bg-gradient-to-br from-amber-80 via-white to-amber-50 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 rounded-[40px] p-10 md:p-16 border border-orange-100 dark:border-slate-700 shadow-xl overflow-hidden text-center md:text-left group hover:shadow-2xl hover:shadow-orange-500/5 transition-all duration-500">
                    
                    {/* Deco Icon */}
                    <div class="absolute -top-10 -right-10 text-[15rem] text-orange-500/5 rotate-12 pointer-events-none">
                        <i class="fa-solid fa-mug-hot"></i>
                    </div>

                    <div class="relative z-10 grid md:grid-cols-[1fr_auto] gap-10 items-center">
                        <div>
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 dark:bg-orange-900/20 text-orange-700 dark:text-orange-400 text-xs font-bold uppercase tracking-widest mb-6">
                                <i class="fa-solid fa-heart"></i>
                                Unverzichtbarer Hilfsbetrieb
                            </div>
                            
                            <h2 class="text-3xl md:text-5xl font-display font-black text-slate-900 dark:text-white mb-6 leading-tight">
                                Das <span class="text-orange-600 dark:text-orange-500">Wohnzimmer.</span>
                            </h2>
                            
                            <p class="text-lg text-slate-600 dark:text-slate-300 mb-8 leading-relaxed font-medium">
                                Unser Buffet ist mehr als nur Kaffee und Kuchen. Es ist der soziale Kitt unseres Hauses. Hier gilt eine eiserne Regel: <strong class="text-slate-900 dark:text-white">Kein Konsumzwang.</strong> Du darfst hier sitzen, solange du willst, Menschen treffen oder einfach nur da sein – auch wenn du nur ein Glas Leitungswasser trinkst.
                            </p>

                            <div class="flex flex-wrap gap-4 justify-center md:justify-start">
                                <a href="/info" class="px-8 py-4 bg-white text-slate-900 border-2 border-orange-100 dark:bg-slate-800 dark:text-white dark:border-slate-700 rounded-full font-bold hover:border-orange-500 dark:hover:border-orange-500 hover:text-orange-600 dark:hover:text-orange-400 transition-all shadow-sm inline-flex items-center gap-2">
                                    Mehr Infos & Öffnungszeiten <i class="fa-solid fa-arrow-right text-xs"></i>
                                </a>
                            </div>
                        </div>

                        <div class="hidden md:flex justify-center">
                            <div class="w-32 h-32 rounded-full bg-white dark:bg-slate-800 text-orange-500 flex items-center justify-center text-5xl shadow-2xl shadow-orange-500/10 rotate-3 group-hover:-rotate-3 transition-transform duration-700 border border-orange-50 dark:border-slate-700">
                                <i class="fa-solid fa-utensils"></i>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        {/* --- TEAM SECTION --- */}
