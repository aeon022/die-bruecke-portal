---
export const prerender = false;

import MainLayout from '../layouts/layout.astro';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

// 1. Team-Daten aus Directus holen
let team = [];
try {
    team = await directus.request(readItems('team', {
        filter: { status: { _eq: 'published' } },
        sort: ['sort'] 
    }));
} catch (error) {
    console.error("Fehler beim Laden des Teams:", error);
}

const boardMembers = team.filter(m => m.type === 'board');
const leadership = team.filter(m => m.type === 'operative');
const ASSET_URL = "https://api.diebruecke.social/assets";

const history = [
    { year: "1983", title: "Die Geburtsstunde", desc: "Gegründet als 'Kommunikationszentrum für Menschen mit und ohne Behinderung'. Waltraud Klasnic und Partner legen den Grundstein für Österreichs erstes inklusives Haus." },
    { year: "1988", title: "Kultur als Brücke", desc: "Die Brücke etabliert sich als Grazer Top-Adresse für akustische Musik und Kleinkunst. Inklusion wird durch gemeinsame Kulturerlebnisse lebendig." },
    { year: "1992", title: "Das Infozentrum", desc: "Eröffnung des Informationszentrums für Behindertenfragen. Wir werden zur zentralen Anlaufstelle für unbürokratische Hilfe in der Steiermark." },
    { year: "2004", title: "Anerkannter Träger", desc: "Ein Meilenstein: Das Land Steiermark erkennt uns als Träger für mobile Dienste an (FASS, WASS, FED)." },
    { year: "2007", title: "Neuer Glanz", desc: "Nach umfassender Renovierung und Zubau erstrahlt die Brücke barrierefrei und modern – bereit für die nächsten Jahrzehnte." },
    { year: "Heute", title: "42 Jahre Pionierarbeit", desc: "Vom Visionär zum Fels in der Brandung. Mit Urlaubsaktionen, mobilen Diensten und über 300 Events pro Jahr sind wir Graz' Herz für Inklusion." }
];
---

<MainLayout title="Über uns | Die Brücke">
    
    <div class="home-content">
        {/* --- ARCHIVE HERO --- */}
        <section class="relative px-6 sm:px-10 pt-40 pb-32 bg-white dark:bg-slate-950 overflow-hidden transition-colors duration-500">
            <div class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.07]">
                <svg class="w-full h-full" width="100%" height="100%">
                    <pattern id="archive-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="2" cy="2" r="1" fill="currentColor" />
                    </pattern>
                    <rect width="100%" height="100%" fill="url(#archive-grid)" />
                </svg>
            </div>

            <div class="max-w-7xl mx-auto relative z-10">
                <div class="flex items-center gap-6 mb-16">
                    <div class="h-[2px] w-12 bg-rose-500"></div>
                    <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-slate-400 dark:text-slate-500">Seit 1983</span>
                </div>
                
                <div class="grid lg:grid-cols-12 gap-4 items-start">
                    <div class="lg:col-span-11 xl:col-span-10">
                        <h1 class="text-6xl md:text-8xl lg:text-[10rem] font-display font-black text-slate-900 dark:text-white tracking-tighter leading-[0.8] mb-12">
                            Unabhängigkeit. <br/>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-indigo-600 pr-4">Ist keine</span> <br/>
                            Einzelleistung.
                        </h1>
                    </div>
                </div>

                <div class="w-full h-px bg-slate-100 dark:bg-slate-800 my-16"></div>

                <div class="grid md:grid-cols-12 gap-12 lg:gap-24">
                    <div class="md:col-span-7 lg:col-span-6">
                        <h2 class="text-3xl font-bold text-slate-900 dark:text-white leading-tight tracking-tight mb-8">
                            Wir sind die Brücke in deine Unabhängigkeit.
                        </h2>
                        <p class="text-xl text-slate-500 dark:text-slate-400 leading-relaxed font-medium">
                            Ein Haus voller Kultur, Begleitung und echter Begegnungen. Seit über 42 Jahren sind wir der Ort in Graz, an dem Autonomie und Gemeinschaft keine Widersprüche sind. Wir verwalten keine Fälle, wir gestalten Lebensräume – radikal menschlich, einfach echt.
                        </p>
                    </div>

                    <div class="md:col-span-5 lg:col-span-6 flex flex-col justify-between items-start md:items-end text-left md:text-right">
                        <div class="space-y-8">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-rose-500 mb-2 block">Die Adresse</span>
                                <p class="text-lg font-bold text-slate-900 dark:text-white">Grabenstraße 39a <br/> 8010 Graz, Österreich</p>
                            </div>
                            <div class="inline-flex items-center gap-4 px-6 py-4 bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl rotate-2 hover:rotate-0 transition-transform duration-500 shadow-sm">
                                <span class="text-2xl">☕</span>
                                <p class="text-[11px] font-bold text-slate-600 dark:text-slate-400 leading-tight uppercase tracking-tight text-left">
                                    Enthält keine Spuren von Mitleid. <br/>
                                    <span class="text-slate-900 dark:text-white">Nur echtes Leben.</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="absolute right-[-5%] top-1/2 -translate-y-1/2 hidden 2xl:block opacity-[0.02] dark:opacity-[0.05] pointer-events-none select-none">
                <span class="text-[18rem] font-black uppercase origin-center rotate-90 inline-block whitespace-nowrap tracking-widest text-slate-900 dark:text-white">VEREIN</span>
            </div>
        </section>
            
        {/* --- WERTE --- */}
        <section class="px-6 sm:px-10 py-32 bg-white dark:bg-slate-950 transition-colors duration-500">
            <div class="max-w-7xl mx-auto text-center">
                <h2 class="text-4xl md:text-6xl font-display font-extrabold text-slate-900 dark:text-white tracking-tighter mb-20">
                    Worauf wir <span class="text-rose-600">bauen.</span>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
                    {[
                        { title: "Menschlichkeit", icon: "fa-heart", color: "bg-rose-500", text: "Wir sehen dich. Immer auf Augenhöhe. Seit 1983 ist Empathie unser wichtigstes Werkzeug." },
                        { title: "Selbstbestimmung", icon: "fa-hand-fist", color: "bg-indigo-600", text: "Dein Weg. Unser Backup. Wir bevormunden nicht, wir begleiten professionell." },
                        { title: "Kultur & Begegnung", icon: "fa-music", color: "bg-lime-500", text: "Kunst zum Anfassen. Wir schaffen den Raum, in dem Unterschiede verschwinden." }
                    ].map(card => (
                        <div class="group h-[400px] [perspective:1000px]">
                            <div class="relative h-full w-full rounded-[48px] shadow-xl transition-all duration-500 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] cursor-pointer">
                                <div class="absolute inset-0 h-full w-full rounded-[48px] bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex flex-col items-center justify-center p-10 [backface-visibility:hidden]">
                                    <div class={`w-20 h-20 ${card.color} text-white rounded-3xl flex items-center justify-center text-3xl mb-6 shadow-lg`}>
                                        <i class={`fa-solid ${card.icon}`}></i>
                                    </div>
                                    <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white">{card.title}</h3>
                                    <p class="text-slate-400 dark:text-slate-500 mt-4 font-bold uppercase text-[10px] tracking-widest">Mehr erfahren</p>
                                </div>
                                <div class="absolute inset-0 h-full w-full rounded-[48px] bg-slate-900 dark:bg-slate-800 border border-slate-800 dark:border-slate-700 p-10 text-white [transform:rotateY(180deg)] [backface-visibility:hidden] flex flex-col items-center justify-center text-center">
                                    <h3 class="text-2xl font-display font-bold mb-4">{card.title}</h3>
                                    <p class="text-slate-300 leading-relaxed font-medium">{card.text}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* --- TIMELINE --- */}
        <section class="px-6 sm:px-10 py-32 bg-slate-50 dark:bg-slate-900 relative overflow-hidden transition-colors duration-500">
            <div class="max-w-4xl mx-auto relative">
                <div class="text-center mb-24">
                    <span class="text-rose-500 font-bold tracking-widest uppercase text-xs mb-4 block underline decoration-rose-500 decoration-2 underline-offset-8">Unsere Geschichte</span>
                    <h2 class="text-4xl md:text-6xl font-display font-bold text-slate-900 dark:text-white tracking-tighter">Vom Visionär <br>zum Fels in der Brandung.</h2>
                </div>
                <div class="relative pl-8 md:pl-0" id="timelineContainer">
                    <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 -translate-x-1/2"></div>
                    <div id="timelineProgress" class="absolute left-8 md:left-1/2 top-0 w-1 bg-rose-600 -translate-x-1/2 transition-all duration-100 ease-out" style="height: 0%;"></div>
                    
                    <div class="space-y-24 md:space-y-40 relative z-10">
                        {history.map((item, idx) => (
                            <div class={`flex flex-col md:flex-row items-center gap-8 md:gap-16 timeline-item opacity-20 transition-all duration-700 transform translate-y-8 ${idx % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                                <div class={`flex-1 ${idx % 2 === 0 ? 'md:text-right' : 'md:text-left'} text-left`}>
                                    <span class="text-7xl font-display font-black text-slate-200 dark:text-slate-800 block mb-2 transition-colors">{item.year}</span>
                                    <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">{item.title}</h3>
                                    <p class="text-slate-500 dark:text-slate-400 leading-relaxed font-medium">{item.desc}</p>
                                </div>
                                <div class="absolute left-8 md:left-1/2 w-5 h-5 rounded-full bg-white dark:bg-slate-950 border-4 border-rose-600 -translate-x-1/2 shadow-[0_0_0_8px_rgba(255,255,255,1)] dark:shadow-[0_0_0_8px_rgba(15,23,42,1)] transition-colors"></div>
                                <div class="flex-1 hidden md:block"></div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        {/* --- STATS --- */}
        <section class="px-6 sm:px-10 py-32 bg-slate-900 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-rose-600/5 skew-x-12 translate-x-1/4"></div>
            <div class="max-w-7xl mx-auto relative z-10">
                <div class="grid lg:grid-cols-2 gap-20 items-center">
                    <div>
                        <h2 class="text-5xl md:text-7xl font-display font-black mb-8 tracking-tighter">
                            42 Jahre <br><span class="text-rose-500">Eigensinn & Mut.</span>
                        </h2>
                        <p class="text-xl text-slate-400 leading-relaxed mb-10 max-w-xl">
                            Wir sind kein Standard-Dienstleister. Wir sind eine Gemeinschaft, die zeigt, dass Inklusion dann am besten funktioniert, wenn man sie gemeinsam feiert – auf der Bühne genauso wie im echten Leben.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="bg-white/5 p-10 rounded-[40px] border border-white/10 group hover:border-rose-500/50 transition-all">
                            <span class="block text-5xl font-display font-black text-white mb-2 group-hover:scale-110 transition-transform">Unzählige</span>
                            <span class="text-[11px] font-bold uppercase text-rose-500 underline decoration-rose-500/30 underline-offset-4 tracking-widest">Brückenbauer:innen</span>
                            <p class="text-slate-400 text-sm mt-4 font-medium leading-relaxed">Menschen, die seit 1983 in der Grabenstraße Barrieren einreißen.</p>
                        </div>
                        <div class="bg-white/5 p-10 rounded-[40px] border border-white/10 group hover:border-indigo-500/50 transition-all">
                            <span class="block text-6xl font-display font-black text-white mb-2 group-hover:scale-110 transition-transform">80</span>
                            <span class="text-[11px] font-bold uppercase text-indigo-400 tracking-widest">Kultur-Highlights</span>
                            <p class="text-slate-400 text-sm mt-4 font-medium leading-relaxed">Konzerte, Impro, Kabarett und mehr – jedes Jahr live bei uns.</p>
                        </div>
                        <div class="bg-rose-600 p-10 rounded-[40px] shadow-2xl col-span-1 sm:col-span-2 flex flex-col md:flex-row items-center gap-8 group hover:scale-[1.02] transition-transform">
                            <div class="text-6xl font-display font-black text-white">5x</div>
                            <div class="text-center md:text-left">
                                <span class="text-[11px] font-bold uppercase text-rose-200 block mb-1 tracking-widest">Wöchentliche Action</span>
                                <p class="text-white font-bold text-lg leading-tight">So oft sind wir im Schnitt mit der Freizeitassistenz unterwegs. Graz ist unser Spielplatz.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* --- TEAM SECTION --- */}
        <section class="px-6 sm:px-10 py-32 bg-white dark:bg-slate-950 transition-colors duration-500">
            <div class="max-w-7xl mx-auto">
                <div class="mb-24">
                    <span class="text-rose-500 font-bold tracking-widest uppercase text-xs mb-4 block underline decoration-rose-500 decoration-2 underline-offset-8">Struktur & Köpfe</span>
                    <h2 class="text-4xl md:text-6xl font-display font-extrabold text-slate-900 dark:text-white tracking-tighter leading-tight text-reveal">
                        Menschen mit <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 via-indigo-500 to-indigo-600">
                            Haltung & Herz.
                        </span>
                    </h2>
                </div>

                {/* Vorstand */}
                <div class="mb-32">
                    <div class="flex items-center gap-6 mb-12">
                        <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white shrink-0">Der Vorstand</h3>
                        <div class="h-px bg-slate-100 dark:bg-slate-800 flex-1 transition-colors"></div>
                        <span class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.2em]">Strategische Führung</span>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
                        {boardMembers.map(member => (
                            <div class="group">
                                <div class="aspect-square rounded-[32px] overflow-hidden bg-slate-100 dark:bg-slate-900 mb-4 border border-slate-200 dark:border-slate-800 shadow-sm group-hover:shadow-xl transition-all duration-500 flex items-center justify-center relative">
                                    {member.image ? (
                                        <img src={`${ASSET_URL}/${member.image}?key=system-medium-cover`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt={member.name} />
                                    ) : (
                                        <span class="text-2xl font-display font-black text-slate-300 dark:text-slate-700 group-hover:text-rose-500 transition-colors uppercase">
                                            {member.name.split(' ').map(n => n[0]).join('')}
                                        </span>
                                    )}
                                </div>
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white leading-tight mb-1">{member.name}</h4>
                                <p class="text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-tighter leading-none">{member.role}</p>
                            </div>
                        ))}
                    </div>
                </div>

                {/* Operatives Team */}
                <div>
                    <div class="flex items-center gap-6 mb-12">
                        <h3 class="text-2xl font-display font-bold text-slate-900 dark:text-white shrink-0">Das Team</h3>
                        <div class="h-px bg-slate-100 dark:bg-slate-800 flex-1 transition-colors"></div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-10">
                        {leadership.map(member => (
                            <div class="group text-center">
                                <div class="relative w-32 h-32 md:w-40 md:h-40 mx-auto mb-6">
                                    <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-rose-500 to-indigo-600 animate-spin-slow opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                                    <div class="absolute inset-1 rounded-full overflow-hidden border-4 border-white dark:border-slate-800 bg-slate-50 dark:bg-slate-900 flex items-center justify-center relative transition-colors">
                                        {member.image ? (
                                            <img src={`${ASSET_URL}/${member.image}?key=system-medium-cover`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt={member.name} />
                                        ) : (
                                            <span class="text-3xl font-display font-black text-slate-200 dark:text-slate-700 group-hover:text-slate-400 transition-colors uppercase">
                                                {member.name.split(' ').map(n => n[0]).join('')}
                                            </span>
                                        )}
                                    </div>
                                </div>
                                <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-1 leading-tight">{member.name}</h4>
                                <p class="text-slate-500 dark:text-slate-500 text-[10px] font-bold uppercase tracking-widest">{member.role}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        {/* --- JOIN US --- */}
        <section class="px-6 sm:px-10 py-24 bg-white dark:bg-slate-950 transition-colors duration-500">
            <div class="max-w-7xl mx-auto">
                <a href="/join" class="group relative bg-indigo-600 rounded-[48px] p-10 md:p-14 overflow-hidden flex flex-col lg:flex-row items-center justify-between gap-10 shadow-xl hover:shadow-indigo-200 dark:hover:shadow-none transition-all duration-500">
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.1),transparent)] pointer-events-none"></div>
                    <div class="relative z-10 flex flex-col lg:flex-row items-center gap-10 text-center lg:text-left">
                        <div class="w-20 h-20 rounded-3xl bg-white/10 flex items-center justify-center text-white text-3xl border border-white/20 group-hover:rotate-6 transition-transform">
                            <i class="fa-solid fa-rocket"></i>
                        </div>
                        <div>
                            <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-3 tracking-tight">Werde ein Brückenpfeiler.</h2>
                            <p class="text-indigo-100 max-w-xl font-medium text-lg leading-relaxed">
                                Inklusion braucht Menschen, die mit anpacken. Ob Ehrenamt, Praktikum oder Zivildienst – dein Engagement stärkt unser gemeinsames Fundament.
                            </p>
                        </div>
                    </div>
                    <div class="relative z-10 shrink-0">
                        <span class="px-10 py-5 bg-white text-indigo-600 rounded-full font-bold group-hover:bg-slate-900 group-hover:text-white transition-all inline-flex items-center gap-3 shadow-lg">
                            Mitmachen & Bewegen <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>
        </section>

        {/* --- FINAL STATEMENT --- */}
        <section class="px-6 sm:px-10 py-40 bg-white dark:bg-slate-950 text-center overflow-hidden transition-colors duration-500">
            <div class="max-w-4xl mx-auto">
                <div class="reveal-blur space-y-8">
                    <span class="text-rose-500 font-display font-black text-8xl opacity-20 block leading-none select-none">”</span>
                    <h3 class="text-4xl md:text-6xl font-display font-black text-slate-900 dark:text-white tracking-tighter leading-tight">
                        Inklusion ist fertig, wenn wir aufhören, <br/>
                        <span class="italic text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-indigo-600">darüber zu reden.</span>
                    </h3>
                    <p class="text-slate-400 dark:text-slate-500 font-bold uppercase tracking-[0.4em] text-xs pt-8">
                        Bis dahin sind wir hier.
                    </p>
                </div>
            </div>
        </section>

        {/* --- EXIT SECTION --- */}
        <section class="bg-white dark:bg-slate-950 pb-32 text-center transition-colors duration-500">
            <div class="max-w-4xl mx-auto px-6">
                <div class="flex flex-col items-center">
                    <div class="w-2 h-2 rounded-full bg-rose-500 mb-2"></div>
                    <div class="w-0.5 h-24 bg-gradient-to-b from-rose-500 via-slate-200 dark:via-slate-800 to-transparent"></div>
                </div>
            </div>
        </section>
    </div>
</MainLayout>

<style>
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 8s linear infinite;
    }

    .reveal-blur {
        filter: blur(20px);
        opacity: 0;
        transform: translateY(30px);
        transition: all 1.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal-blur.active {
        filter: blur(0);
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    function initAnimations() {
        // --- TIMELINE LOGIC ---
        const container = document.getElementById('timelineContainer');
        const fillLine = document.getElementById('timelineProgress');
        const items = document.querySelectorAll('.timeline-item');
        
        if (container && fillLine) {
            const handleScroll = () => {
                const rect = container.getBoundingClientRect();
                const viewportHeight = window.innerHeight;
                let progress = (viewportHeight / 2 - rect.top) / rect.height;
                progress = Math.max(0, Math.min(1, progress));
                fillLine.style.height = `${progress * 100}%`;
                
                items.forEach((item) => {
                    const itemRect = item.getBoundingClientRect();
                    if (itemRect.top < viewportHeight * 0.75) {
                        item.classList.remove('opacity-20', 'translate-y-8');
                        item.classList.add('opacity-100', 'translate-y-0');
                    } else {
                        item.classList.remove('opacity-100', 'translate-y-0');
                        item.classList.add('opacity-20', 'translate-y-8');
                    }
                });
            };
            window.addEventListener('scroll', handleScroll);
            handleScroll();
        }

        // --- REVEAL BLUR LOGIC ---
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-blur').forEach(el => revealObserver.observe(el));
    }

    // Initialisierung beim Laden und nach Astro Page Swaps
    initAnimations();
    document.addEventListener('astro:after-swap', initAnimations);
</script>