            .reveal-focus {
                display: inline-block;
                filter: blur(15px);
                letter-spacing: 0.2em;
                opacity: 0;
                transform: translateY(10px);
                transition: 
                    filter 1.5s cubic-bezier(0.22, 1, 0.36, 1),
                    letter-spacing 1.8s cubic-bezier(0.22, 1, 0.36, 1),
                    opacity 1.2s ease-out,
                    transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
            }

            .reveal-focus.active {
                filter: blur(0);
                letter-spacing: normal;
                opacity: 1;
                transform: translateY(0);
            }
        </style>

        <script>
            function initFinalStatement() {
                const target = document.querySelector('.reveal-focus');
                if (!target) return;

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            target.classList.add('active');
                        }
                    });
                }, { threshold: 0.5 });

                observer.observe(target);
            }

            initFinalStatement();
            document.addEventListener('astro:after-swap', initFinalStatement);
        </script>

