<style>
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 8s linear infinite;
    }

    .reveal-blur {
        filter: blur(20px);
        opacity: 0;
        transform: translateY(30px);
        transition: all 1.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal-blur.active {
        filter: blur(0);
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    function initAnimations() {
        // --- TIMELINE LOGIC ---
        const container = document.getElementById('timelineContainer');
        const fillLine = document.getElementById('timelineProgress');
        const items = document.querySelectorAll('.timeline-item');
        
        if (container && fillLine) {
            const handleScroll = () => {
                const rect = container.getBoundingClientRect();
                const viewportHeight = window.innerHeight;
                
                let progress = (viewportHeight * 0.5 - rect.top) / rect.height;
                progress = Math.max(0, Math.min(1, progress));
                fillLine.style.height = `${progress * 100}%`;
                
                items.forEach((item) => {
                    const itemRect = item.getBoundingClientRect();
                    const dot = item.querySelector('.rounded-full.border-\\[3px\\]'); 

                    if (itemRect.top < viewportHeight * 0.65) {
                        item.classList.remove('opacity-20', 'translate-y-8');
                        item.classList.add('opacity-100', 'translate-y-0');
                        
                        if(dot) {
                            dot.classList.add('border-rose-500', 'scale-125', 'bg-rose-500');
                            dot.classList.remove('border-slate-300', 'dark:border-slate-700', 'bg-white', 'dark:bg-slate-950');
                        }
                    } else {
                        item.classList.remove('opacity-100', 'translate-y-0');
                        item.classList.add('opacity-20', 'translate-y-8');
                        
                        if(dot) {
                            dot.classList.remove('border-rose-500', 'scale-125', 'bg-rose-500');
                            dot.classList.add('border-slate-300', 'dark:border-slate-700', 'bg-white', 'dark:bg-slate-950');
                        }
                    }
                });
            };
            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll();
        }

        // --- REVEAL BLUR LOGIC ---
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-blur').forEach(el => revealObserver.observe(el));
    }

    initAnimations();
    document.addEventListener('astro:after-swap', initAnimations);
</script>