<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CommunityCenter",
  "name": "Die Brücke - soziokulturelles Zentrum",
  "url": "https://diebruecke.cc",
  "telephone": "+43 316 67 22 48",
  "email": "office@diebruecke.cc",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Grabenstraße 39a",
    "addressLocality": "Graz",
    "postalCode": "8010",
    "addressCountry": "AT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 47.085, 
    "longitude": 15.435 
  },
  "openingHoursSpecification": openingHours.map(h => {
      let days = [];
      if(h.label.includes('Montag')) days.push("Monday");
      if(h.label.includes('Dienstag')) days.push("Tuesday");
      if(h.label.includes('Mittwoch')) days.push("Wednesday");
      if(h.label.includes('Donnerstag')) days.push("Thursday");
      if(h.label.includes('Freitag')) days.push("Friday");
      if(h.label.includes('Samstag')) days.push("Saturday");
      if(h.label.includes('Sonntag')) days.push("Sunday");
      if(h.label.includes('Montag') && h.label.includes('Donnerstag')) days = ["Monday", "Tuesday", "Wednesday", "Thursday"];
      return { "@type": "OpeningHoursSpecification", "dayOfWeek": days, "opens": h.time.split('–')[0]?.trim() || "09:00", "closes": h.time.split('–')[1]?.trim() || "16:00" };
  }).filter(o => o.dayOfWeek.length > 0)
})} />

<script>
    // 1. Live-Status
    function updateOpeningStatus() {
        const container = document.getElementById('opening-status');
        if (!container) return;

        const now = new Date();
        const day = now.getDay(); 
        const hour = now.getHours();
        let isOpen = false;

        // Mo-Do (1-4): 9-16 Uhr, Fr (5): 9-13 Uhr
        if (day >= 1 && day <= 4 && hour >= 9 && hour < 16) isOpen = true;
        if (day === 5 && hour >= 9 && hour < 13) isOpen = true;

        if (isOpen) {
            container.innerHTML = `
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs font-bold uppercase tracking-widest border border-emerald-200 dark:border-emerald-800">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Jetzt geöffnet
                </span>
            `;
        } else {
            container.innerHTML = `
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-400 text-xs font-bold uppercase tracking-widest border border-rose-200 dark:border-rose-800">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> Gerade geschlossen
                </span>
            `;
        }
        container.classList.remove('hidden');
    }

    // 2. Google Maps Logic
    function initMapLogic() {
        const placeholder = document.getElementById('map-placeholder');
        const iframe = document.getElementById('google-map');
        
        if (placeholder && iframe) {
            placeholder.addEventListener('click', () => {
                const apiKey = placeholder.dataset.key;
                if (!apiKey) {
                    alert("Google Maps API Key nicht gefunden. Bitte .env prüfen.");
                    return;
                }
                const query = "Die Brücke Graz Grabenstraße 39a";
                // FIX: Korrekte Google Maps Embed API URL
                const mapUrl = `https://www.google.com/maps/embed/v1/place?key=${apiKey}&q=${encodeURIComponent(query)}`;
                
                iframe.setAttribute('src', mapUrl);
                iframe.classList.remove('hidden');
                placeholder.style.display = 'none';
            });
        }
    }

    // 3. Form Logic
    function initFormLogic() {
        const form = document.getElementById('contact-form');
        const msgBox = document.getElementById('form-message');
        const submitBtn = document.getElementById('submit-btn');

        if(form && msgBox && submitBtn) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Senden...';
                submitBtn.setAttribute('disabled', 'true');
                msgBox.classList.add('hidden');

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch('/api/contact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if(response.ok) {
                        msgBox.innerHTML = `<i class="fa-solid fa-check-circle"></i> ${result.message}`;
                        msgBox.className = "p-4 rounded-xl text-sm font-bold mb-4 bg-emerald-100 text-emerald-800 border border-emerald-200 block";
                        form.reset();
                    } else {
                        throw new Error(result.message || 'Fehler beim Senden');
                    }

                } catch (error) {
                    console.error(error);
                    msgBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${error.message || 'Verbindungsfehler.'}`;
                    msgBox.className = "p-4 rounded-xl text-sm font-bold mb-4 bg-rose-100 text-rose-800 border border-rose-200 block";
                } finally {
                    submitBtn.innerHTML = originalBtnText;
                    submitBtn.removeAttribute('disabled');
                }
            });
        }
    }

    // 4. vCard Logic
    function initVCardLogic() {
        const btn = document.getElementById('vcard-btn');
        if(btn) {
            btn.addEventListener('click', () => {
                const vCardData = [
                    "BEGIN:VCARD",
                    "VERSION:3.0",
                    "N:;Die Brücke;;;",
                    "FN:Die Brücke Graz",
                    "ORG:Die Brücke - soziokulturelles Zentrum;",
                    "TEL;type=WORK;type=VOICE;type=pref:+43316672248",
                    "EMAIL:office@diebruecke.cc",
                    "ADR;type=WORK:;;Grabenstraße 39a;Graz;;8010;Austria",
                    "URL:https://diebruecke.cc",
                    "NOTE:Bürozeiten: Mo-Do 9-16, Fr 9-13 Uhr",
                    "END:VCARD"
                ].join("\n");

                const blob = new Blob([vCardData], { type: "text/vcard" });
                const url = URL.createObjectURL(blob);
                
                const link = document.createElement("a");
                link.href = url;
                link.setAttribute("download", "Die_Bruecke_Graz.vcf");
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
        }
    }

    const init = () => {
        updateOpeningStatus();
        initMapLogic();
        initFormLogic();
        initVCardLogic();
    }
    
    init();
    document.addEventListener('astro:after-swap', init);
</script>

