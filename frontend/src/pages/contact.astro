                        Mitmachen & Bewegen <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
            </a>
        </div>
    </section>

    {/* --- EXIT --- */}
    <section class="bg-white dark:bg-slate-950 pt-24 pb-16 text-center transition-colors duration-300 rounded-b-[32px] md:rounded-b-[64px] mb-4">
        <div class="max-w-4xl mx-auto px-6">
