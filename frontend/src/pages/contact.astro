            </div>
        </div>
    </section>

    </div>
</MainLayout>

{/* --- SEO: SCHEMA.ORG (JSON-LD) GEFIXTER AUFRUF --- */}
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script>
    function updateOpeningStatus() {
        const container = document.getElementById('opening-status');
        const hoursDataEl = document.getElementById('opening-hours-data');
        const eventsDataEl = document.getElementById('events-data');
        
        if (!container || !hoursDataEl || !eventsDataEl) return;

        let hoursData = [];
        let eventsData = [];
        try {
            hoursData = JSON.parse(hoursDataEl.textContent);
            eventsData = JSON.parse(eventsDataEl.textContent);
        } catch(e) { return; }

        const now = new Date();
        const currentDay = now.getDay(); 
        const currentMinutesOfDay = now.getHours() * 60 + now.getMinutes();
        let isOpen = false;

        // 1. REGULÄRE ZEITEN PRÜFEN
        hoursData.forEach(slot => {
            const l = slot.label.toLowerCase();
            let activeDays = [];
            
            if (/\b(mo|montag)\b/.test(l)) activeDays.push(1);
            if (/\b(di|dienstag)\b/.test(l)) activeDays.push(2);
            if (/\b(mi|mittwoch)\b/.test(l)) activeDays.push(3);
            if (/\b(do|donnerstag)\b/.test(l)) activeDays.push(4);
            if (/\b(fr|freitag)\b/.test(l)) activeDays.push(5);
            if (/\b(sa|samstag)\b/.test(l)) activeDays.push(6);
            if (/\b(so|sonntag)\b/.test(l)) activeDays.push(0);

            if (activeDays.includes(currentDay)) {
                const times = slot.time.match(/\d{1,2}:\d{2}/g);
                if (times && times.length >= 2) {
                    const [startH, startM] = times[0].split(':').map(Number);
                    const [endH, endM] = times[1].split(':').map(Number);
                    
                    const startMin = startH * 60 + startM;
                    const endMin = endH * 60 + endM;
                    
                    if (currentMinutesOfDay >= startMin && currentMinutesOfDay < endMin) {
                        isOpen = true;
                    }
                }
            }
        });

        // 2. EVENTS PRÜFEN
        const todayStr = now.toISOString().split('T')[0];
        const hasEventToday = eventsData.some(ev => ev.start_date && ev.start_date.startsWith(todayStr));

        if (hasEventToday) {
            const eventStartMin = 17 * 60 + 30; // 17:30 in Minuten
            const eventEndMin = 23 * 60 + 30;   // 23:30 in Minuten
            
            if (currentMinutesOfDay >= eventStartMin && currentMinutesOfDay < eventEndMin) {
                isOpen = true;
            }
        }

        // 3. AMPEL RENDERN
        if (isOpen) {
            container.innerHTML = `
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs font-bold uppercase tracking-widest border border-emerald-200 dark:border-emerald-800 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Jetzt geöffnet
                </span>
            `;
        } else {
            container.innerHTML = `
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-400 text-xs font-bold uppercase tracking-widest border border-rose-200 dark:border-rose-800 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-rose-500"></span> Gerade geschlossen
                </span>
            `;
        }
        container.classList.remove('hidden');
    }

    function initContactLogic() {
        updateOpeningStatus();
        
        const form = document.getElementById('contact-form');
        const msgBox = document.getElementById('form-message');
        const submitBtn = document.getElementById('submit-btn');

        if(form && msgBox && submitBtn) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Senden...';
                submitBtn.setAttribute('disabled', 'true');
                msgBox.classList.add('hidden');

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch('/api/contact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();

                    if(response.ok) {
                        msgBox.innerHTML = `<i class="fa-solid fa-check-circle"></i> ${result.message}`;
                        msgBox.className = "p-4 rounded-xl text-sm font-bold mb-4 bg-emerald-100 text-emerald-800 border border-emerald-200 block";
                        form.reset();
                    } else {
                        throw new Error(result.message || 'Fehler beim Senden');
                    }
                } catch (error) {
                    msgBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${error.message || 'Verbindungsfehler.'}`;
                    msgBox.className = "p-4 rounded-xl text-sm font-bold mb-4 bg-rose-100 text-rose-800 border border-rose-200 block";
                } finally {
                    submitBtn.innerHTML = originalBtnText;
                    submitBtn.removeAttribute('disabled');
                }
            });
        }
    }

    initContactLogic();
    document.addEventListener('astro:after-swap', initContactLogic);
</script>

