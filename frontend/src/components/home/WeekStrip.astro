---
// Startseite: „Diese Woche in der Brücke“ – die nächsten 7 Tage als schmaler Streifen mit Serie
import SeriesBadge from '../events/SeriesBadge.astro';
const { events = [] } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit' });
const time = (d: Date) => d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
---
{events.length > 0 && (
  <section class="px-4 sm:px-6 md:px-10 py-6" aria-label="Diese Woche in der Brücke">
    <div class="max-w-7xl mx-auto rounded-3xl border border-slate-100 dark:border-slate-800 bg-white/70 dark:bg-slate-900/60 backdrop-blur p-4 md:p-5 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
      <a href="/events?zeit=woche" class="shrink-0 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-rose-600 dark:text-rose-400 hover:underline underline-offset-4">
        <i class="fa-solid fa-bolt" aria-hidden="true"></i> Diese Woche
      </a>
      <ul class="flex gap-3 overflow-x-auto hide-scrollbar snap-x -mx-1 px-1">
        {events.map((e: any) => (
          <li class="snap-start shrink-0">
            <a href={`/events/${e.slug}`} class="group flex items-center gap-3 pl-2 pr-4 py-2 rounded-2xl bg-slate-50 dark:bg-slate-800/70 hover:bg-white dark:hover:bg-slate-800 hover:shadow-md transition">
              <span class="text-center leading-tight px-2 py-1 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900">
                <span class="block text-[10px] font-bold uppercase tracking-widest">{fmt(e._displayDate).split(',')[0]}</span>
                <span class="block text-sm font-black">{e._displayDate.getDate()}.</span>
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-slate-900 dark:text-white group-hover:text-rose-600 truncate max-w-[16rem]">{e.title}</span>
                <span class="flex items-center gap-2 mt-0.5 text-xs text-slate-500 dark:text-slate-400">{time(e._displayDate)} Uhr {e.series?.name && !e.title.startsWith(e.series.name) && <SeriesBadge series={e.series} />}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
