---
/* src/components/home/CTA.astro */
---
{/* 1. Einleitung */}
<section class="pt-40 pb-16 text-center transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-6">
        <p class="text-slate-600 dark:text-slate-100 font-medium text-xl italic">
            „Genug gescrollt. Zeit für einen Kaffee bei uns, oder?“
        </p>
        <div class="mt-12 flex flex-col items-center">
            <div class="w-2 h-2 rounded-full bg-rose-500 mb-2"></div>
            <div class="w-0.5 h-24 bg-gradient-to-b from-rose-500 via-slate-200 to-transparent"></div>
        </div>
    </div>
</section>

{/* 2. Haupt-CTA Banner */}
<section class="px-4 sm:px-6 md:px-10 pb-32 transition-colors duration-300">
    <div class="bg-slate-900 rounded-[40px] px-4 py-16 sm:p-20 text-white text-center relative overflow-hidden shadow-2xl border border-transparent dark:border-slate-800 isolate">
        
        {/* Dekorativer Glow */}
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-rose-600/20 rounded-full blur-[100px] opacity-60 pointer-events-none -translate-y-1/2 translate-x-1/2 animate-pulse mix-blend-screen"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-600/20 rounded-full blur-[100px] opacity-40 pointer-events-none translate-y-1/3 -translate-x-1/3"></div>
        
        <div class="relative z-10 flex flex-col items-center w-full">
            
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-display font-black tracking-tighter mb-2 leading-none uppercase text-slate-100">
                Mach mit.
            </h2>
            
            {/* FIX: py-2 hinzugefügt für vertikalen Puffer */}
            <div class="w-full max-w-full mb-10 py-2" style="container-type: inline-size;">
                 {/* FIX: leading-none -> leading-[1.15] (gibt dem Ü Platz) */}
                <span class="block font-display font-black uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-rose-500 via-white to-rose-500 bg-[length:200%_auto] animate-shine whitespace-nowrap leading-[1.25] drop-shadow-2xl"
                      style="font-size: clamp(1.5rem, 7cqi, 10rem);">
                    Werde Brückenpfeiler.
                </span>
            </div>

            <p class="text-slate-300 mb-12 text-lg sm:text-xl font-medium leading-relaxed max-w-2xl text-balance">
                Lust auf ein Graz ohne Barrieren? Egal ob du Unterstützung suchst, dich engagieren willst oder einfach nur auf einen Plausch vorbeischaust – unsere Tür in der Grabenstraße steht für dich offen.
            </p>

            <div class="flex flex-wrap justify-center gap-4">
                <a href="/contact" class="bg-rose-600 hover:bg-white hover:text-slate-900 px-10 py-5 rounded-full font-bold transition-all shadow-[0_0_40px_-10px_rgba(225,29,72,0.5)] hover:shadow-[0_0_60px_-10px_rgba(225,29,72,0.8)] text-lg transform hover:-translate-y-1 hover:scale-105">
                    Schreib uns
                </a>
                <a href="/about" class="bg-white/5 hover:bg-white/10 px-10 py-5 rounded-full font-bold transition-all border border-white/10 hover:border-white/30 text-lg backdrop-blur-sm">
                    Über den Verein
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes shine {
        to {
            background-position: 200% center;
        }
    }
    .animate-shine {
        animation: shine 4s linear infinite;
    }
</style>