---
// src/components/home/Events.astro

interface Props {
  highlightEvent: any;
  upcomingEvents: any[];
}

const { highlightEvent, upcomingEvents } = Astro.props;
const ASSET_URL = 'https://api.diebruecke.social/assets'; 

// PERF: Qualität auf 60 runter (reicht völlig für Web), WebP erzwingen
const getImg = (id: string, width: number) => `${ASSET_URL}/${id}?width=${width}&format=webp&quality=60`;

// PERF: Helper für srcsets
const getSrcset = (id: string, widths: number[]) => {
  return widths.map(w => `${getImg(id, w)} ${w}w`).join(', ');
};

function formatEventDate(event: any) {
    if (!event) return "";
    const dateStr = event.date_start || event.start_date || event.date;
    if (!dateStr) return "";
    
    try {
        const date = new Date(dateStr);
        if (isNaN(date.getTime())) return "";
        const day = date.toLocaleDateString('de-DE', { day: '2-digit', month: 'short' });
        const dayUpper = day ? day.toUpperCase() : "";
        const time = event.time_start ? event.time_start.slice(0, 5) : date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
        return time === "00:00" ? dayUpper : `${dayUpper} • ${time}`;
    } catch (e) {
        return "";
    }
}

// INLINE ICONS
const ICON_ARROW_RIGHT = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="w-3 h-3"><path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg>`;
const ICON_LAYER_GROUP = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" fill="currentColor" class="w-8 h-8 group-hover:rotate-12 transition-transform shrink-0"><path d="M264.5 5.2c14.9-6.9 32.1-6.9 47 0l218.6 101c8.5 3.9 13.9 12.4 13.9 21.8s-5.4 17.9-13.9 21.8l-218.6 101c-14.9 6.9-32.1 6.9-47 0L45.9 149.8C37.4 145.8 32 137.3 32 128s5.4-17.9 13.9-21.8L264.5 5.2zM476.9 209.6l53.2 24.6c8.5 3.9 13.9 12.4 13.9 21.8s-5.4 17.9-13.9 21.8l-218.6 101c-14.9 6.9-32.1 6.9-47 0L45.9 277.8C37.4 273.8 32 265.3 32 256s5.4-17.9 13.9-21.8l53.2-24.6 152 70.2c23.4 10.8 50.4 10.8 73.8 0l152-70.2zm-152 198.2l152-70.2 53.2 24.6c8.5 3.9 13.9 12.4 13.9 21.8s-5.4 17.9-13.9 21.8l-218.6 101c-14.9 6.9-32.1 6.9-47 0L45.9 405.8C37.4 401.8 32 393.3 32 384s5.4-17.9 13.9-21.8l53.2-24.6 152 70.2c23.4 10.8 50.4 10.8 73.8 0z"/></svg>`;
---

{/* --- BENTO EVENTS HEADER --- */}
<section aria-labelledby="events-heading" class="px-6 sm:px-10 pb-12 pt-12 transition-colors duration-300">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <div class="flex items-center gap-3 mb-4">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500 dark:bg-rose-400"></span>
                </span>
                <span class="text-rose-700 dark:text-rose-400 font-bold tracking-widest uppercase text-[10px]">
                    Live aus der Brücke
                </span>            
            </div>
            <h2 id="events-heading" class="text-4xl md:text-5xl font-display font-bold text-slate-900 dark:text-white tracking-tighter">
                Was gerade geht.
            </h2>
        </div>
        <p class="text-slate-700 dark:text-slate-300 font-medium italic text-lg md:text-right">
            Langweilig wird's woanders. <br class="hidden md:block"> Komm wie du bist.
        </p>
    </div>
</section>

{/* --- BENTO EVENTS GRID --- */}
<section class="px-6 sm:px-10 pb-24 transition-colors duration-300">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-6 h-auto md:h-[700px]">
            
            {/* HIGHLIGHT EVENT */}
            {highlightEvent && (
                <a href={`/events/${highlightEvent.slug}`} class="md:col-span-2 md:row-span-2 relative group rounded-[32px] overflow-hidden bg-slate-900 shadow-xl border border-transparent dark:border-slate-800 min-h-[500px] md:min-h-0 block" aria-label={`Highlight Event: ${highlightEvent.title}`}>
                    {highlightEvent.image && (
                        <img 
                            src={getImg(highlightEvent.image, 800)} 
                            srcset={getSrcset(highlightEvent.image, [600, 800, 1200])}
                            sizes="(max-width: 768px) 95vw, (max-width: 1200px) 50vw, 800px"
                            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition duration-1000" 
                            alt={highlightEvent.title} 
                            width="800"
                            height="600"
                            loading="eager" 
                            decoding="async"
                        />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/20 to-transparent"></div>
                    <div class="absolute top-6 left-6 flex gap-2">
                        <span class="px-3 py-1 rounded-full bg-amber-400 text-slate-900 text-[10px] font-bold uppercase shadow-lg tracking-widest">Tipp</span>
                        <span class="px-3 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-bold uppercase shadow-lg tracking-widest border border-white/10">
                            {formatEventDate(highlightEvent)}
                        </span>
                    </div>
                    <div class="absolute bottom-0 left-0 p-8 md:p-12 text-white w-full">
                        <h3 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-4 tracking-tight drop-shadow-md">{highlightEvent.title}</h3>
                        <span class="font-bold flex items-center gap-2 text-rose-400">
                            Mehr erfahren <Fragment set:html={ICON_ARROW_RIGHT} />
                        </span>
                    </div>
                </a>
            )}

            {/* UPCOMING EVENTS */}
            {upcomingEvents && upcomingEvents.map((event, index) => (
                <a href={`/events/${event.slug}`} class={`relative group rounded-[32px] overflow-hidden bg-slate-900 border border-slate-900/10 dark:border-slate-800 hover:shadow-xl transition-all min-h-[350px] md:min-h-0 block ${index === 2 ? 'md:col-span-2 md:row-span-1' : 'md:col-span-1 md:row-span-1'}`} aria-label={`Event: ${event.title}`}>
                    {event.image && (
                        /* Optimized Sizes: Auf Mobile ist die Card fast Full-Width */
                        <img 
                            src={getImg(event.image, 600)} 
                            srcset={getSrcset(event.image, [400, 600])}
                            sizes="(max-width: 768px) 90vw, 25vw"
                            class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:scale-105 transition duration-1000" 
                            alt="" 
                            width="600"
                            height="450"
                            loading="lazy"
                            decoding="async"
                        />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/25 to-transparent"></div>
                    <div class="absolute top-6 left-6">
                        <span class="px-3 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-bold uppercase shadow-lg tracking-widest border border-white/10">
                            {formatEventDate(event)}
                        </span>
                    </div>
                    <div class="relative z-10 p-6 flex flex-col h-full justify-end">
                        <h3 class="text-xl font-display font-bold text-white group-hover:text-rose-200 transition-colors line-clamp-3 leading-tight tracking-tight drop-shadow-md">{event.title}</h3>
                    </div>
                </a>
            ))}
            
            <a href="/events" class="md:col-span-1 md:row-span-1 bg-rose-600 rounded-[32px] p-8 flex items-center justify-center text-white group hover:bg-slate-900 transition-all shadow-lg overflow-hidden border border-transparent dark:border-slate-700 min-h-[200px] md:min-h-0">
                <div class="flex items-center gap-4 text-left">
                    <Fragment set:html={ICON_LAYER_GROUP} />
                        <span class="text-xl font-display font-bold leading-tight tracking-tighter">
                        Alle <br>Veranstaltungen
                        </span>
                </div>
            </a>
        </div>
    </div>
</section>