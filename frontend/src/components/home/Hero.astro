---
import { Image } from 'astro:assets';

interface Props {
  headlineRow1: string;
  headlineRow2?: string;
  gradientClasses?: string;
  subline: string;
  image: string;
}

const { 
  headlineRow1, 
  headlineRow2, 
  gradientClasses, 
  subline, 
  image 
} = Astro.props;

const finalGradient = gradientClasses || 'from-rose-500 to-orange-500';
---

{/* --- HERO SECTION --- */}
<section class="relative z-10 w-full min-h-[85vh] lg:min-h-[90vh] flex items-center overflow-hidden px-4 sm:px-16 lg:px-24 py-12 lg:py-20 group/hero bg-gradient-to-br from-slate-50 via-white to-rose-50/30 dark:from-slate-950 dark:via-slate-950 dark:to-rose-950/20 transition-colors duration-500 rounded-[24px] sm:rounded-[40px] mb-6 sm:mb-10">

    {/* GRID */}
    <div class="max-w-[1600px] mx-auto w-full grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-0 relative items-center">

        {/* 1. TEXT CONTENT */}
        <div class="relative col-span-1 lg:col-span-5 flex flex-col items-start order-1 lg:order-none pointer-events-none">

            {/* BADGE */}
            <div class="relative z-30 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border border-slate-200 dark:border-slate-700 text-xs font-bold text-rose-600 dark:text-rose-400 mb-6 sm:mb-8 uppercase tracking-widest shadow-sm whitespace-nowrap pointer-events-auto">
                <span class="relative flex h-2 w-2 mb-0.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-600"></span>
                </span>
                Seit 1983
            </div>

            {/* HEADLINE */}
            <h1 class="relative z-30 text-4xl xs:text-5xl sm:text-6xl xl:text-8xl font-display font-extrabold text-slate-900 dark:text-white tracking-tighter leading-[0.85] lg:leading-[0.45] sm:leading-[0.85] md:leading-[0.75] mb-8 sm:mb-8 drop-shadow-md lg:drop-shadow-xl group-hover/hero:text-slate-900 transition-colors duration-500 break-words hyphens-auto w-full lg:w-[140%] pointer-events-auto">
                <span class="lg:whitespace-nowrap">
                    {headlineRow1}
                </span>
                {headlineRow2 && (
                    <>
                        <br class="hidden sm:block" />
                        <span 
                            class:list={[
                                "text-transparent bg-clip-text bg-gradient-to-r block sm:inline mt-1 sm:mt-0 lg:whitespace-nowrap",
                                finalGradient
                            ]}
                        >
                            {headlineRow2}
                        </span>
                    </>
                )}
            </h1>

            {/* SUBLINE - FIX: Trennung von Border und Text */}
            {/* Wrapper: Positioniert alles, aber KEIN z-index hier! */}
            <div class="relative w-full sm:max-w-2xl lg:w-[120%] mb-8 sm:mb-10 pointer-events-auto">
                
                {/* 1. DIE BORDER (Separat) */}
                {/* Liegt absolut links, hat z-30, ist Rot. Kein Blend-Mode. */}
                <div class="absolute left-0 top-1 bottom-1 w-1 bg-rose-500 z-30"></div>

                {/* 2. DER TEXT */}
                {/* font-extrabold: Mehr Fläche für den Kontrast */}
                {/* mix-blend-exclusion: Stabileres Schwarz */}
                <div 
                    class="relative z-30 pl-4 sm:pl-6 text-base sm:text-xl leading-relaxed font-extrabold text-white mix-blend-exclusion break-words pr-0 [&_*]:!text-white"
                    set:html={subline}
                >
                </div>
            </div>

            {/* BUTTONS */}
            <div class="relative z-30 flex flex-col sm:flex-row gap-4 pointer-events-auto w-full sm:w-auto">
                <a href="/blog" class="w-full sm:w-auto justify-center bg-rose-600 text-white px-6 py-4 rounded-full font-bold hover:bg-slate-900 dark:hover:bg-white dark:hover:text-slate-900 transition-all shadow-lg shadow-rose-500/20 hover:-translate-y-1 text-center text-base flex items-center">
                    Blog & Journal
                </a>
                <a href="/about" class="w-full sm:w-auto justify-center bg-transparent text-slate-900 dark:text-white border-2 border-slate-200 dark:border-slate-700 px-6 py-4 rounded-full font-bold hover:border-rose-500 dark:hover:border-rose-500 transition-all hover:-translate-y-1 text-center text-base flex items-center">
                    Über uns
                </a>
            </div>
        </div>

        {/* 2. BILD CONTAINER */}
        <div class="relative col-span-1 lg:col-span-7 h-[40vh] sm:h-[50vh] lg:h-[75vh] w-full z-10 pointer-events-auto group/image mt-0 order-2 lg:order-none">
            
            <div class="absolute right-0 top-0 bottom-0 left-0 lg:left-auto h-full rounded-[24px] sm:rounded-[40px] lg:rounded-[80px] overflow-hidden shadow-2xl bg-slate-900 ring-4 ring-white dark:ring-slate-800
                        w-full lg:w-full group-hover/image:lg:w-[130%] transition-[width] duration-[1.0s] ease-out">

                <Image
                src={image}
                alt="Impression aus der Brücke Graz"
                quality={90}
                widths={[640, 1024, 1600, 2000]}
                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 60vw, 1000px"
                width={1600}
                height={900}
                loading="eager"
                fetchpriority="high"
                format="webp"
                class="absolute inset-0 w-full h-full object-cover object-center scale-105 group-hover/image:scale-100 transition-transform duration-[2s]"
                />

                <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_40%,rgba(244,63,94,0.1),transparent_60%)]"></div>
                <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover/image:opacity-100 transition-opacity duration-700 backdrop-blur-[1px]"></div>

                {/* WATERMARK */}
                <div class="absolute -bottom-6 -right-6 sm:-bottom-10 sm:-right-10 pointer-events-none select-none opacity-30 sm:opacity-50 group-hover/image:opacity-80 transition-opacity duration-700">
                    <p class="text-[80px] sm:text-[160px] xl:text-[220px] font-display font-black tracking-tighter leading-none text-white/10 uppercase">
                        Brücke
                    </p>
                </div>

                <div class="absolute inset-0 ring-1 ring-inset ring-white/10 pointer-events-none"></div>
            </div>
        </div>

    </div>
</section>