---
import { Image } from 'astro:assets';

interface Props {
  headline: string;
  subline: string;
  image: string;
}

const { headline, subline, image } = Astro.props;

// LOGIK: Text beim <br> trennen für das Styling
const parts = headline.split(/<br\s*\/?>/i);
const part1 = parts[0];
const part2 = parts.length > 1 ? parts.slice(1).join('<br>') : null;
---

{/* --- HERO SECTION --- */}
{/* FIX: py-12 lg:py-20 hinzugefügt, um auf allen Devices genug Luft oben/unten zu haben, falls der Content wächst */}
<section class="relative z-10 w-full min-h-[85vh] flex items-center overflow-hidden px-6 sm:px-16 lg:px-24 py-12 lg:py-20 group/hero bg-gradient-to-br from-slate-50 via-white to-rose-50/30 dark:from-slate-950 dark:via-slate-950 dark:to-rose-950/20 transition-colors duration-500 rounded-[40px] mb-10">

    {/* FIX: 'h-full' entfernt! Damit darf der Container wachsen, wenn der Text länger ist. */}
    <div class="max-w-[1600px] mx-auto w-full grid grid-cols-12 gap-8 lg:gap-0 relative items-center">

        {/* 1. TEXT CONTENT */}
        <div class="relative z-30 col-span-12 lg:col-span-5 pointer-events-none">

            {/* BADGE */}
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border border-slate-200 dark:border-slate-700 text-xs font-bold text-rose-600 dark:text-rose-400 mb-6 sm:mb-8 uppercase tracking-widest shadow-sm whitespace-nowrap pointer-events-auto">
                <span class="relative flex h-2 w-2 mb-0.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-600"></span>
                </span>
                Seit 1983
            </div>

            {/* Headline */}
            <h1 class="text-4xl sm:text-6xl xl:text-8xl font-display font-extrabold text-slate-900 dark:text-white tracking-tighter leading-[1.05] mb-6 sm:mb-8 drop-shadow-sm lg:drop-shadow-none group-hover/hero:text-slate-900 transition-colors duration-500 sm:whitespace-nowrap pointer-events-auto">
                
                {/* Teil 1: Normal */}
                <span set:html={part1}></span>

                {/* Teil 2: Gradient */}
                {part2 && (
                    <>
                        <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-orange-500" set:html={part2}></span>
                    </>
                )}
            </h1>

            {/* SUBLINE FIX: 
                1. <div> statt <p> (verhindert HTML-Fehler bei RichText)
                2. w-full statt max-w-sm (nutzt volle Breite)
                3. relative z-30 (stellt sicher, dass es über allem liegt)
            */}
            <p 
                class="relative z-30 text-lg sm:text-xl text-slate-700 dark:text-slate-200 leading-relaxed border-l-4 border-rose-500 pl-4 sm:pl-6 font-medium mb-8 sm:mb-10 w-full sm:max-w-4xl lg:w-[120%] group-hover/hero:text-slate-900 dark:group-hover/hero:text-white transition-colors duration-500 pointer-events-auto drop-shadow-sm"
                set:html={subline}
            >
            </p>

            <div class="flex flex-col sm:flex-row gap-4 pointer-events-auto">
                <a href="/events" class="bg-rose-600 text-white px-8 py-3.5 sm:py-4 rounded-full font-bold hover:bg-slate-900 dark:hover:bg-white dark:hover:text-slate-900 transition-all shadow-lg shadow-rose-500/20 hover:-translate-y-1 text-center text-sm sm:text-base">
                    Event Kalender
                </a>
                <a href="/about" class="bg-transparent text-slate-900 dark:text-white border-2 border-slate-200 dark:border-slate-700 px-8 py-3.5 sm:py-4 rounded-full font-bold hover:border-rose-500 dark:hover:border-rose-500 transition-all hover:-translate-y-1 text-center text-sm sm:text-base">
                    Über uns
                </a>
            </div>
        </div>

        {/* 2. BILD CONTAINER */}
        <div class="relative col-span-12 lg:col-span-7 h-[50vh] lg:h-[75vh] z-10 pointer-events-auto group/image mt-8 lg:mt-0">
            
            <div class="absolute right-0 top-0 bottom-0 h-full rounded-[40px] lg:rounded-[80px] overflow-hidden shadow-2xl bg-slate-900 ring-4 ring-white dark:ring-slate-800
                        w-full group-hover/image:w-[130%] transition-[width] duration-[1.0s] ease-out">

                {/* Quality auf 60 reduziert für besseren LCP */}
                <Image
                src={image}
                alt="Impression aus der Brücke Graz"
                quality={60}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 768px) 90vw, (max-width: 1200px) 60vw, 800px"
                width={1600}
                height={900}
                loading="eager"
                fetchpriority="high"
                format="webp"
                class="absolute inset-0 w-full h-full object-cover object-center scale-105 group-hover/image:scale-100 transition-transform duration-[2s]"
                />

                <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_40%,rgba(244,63,94,0.1),transparent_60%)]"></div>
                <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover/image:opacity-100 transition-opacity duration-700 backdrop-blur-[1px]"></div>

                {/* WATERMARK */}
                <div class="absolute -bottom-10 -right-10 pointer-events-none select-none opacity-50 group-hover/image:opacity-80 transition-opacity duration-700">
                    <p class="text-[120px] sm:text-[160px] xl:text-[220px] font-display font-black tracking-tighter leading-none text-white/10 uppercase">
                        Brücke
                    </p>
                </div>

                <div class="absolute inset-0 ring-1 ring-inset ring-white/10 pointer-events-none"></div>
            </div>
        </div>

    </div>
</section>