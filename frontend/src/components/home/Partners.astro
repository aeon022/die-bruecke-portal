---
import { Image } from 'astro:assets';

interface Props {
  partners: any[];
}

const { partners } = Astro.props;
const ASSET_URL = 'https://api.diebruecke.social/assets'; 

// Wir nutzen eine Fallback-Liste, falls keine Partner geladen werden konnten
const partnerList = partners.length > 0 ? partners : [ { name: "Partner Platzhalter", logo: null } ];
---

<section aria-label="Partner und Fördergeber" class="py-20 border-b border-slate-50 dark:border-slate-900 transition-colors duration-300 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 mb-12 text-center">
        <span class="text-slate-500 dark:text-slate-400 font-bold tracking-[0.2em] uppercase text-[10px] border-b-2 border-rose-500/20 pb-2">
            Gemeinsam stark durch unsere Partner
        </span>
    </div>
    
    <div class="relative flex overflow-x-hidden group select-none">
        {/* Erste Schleife */}
        <div class="py-12 animate-marquee whitespace-nowrap flex items-center">
            {partnerList.map((partner: any) => {
                // Dynamischer Tag: Wenn eine Website existiert, machen wir einen Link draus, sonst bleibt es ein div
                const Tag = partner.website ? 'a' : 'div';
                const tagProps = partner.website ? { href: partner.website, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `Zur Website von ${partner.name}` } : {};

                return (
                    <Tag {...tagProps} class="mx-12 md:mx-16 w-48 h-20 flex items-center justify-center grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-500 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-4 dark:focus:ring-offset-slate-900 rounded-lg">
                        {partner.logo ? (
                            <img 
                                src={`${ASSET_URL}/${partner.logo}${partner.logo.includes('?') ? '&' : '?'}width=400&format=webp`} 
                                alt={`Logo von ${partner.name}`} 
                                width="192" 
                                height="80"
                                loading="lazy"
                                decoding="async"
                                class="max-w-full max-h-full object-contain" 
                            />
                        ) : (
                            <span class="text-slate-300 dark:text-slate-700 font-bold text-xl uppercase tracking-tighter">{partner.name}</span>
                        )}
                    </Tag>
                );
            })}
        </div>

        {/* Zweite Schleife (Kopie für nahtlosen Übergang) */}
        <div class="absolute top-0 py-12 animate-marquee2 whitespace-nowrap flex items-center" aria-hidden="true">
            {partnerList.map((partner: any) => {
                const Tag = partner.website ? 'a' : 'div';
                const tagProps = partner.website ? { href: partner.website, target: '_blank', rel: 'noopener noreferrer', tabindex: "-1" } : {}; // tabindex="-1" damit Screenreader die Links nicht doppelt vorlesen

                return (
                    <Tag {...tagProps} class="mx-12 md:mx-16 w-48 h-20 flex items-center justify-center grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-500 transform hover:scale-110">
                        {partner.logo ? (
                            <img 
                                src={`${ASSET_URL}/${partner.logo}${partner.logo.includes('?') ? '&' : '?'}width=400&format=webp`} 
                                alt="" 
                                width="192" 
                                height="80"
                                loading="lazy"
                                decoding="async"
                                class="max-w-full max-h-full object-contain" 
                            />
                        ) : (
                            <span class="text-slate-300 dark:text-slate-700 font-bold text-xl uppercase tracking-tighter">{partner.name}</span>
                        )}
                    </Tag>
                );
            })}
        </div>
    </div>
</section>

<style>
    @keyframes marquee {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-100%); }
    }
    @keyframes marquee2 {
        0% { transform: translateX(100%); }
        100% { transform: translateX(0%); }
    }
    .animate-marquee {
        animation: marquee 40s linear infinite; /* Etwas langsamer für bessere Lesbarkeit */
    }
    .animate-marquee2 {
        animation: marquee2 40s linear infinite;
    }
    /* Stoppt die Animation bei Hover für bessere UX */
    .group:hover .animate-marquee, 
    .group:hover .animate-marquee2 {
        animation-play-state: paused;
    }

    /* Reduziert die Bewegung für Nutzer mit "Reduced Motion" Präferenz */
    @media (prefers-reduced-motion: reduce) {
        .animate-marquee, .animate-marquee2 {
            animation-duration: 120s;
        }
    }
</style>