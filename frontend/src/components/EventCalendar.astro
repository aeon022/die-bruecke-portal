---
import { cleanText, formatEventDate } from '../lib/utils';

const { events, categories } = Astro.props;
const ASSET_URL = 'https://api.diebruecke.social/assets';

// 1. Kategorien vorbereiten
const categoryNames = categories ? [...new Set(categories.map((c: any) => c.name || c.title || c.label).filter(Boolean))].sort() : [];

// 2. Helper für ZigZag-Logik
let highlightCounter = 0;
---

{/* --- FILTER BAR (Semantic: <nav>) --- */}
<nav aria-label="Veranstaltungsfilter" class="sticky top-24 z-30 transition-all pointer-events-none mb-12">
    <div class="pointer-events-auto w-full">
        <div id="filter-container" class="filter-bar-container bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border-y sm:border border-slate-200/60 dark:border-white/5 py-3 px-4 sm:p-2 sm:rounded-2xl shadow-xl shadow-slate-200/10 dark:shadow-black/40 flex flex-nowrap gap-3 overflow-x-auto hide-scrollbar snap-x snap-mandatory transition-all duration-500">
            
            <button class="filter-btn active flex-shrink-0 snap-center px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest transition-all hover:scale-105 active:scale-95 shadow-md bg-slate-900 text-white dark:bg-white dark:text-slate-900 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-rose-500" 
                    data-category="all" aria-pressed="true">
                Alle
            </button>
            
            {categoryNames.map((name: any) => (
                <button class="filter-btn flex-shrink-0 snap-center px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest transition-all hover:scale-105 active:scale-95 bg-transparent text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-rose-500" 
                        data-category={name} aria-pressed="false">
                    {name}
                </button>
            ))}
             <div class="w-2 sm:hidden flex-shrink-0"></div>
        </div>
    </div>
</nav>

{/* --- GRID SECTION (Semantic: <section> mit <article>) --- */}
<section aria-label="Veranstaltungsliste" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 grid-flow-row-dense auto-rows-[minmax(380px,auto)]">
    
    {events.length === 0 && (
        <div class="col-span-full text-center py-20 bg-slate-50 dark:bg-slate-900 rounded-[32px] border border-dashed border-slate-200 dark:border-slate-800">
            <p class="text-slate-400 font-bold uppercase tracking-widest">Aktuell keine Termine veröffentlicht</p>
        </div>
    )}

    {events.map((event: any) => {
        const isHighlight = event.is_highlight === true;
        let isEvenHighlight = false;
        if (isHighlight) {
            highlightCounter++;
            isEvenHighlight = highlightCounter % 2 === 0;
        }
        const dateToShow = event._displayDate;
        
        return (
            <article 
                class={`event-card group relative overflow-hidden rounded-[40px] transition-all duration-500 hover:scale-[1.01] hover:shadow-2xl flex flex-col
                ${isHighlight 
                    ? `md:col-span-2 md:flex-row bg-gradient-to-br from-rose-50 via-white to-amber-50 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 shadow-xl ring-1 ring-slate-900/5 dark:ring-white/10 ${isEvenHighlight ? 'lg:col-start-2' : ''}` 
                    : 'col-span-1 bg-gradient-to-br from-white to-slate-50 dark:from-slate-900 dark:to-slate-950 border border-slate-100 dark:border-slate-800'
                }`}
                data-cats={event._catString}
            >
                {/* Image Link */}
                <a href={`/events/${event.slug}`} 
                   class={`block relative overflow-hidden shrink-0 z-10 focus:outline-none focus:ring-4 focus:ring-rose-500/50 rounded-t-[40px] md:rounded-none
                   ${isHighlight ? 'w-full md:w-2/5 h-64 md:h-auto md:rounded-l-[40px]' : 'w-full aspect-[4/3] rounded-t-[40px]'}`}
                   aria-label={`Details zu ${event.title}`}>
                    
                    {event.image ? (
                        <img src={`${ASSET_URL}/${event.image}`} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="" />
                    ) : (
                        <div class="w-full h-full flex items-center justify-center bg-slate-200 dark:bg-slate-800 text-slate-400 italic font-display uppercase tracking-widest text-[10px]">Kein Bild</div>
                    )}
                    
                    {/* Badge */}
                    <div class="absolute top-6 left-6 flex gap-2 items-start">
                        <time datetime={dateToShow.toISOString()} class="px-3 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-bold uppercase shadow-lg tracking-widest border border-white/10">
                            {formatEventDate(dateToShow, event.time_start)}
                        </time>
                        {isHighlight && (
                            <span class="px-3 py-1 rounded-full bg-amber-400 text-slate-900 text-[10px] font-bold uppercase shadow-lg tracking-widest flex items-center gap-1.5 animate-pulse-slow">
                                <i class="fa-solid fa-star text-[10px]"></i> Tipp
                            </span>
                        )}
                    </div>
                </a>

                <div class={`flex flex-col flex-grow relative z-10 justify-between ${isHighlight ? 'p-8 md:p-12' : 'p-8'}`}>
                    <div>
                        {/* Categories */}
                        <div class="flex gap-2 mb-5 flex-wrap">
                            {event._catString ? event._catString.split(',').map((catName: string) => (
                                <span class={`text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-lg border
                                    ${isHighlight 
                                        ? 'bg-white/60 border-rose-200/50 text-rose-700 dark:bg-rose-900/20 dark:border-rose-700/30 dark:text-rose-300' 
                                        : 'bg-white border-slate-200 text-slate-400 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-400'}`}>
                                    {catName}
                                </span>
                            )) : null}
                        </div>

                        {/* Semantic: Headline */}
                        <h2 class={`font-display font-bold group-hover:text-rose-600 transition-colors leading-[1.1] tracking-tight mb-4
                            ${isHighlight ? 'text-3xl md:text-4xl' : 'text-2xl'}
                            text-slate-900 dark:text-white`}>
                            <a href={`/events/${event.slug}`} class="focus:outline-none focus:underline decoration-rose-500 decoration-2 underline-offset-4">
                                {event.title}
                            </a>
                        </h2>

                        {/* Semantic: Description Paragraph with cleanText */}
                        {isHighlight && event.description && (
                            <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed mb-8 line-clamp-2 md:line-clamp-3 hidden md:block">
                                {cleanText(event.description).substring(0, 160)}...
                            </p>
                        )}
                    </div>

                    <div class="flex items-center justify-between pt-6 mt-4 border-t border-slate-200/50 dark:border-white/5">
                        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest group-hover:text-rose-500 transition-colors">Details</span>
                        <a href={`/events/${event.slug}`} class={`w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 transform group-hover:translate-x-1 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500
                            ${isHighlight 
                                ? 'bg-rose-500 text-white shadow-lg shadow-rose-500/20' 
                                : 'bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm group-hover:bg-rose-600 group-hover:text-white'}`}
                           aria-label={`Zum Event ${event.title}`}>
                            <i class="fa-solid fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </article>
        );
    })}
</section>

{/* Scripts & Styles */}
<style is:global>
    .filter-bar-container.is-stuck {
        background-color: rgba(241, 245, 249, 0.95) !important;
        border-color: rgba(203, 213, 225, 0.8) !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    html.dark .filter-bar-container.is-stuck {
        background-color: rgba(15, 23, 42, 0.95) !important;
        border-color: rgba(51, 65, 85, 0.8) !important;
    }
    html.dark .filter-btn.active {
        background-color: #ffffff !important;
        color: #0f172a !important;
    }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
    // Filter Logic
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.event-card');
    
    // Sticky Sentinel Logic
    const filterContainer = document.getElementById('filter-container');
    const sentinel = document.getElementById('sticky-sentinel'); // Sentinel muss in der Parent Page sein!

    if (sentinel && filterContainer) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
                    filterContainer.classList.add('is-stuck');
                } else {
                    filterContainer.classList.remove('is-stuck');
                }
            });
        }, { rootMargin: '-100px 0px 0px 0px', threshold: 0 });
        observer.observe(sentinel);
    }

    const activeClasses = ['bg-slate-900', 'text-white', 'shadow-md', 'dark:bg-white', 'dark:text-slate-900'];
    const inactiveClasses = ['bg-transparent', 'text-slate-500', 'hover:bg-slate-100', 'hover:text-slate-900', 'dark:text-slate-400', 'dark:hover:bg-slate-800', 'dark:hover:text-white'];

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            const category = btn.getAttribute('data-category');
            
            // ARIA & Styles update
            buttons.forEach(b => {
                b.classList.remove(...activeClasses);
                b.classList.add(...inactiveClasses);
                b.classList.remove('active');
                b.setAttribute('aria-pressed', 'false');
            });
            
            btn.classList.remove(...inactiveClasses);
            btn.classList.add(...activeClasses);
            btn.classList.add('active'); 
            btn.setAttribute('aria-pressed', 'true');

            // Filtern
            cards.forEach(card => {
                const cardCats = card.getAttribute('data-cats') || '';
                if (category === 'all' || cardCats.includes(category)) {
                    (card as HTMLElement).style.display = 'flex'; 
                } else {
                    (card as HTMLElement).style.display = 'none';
                }
            });
        });
    });
</script>