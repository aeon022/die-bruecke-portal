---
const { title, url } = Astro.props;

// URLs für Social Media vorbereiten
const shareLinks = [
  {
    name: 'WhatsApp',
    icon: 'fa-brands fa-whatsapp',
    href: `https://wa.me/?text=${encodeURIComponent(title + " " + url)}`,
    hover: 'hover:bg-[#25D366]'
  },
  {
    name: 'Facebook',
    icon: 'fa-brands fa-facebook-f',
    href: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
    hover: 'hover:bg-[#1877F2]'
  },
  {
    name: 'X',
    icon: 'fa-brands fa-x-twitter',
    href: `https://twitter.com/intent/tweet?url=${url}&text=${encodeURIComponent(title)}`,
    hover: 'hover:bg-black'
  },
  {
    name: 'LinkedIn',
    icon: 'fa-brands fa-linkedin-in',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
    hover: 'hover:bg-[#0A66C2]'
  }
];
---

<div class="py-12 border-y border-slate-100 dark:border-slate-900 my-16">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
    <div>
      <h4 class="text-xs font-black uppercase tracking-[0.3em] text-rose-500 mb-2">Inspiration teilen</h4>
      <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">Dir gefällt dieser Einblick? Teile ihn mit deinem Netzwerk.</p>
    </div>
    
    <div class="flex items-center gap-3">
      {shareLinks.map(link => (
        <a 
          href={link.href} 
          target="_blank" 
          rel="noopener noreferrer"
          class={`w-12 h-12 rounded-2xl border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-all duration-300 shadow-sm hover:shadow-xl hover:-translate-y-1 ${link.hover}`}
          title={link.name}
        >
          <i class={link.icon}></i>
        </a>
      ))}
      
      {/* Copy Link Button (Client-Side Logic) */}
      <button 
        id="copy-link"
        class="w-12 h-12 rounded-2xl border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-400 hover:bg-rose-500 hover:text-white transition-all duration-300 shadow-sm hover:shadow-xl hover:-translate-y-1"
        title="Link kopieren"
        data-url={url}
      >
        <i class="fa-solid fa-link"></i>
      </button>
    </div>
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-link');
  copyBtn?.addEventListener('click', () => {
    const url = copyBtn.getAttribute('data-url');
    if (url) {
      navigator.clipboard.writeText(url);
      // Kleiner visueller Feedback-Effekt
      const icon = copyBtn.querySelector('i');
      if (icon) {
        icon.className = 'fa-solid fa-check';
        setTimeout(() => icon.className = 'fa-solid fa-link', 2000);
      }
    }
  });
</script>