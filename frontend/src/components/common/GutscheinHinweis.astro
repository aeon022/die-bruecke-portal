---
// Kleiner Hinweis auf den Brücke-Gutschein. variant="band" (Startseite) oder "klein" (Eventseite).
const { variant = 'klein' } = Astro.props;
---
{variant === 'band' ? (
  <section class="px-4 sm:px-6 md:px-10 pb-16">
    <a href="/shop" class="group max-w-5xl mx-auto flex flex-col sm:flex-row items-center gap-6 sm:gap-10 rounded-[40px] p-8 sm:p-10 bg-slate-900 dark:bg-white text-white dark:text-slate-900 overflow-hidden">
      <span class="relative shrink-0 w-40 h-24 rounded-2xl bg-gradient-to-br from-orange-500 via-rose-500 to-rose-700 text-white flex items-center justify-center text-4xl font-display font-black -rotate-6 group-hover:rotate-0 transition-transform duration-500 shadow-2xl" aria-hidden="true">25 €</span>
      <span class="flex-1 text-center sm:text-left">
        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-rose-400 dark:text-rose-600 mb-2">Brücke-Gutschein</span>
        <span class="block text-3xl sm:text-4xl font-display font-black tracking-tight leading-none">Verschenk einen Abend.</span>
        <span class="block mt-3 opacity-80">25, 50 oder 100 € – für alle Veranstaltungen, ohne Ablaufdatum.</span>
      </span>
      <span class="inline-flex items-center gap-3 font-bold">Gutschein kaufen <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i></span>
    </a>
  </section>
) : (
  <a href="/shop" class="flex items-center gap-3 rounded-xl p-4 border border-dashed border-rose-300 dark:border-rose-800 hover:border-rose-500 text-sm transition-colors">
    <i class="fa-solid fa-gift text-rose-600 dark:text-rose-400 text-lg" aria-hidden="true"></i>
    <span class="text-slate-600 dark:text-slate-300"><strong class="text-slate-900 dark:text-white">Verschenken?</strong> Mit dem Brücke-Gutschein suchen sich die Beschenkten den Abend selbst aus.</span>
  </a>
)}
