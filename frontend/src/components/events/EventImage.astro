---
// Eventbild; ohne Bild eine Fläche in Serienfarbe mit Seriennamen (statt „Kein Bild“).
import { Image } from 'astro:assets';
import { seriesStyle } from '../../lib/series';
const { event, width = 800, height = 600, class: cls = '' } = Astro.props;
const ASSET_URL = 'https://api.diebruecke.social/assets';
---
{event.image ? (
  <Image src={`${ASSET_URL}/${event.image}`} alt={event.title} width={width} height={height} class={cls} />
) : event.series?.name ? (
  <div class="series-surface w-full h-full flex flex-col items-center justify-center gap-2 p-6 text-center" style={seriesStyle(event.series)}>
    <span class="font-display font-black text-3xl md:text-4xl tracking-tight leading-none">{event.series.name}</span>
    <span class="text-[10px] font-bold uppercase tracking-widest opacity-80">Die Brücke</span>
  </div>
) : (
  <div class="w-full h-full flex items-center justify-center bg-slate-200 dark:bg-slate-800 text-slate-400 italic font-display uppercase tracking-widest text-[10px]">Kein Bild</div>
)}
