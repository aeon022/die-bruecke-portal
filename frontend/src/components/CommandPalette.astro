---
// CommandPalette.astro - Optimiert für SSR & Performance; greift auf search-index.json.ts zurück
---

<div id="command-palette-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] hidden flex items-start justify-center pt-[10vh] px-4 transition-opacity duration-200 opacity-0" role="dialog" aria-modal="true" aria-label="Befehlsmenü">
    <div id="command-palette-modal" class="bg-white dark:bg-slate-900 w-full max-w-2xl rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden transform scale-95 transition-transform duration-200 flex flex-col max-h-[80vh]">
        
        {/* Search Input */}
        <div class="border-b border-slate-100 dark:border-slate-800 flex items-center px-4 py-4 relative shrink-0">
            <i class="fa-solid fa-search text-slate-400 text-lg mr-3" id="cp-search-icon"></i>
            <i class="fa-solid fa-circle-notch fa-spin text-rose-500 text-lg mr-3 hidden" id="cp-loading-icon"></i>
            
            <input type="text" id="cp-input" placeholder="Suchen nach Events, Journal, Projekten..." 
                   class="w-full bg-transparent border-none text-xl text-slate-900 dark:text-white placeholder-slate-400 focus:ring-0 focus:outline-none h-10" autocomplete="off" />
            
            <div class="hidden sm:flex gap-2 absolute right-4">
                <kbd class="text-[10px] font-bold text-slate-400 border border-slate-200 dark:border-slate-700 px-2 py-1 rounded bg-slate-50 dark:bg-slate-800">ESC</kbd>
            </div>
        </div>

        <div class="overflow-y-auto p-2 scroll-smooth" id="cp-results">
            {/* Dynamische Ergebnisse (werden via JS gefüllt) */}
            <div id="cp-dynamic-results" class="hidden space-y-2 mb-4">
                <h4 class="text-xs font-bold text-rose-500 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10 border-b border-rose-100 dark:border-rose-900/20">
                    Treffer
                </h4>
                <div class="cp-list-content"></div>
            </div>

            {/* Accessibility Settings */}
            <div class="cp-group mb-4" id="cp-settings">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest px-3 py-2 flex items-center gap-2"><i class="fa-solid fa-universal-access"></i> Einstellungen</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 px-2">
                    <button id="cp-toggle-contrast" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-rose-500 dark:hover:border-rose-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-circle-half-stroke"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Kontrast</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUS</div></button>
                    <button id="cp-toggle-fontsize" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-indigo-500 dark:hover:border-indigo-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-text-height"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Größe</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUS</div></button>
                    <button id="cp-toggle-motion" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-emerald-500 dark:hover:border-emerald-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-person-running"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Bewegung</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUS</div></button>
                    <button id="cp-toggle-theme" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-amber-500 dark:hover:border-amber-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-moon dark:hidden"></i><i class="fa-solid fa-sun hidden dark:block"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Design</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUTO</div></button>
                </div>
            </div>

            {/* Statische Navigation */}
            <div class="cp-group mb-2" id="cp-static-nav">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10">Navigation</h4>
                
                <a href="/" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="home start landing">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center"><i class="fa-solid fa-house text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Startseite</span>
                </a>

                <a href="/about" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="team verein über uns wer wir sind">
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center"><i class="fa-solid fa-users text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Über uns & Team</span>
                </a>

                <a href="/events" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="kalender termin events konzert">
                    <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center"><i class="fa-regular fa-calendar text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Veranstaltungen</span>
                </a>

                <a href="/services" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="angebot hilfe leistung fass wohnen">
                    <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center"><i class="fa-solid fa-hand-holding-heart text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Angebote</span>
                </a>

                <a href="/camps" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="urlaub reisen sommercamp ferien urlaubsaktionen">
                    <div class="w-8 h-8 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center"><i class="fa-solid fa-plane text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Camps & Reisen</span>
                </a>

                <a href="/city-trips" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="city trip städtereise wien prag stadt urlaub">
                    <div class="w-8 h-8 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center"><i class="fa-solid fa-city text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">City Trips</span>
                </a>

                <a href="/projects" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="projekte innovation laboratorium">
                    <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center"><i class="fa-solid fa-lightbulb text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Projekte</span>
                </a>

                <a href="/contact" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="kontakt email adresse anfahrt nachricht">
                    <div class="w-8 h-8 rounded-lg bg-slate-200 text-slate-600 flex items-center justify-center"><i class="fa-regular fa-envelope text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Kontakt</span>
                </a>

                <a href="/blog" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="journal blog geschichten aktuell zeitung">
                    <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center"><i class="fa-solid fa-newspaper text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Journal & Blog</span>
                </a>

                <a href="/archiv" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="archiv geschichte download alt dokumente früher">
                    <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center"><i class="fa-solid fa-box-archive text-xs"></i></div>
                    <span class="text-slate-700 dark:text-slate-200 font-medium">Archiv</span>
                </a>
            </div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950 px-4 py-3 border-t border-slate-100 dark:border-slate-800 text-[10px] text-slate-400 flex justify-between items-center shrink-0">
            <div class="flex gap-4">
                <span class="flex items-center gap-1"><kbd class="bg-white px-1 rounded border">↑↓</kbd> wählen</span>
                <span class="flex items-center gap-1"><kbd class="bg-white px-1 rounded border">↵</kbd> bestätigen</span>
            </div>
             <span class="opacity-50">Die Brücke Portal</span>
        </div>
    </div>
</div>

<script>
    // --- STATE ---
    let searchData = [];
    let isOpen = false;
    let selectedIndex = 0;

    // --- DOM REFERENCES ---
    const backdrop = document.getElementById('command-palette-backdrop');
    const modal = document.getElementById('command-palette-modal');
    const input = document.getElementById('cp-input');
    const dynamicResults = document.getElementById('cp-dynamic-results');
    const staticNav = document.getElementById('cp-static-nav');
    const settingsGroup = document.getElementById('cp-settings');
    const searchIcon = document.getElementById('cp-search-icon');
    const loadingIcon = document.getElementById('cp-loading-icon');

    // Accessibility Toggles
    const btnContrast = document.getElementById('cp-toggle-contrast');
    const btnFontSize = document.getElementById('cp-toggle-fontsize');
    const btnMotion = document.getElementById('cp-toggle-motion');
    const btnTheme = document.getElementById('cp-toggle-theme');

    // --- DATA LOADING (Lazy) ---
    async function loadSearchIndex() {
        if (searchData.length > 0) return; // Schon geladen
        
        loadingIcon?.classList.remove('hidden');
        searchIcon?.classList.add('hidden');

        try {
            // PRODUKTION: Normaler Fetch, Browser nutzt Cache-Control Header (1h)
            const res = await fetch('/api/search-index.json');
            if (res.ok) {
                searchData = await res.json();
            }
        } catch (e) {
            console.error("Fehler beim Laden des Suchindex", e);
        } finally {
            loadingIcon?.classList.add('hidden');
            searchIcon?.classList.remove('hidden');
        }
    }

    // --- CORE FUNCTIONS ---
    function openCP() {
        if(!backdrop || !modal) return;
        backdrop.classList.remove('hidden');
        // Trigger Reflow
        void backdrop.offsetWidth; 
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95');
        
        document.body.style.overflow = 'hidden';
        if(input) { 
            input.value = ''; 
            resetView(); 
            setTimeout(() => input.focus(), 50); 
        }
        
        initAccessibility(); // Deine Settings laden
        loadSearchIndex();   // Daten im Hintergrund holen
        isOpen = true;
    }

    function closeCP() {
        if(!backdrop || !modal) return;
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95');
        document.body.style.overflow = '';
        setTimeout(() => { backdrop.classList.add('hidden'); }, 200);
        isOpen = false;
    }

    function resetView() {
        if (dynamicResults) {
            dynamicResults.classList.add('hidden');
            const list = dynamicResults.querySelector('.cp-list-content');
            if(list) list.innerHTML = '';
        }
        if(staticNav) staticNav.classList.remove('hidden');
        if(settingsGroup) settingsGroup.classList.remove('hidden');
        
        // Reset Static Filter
        document.querySelectorAll('#cp-static-nav .cp-item').forEach(el => el.classList.remove('hidden'));
    }

    function renderResults(results) {
        const list = dynamicResults?.querySelector('.cp-list-content');
        if (!list) return;
        
        list.innerHTML = '';
        
        if (results.length > 0) {
            dynamicResults.classList.remove('hidden');
            // Hide static nav when searching to avoid clutter
            staticNav?.classList.add('hidden');
            settingsGroup?.classList.add('hidden');

            results.slice(0, 10).forEach((item, idx) => { // Limit to 10
                const el = document.createElement('a');
                el.href = item.url;
                el.className = `cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group transition-colors ${idx === 0 ? 'bg-slate-50 dark:bg-slate-800' : ''}`;
                
                // Icon Logic based on type
                let iconClass = 'bg-slate-200 text-slate-600';
                let iconContent = '<i class="fa-solid fa-link text-xs"></i>';
                
                if (item.type === 'Event') { iconClass = 'bg-rose-100 text-rose-600'; iconContent = '<i class="fa-regular fa-calendar text-xs"></i>'; }
                if (item.type === 'Projekt') { iconClass = 'bg-purple-100 text-purple-600'; iconContent = '<i class="fa-solid fa-lightbulb text-xs"></i>'; }
                if (item.type === 'Service') { iconClass = 'bg-indigo-100 text-indigo-600'; iconContent = '<i class="fa-solid fa-hand-holding-heart text-xs"></i>'; }
                if (item.type === 'Blog') { iconClass = 'bg-amber-100 text-amber-600'; iconContent = '<i class="fa-solid fa-newspaper text-xs"></i>'; }
                
                // Icons für Camps & Trips (mit Orange und Flugzeug)
                if (item.type === 'Camp' || item.type === 'City Trip') { 
                    iconClass = 'bg-orange-100 text-orange-600'; 
                    iconContent = '<i class="fa-solid fa-plane text-xs"></i>'; 
                }

                // NEU: Icons für Archiv
                if (item.type === 'Archiv') {
                    iconClass = 'bg-amber-100 text-amber-600';
                    iconContent = '<i class="fa-solid fa-box-archive text-xs"></i>';
                }

                el.innerHTML = `
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 ${iconClass}">${iconContent}</div>
                    <div class="min-w-0 flex-1">
                        <span class="block text-slate-900 dark:text-white font-bold truncate">${item.title}</span>
                        ${item.desc ? `<span class="block text-[10px] text-slate-500 dark:text-slate-400 truncate">${item.desc}</span>` : ''}
                    </div>
                    <span class="text-[9px] uppercase font-bold text-slate-400 border border-slate-200 dark:border-slate-700 px-1.5 py-0.5 rounded">${item.type}</span>
                `;
                el.addEventListener('click', closeCP);
                list.appendChild(el);
            });
        } else {
            // No results
            list.innerHTML = `<div class="p-4 text-center text-slate-500 text-sm">Keine Treffer gefunden.</div>`;
            dynamicResults.classList.remove('hidden');
        }
    }

    // --- EVENT LISTENERS ---

    input?.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        
        if (val.length < 2) {
            resetView();
            // Filter static items locally
            const staticItems = document.querySelectorAll('#cp-static-nav .cp-item');
            staticItems.forEach(item => {
                const keywords = item.getAttribute('data-keywords') || '';
                const text = item.innerText.toLowerCase();
                if (val === '' || text.includes(val) || keywords.includes(val)) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
            return;
        }

        // Filter loaded JSON data
        const filtered = searchData.filter(item => 
            item.title.toLowerCase().includes(val) || 
            (item.desc && item.desc.toLowerCase().includes(val))
        );
        renderResults(filtered);
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
        // Open
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); isOpen ? closeCP() : openCP(); }
        if (e.key === '/' && !isOpen) {
            const tag = document.activeElement?.tagName;
            if (tag !== 'INPUT' && tag !== 'TEXTAREA' && !document.activeElement?.isContentEditable) {
                e.preventDefault(); openCP();
            }
        }
        
        // Navigation inside
        if (!isOpen) return;
        if (e.key === 'Escape') closeCP();

        const items = document.querySelectorAll('.cp-item:not(.hidden)');
        if (items.length === 0) return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = (selectedIndex + 1) % items.length;
            items[selectedIndex]?.focus();
            items[selectedIndex]?.scrollIntoView({ block: 'nearest' });
        }
        if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = (selectedIndex - 1 + items.length) % items.length;
            items[selectedIndex]?.focus();
            items[selectedIndex]?.scrollIntoView({ block: 'nearest' });
        }
        if (e.key === 'Enter') {
            const active = items[selectedIndex]; // Or document.activeElement
            if(active) {
                active.click();
            }
        }
    });

    backdrop?.addEventListener('click', (e) => { if (e.target === backdrop) closeCP(); });

    // Open Event (z.B. vom Header Button)
    window.addEventListener('open-search', openCP);

    // --- ACCESSIBILITY LOGIC (Dein bestehender Code) ---
    function updateToggleUI(btn, isActive, labelOverride = null) {
        if(!btn) return;
        const status = btn.querySelector('.toggle-status');
        if(status) {
            status.innerText = labelOverride ? labelOverride : (isActive ? "AN" : "AUS");
            let activeClass = 'bg-emerald-100 text-emerald-700 border-emerald-200 dark:bg-emerald-900 dark:text-emerald-300 dark:border-emerald-800';
            if (btn.id === 'cp-toggle-theme' && isActive) {
                activeClass = 'bg-amber-100 text-amber-700 border-amber-200 dark:bg-amber-900 dark:text-amber-300 dark:border-amber-800';
            }
            status.className = `toggle-status text-[10px] font-bold border px-2 py-0.5 rounded ${isActive ? activeClass : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-600 text-slate-500'}`;
        }
    }

    function initAccessibility() {
        if (localStorage.getItem('high-contrast') === 'true') {
            document.documentElement.classList.add('high-contrast');
            updateToggleUI(btnContrast, true);
        }
        if (localStorage.getItem('large-text') === 'true') {
            document.documentElement.classList.add('large-text');
            updateToggleUI(btnFontSize, true);
        }
        if (localStorage.getItem('reduced-motion') === 'true') {
            document.documentElement.classList.add('reduced-motion');
            updateToggleUI(btnMotion, true);
        }
        const isDark = document.documentElement.classList.contains('dark');
        updateToggleUI(btnTheme, isDark, isDark ? "DUNKEL" : "HELL");
    }

    // Toggle Listeners
    btnContrast?.addEventListener('click', () => {
        const isActive = document.documentElement.classList.toggle('high-contrast');
        localStorage.setItem('high-contrast', String(isActive));
        updateToggleUI(btnContrast, isActive);
    });
    btnFontSize?.addEventListener('click', () => {
        const isActive = document.documentElement.classList.toggle('large-text');
        localStorage.setItem('large-text', String(isActive));
        updateToggleUI(btnFontSize, isActive);
    });
    btnMotion?.addEventListener('click', () => {
        const isActive = document.documentElement.classList.toggle('reduced-motion');
        localStorage.setItem('reduced-motion', String(isActive));
        updateToggleUI(btnMotion, isActive);
    });
    btnTheme?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateToggleUI(btnTheme, isDark, isDark ? "DUNKEL" : "HELL");
        window.dispatchEvent(new Event('theme-change')); // Sync with Header
    });

</script>

<style is:global>
    html.high-contrast { filter: contrast(1.3) saturate(1.1); }
    html.high-contrast * { text-shadow: none !important; }
    html.high-contrast img, html.high-contrast video { filter: contrast(0.8); }
    html.large-text { font-size: 125%; }
    
    html.reduced-motion *, html.reduced-motion *::before, html.reduced-motion *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
</style>