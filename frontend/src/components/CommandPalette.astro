---
/* src/components/CommandPalette.astro */
---

<div id="command-palette-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden flex items-start justify-center pt-[10vh] px-4 transition-opacity duration-200 opacity-0">
    <div id="command-palette-modal" role="dialog" aria-modal="true" aria-label="Befehlsmenü" class="bg-white dark:bg-slate-900 w-full max-w-2xl rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden transform scale-95 transition-transform duration-200 flex flex-col max-h-[80vh]">
        
        {/* Search Input */}
        <div class="border-b border-slate-100 dark:border-slate-800 flex items-center px-4 py-4 relative shrink-0">
            <i class="fa-solid fa-search text-slate-400 text-lg mr-3" id="cp-search-icon"></i>
            <i class="fa-solid fa-circle-notch fa-spin text-rose-500 text-lg mr-3 hidden" id="cp-loading-icon"></i>
            
            <input type="text" id="cp-input" placeholder="Suchen nach Events, Camps, Projekten..." 
                   class="w-full bg-transparent border-none text-xl text-slate-900 dark:text-white placeholder-slate-400 focus:ring-0 focus:outline-none h-10" autocomplete="off" />
            
            <span class="hidden sm:inline-block text-[10px] font-bold text-slate-400 border border-slate-200 dark:border-slate-700 px-2 py-1 rounded bg-slate-50 dark:bg-slate-800 absolute right-4">ESC</span>
        </div>

        {/* ... (Der Rest des HTML bleibt identisch wie im vorherigen Schritt) ... */}
        <div class="overflow-y-auto p-2 scroll-smooth" id="cp-results">
            {/* ... Content ... */}
            <div id="cp-dynamic-events" class="cp-group mb-2 hidden"><h4 class="text-xs font-bold text-rose-500 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10 border-b border-rose-100 dark:border-rose-900/20">Veranstaltungen</h4><div class="cp-list-content"></div></div>
            <div id="cp-dynamic-trips" class="cp-group mb-2 hidden"><h4 class="text-xs font-bold text-orange-500 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10 border-b border-orange-100 dark:border-orange-900/20">Camps & Reisen</h4><div class="cp-list-content"></div></div>
            <div id="cp-dynamic-projects" class="cp-group mb-2 hidden"><h4 class="text-xs font-bold text-purple-500 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10 border-b border-purple-100 dark:border-purple-900/20">Projekte</h4><div class="cp-list-content"></div></div>
            <div id="cp-dynamic-services" class="cp-group mb-2 hidden"><h4 class="text-xs font-bold text-indigo-500 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10 border-b border-indigo-100 dark:border-indigo-900/20">Angebote</h4><div class="cp-list-content"></div></div>
            <div id="cp-dynamic-team" class="cp-group mb-2 hidden"><h4 class="text-xs font-bold text-emerald-500 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10 border-b border-emerald-100 dark:border-emerald-900/20">Team</h4><div class="cp-list-content"></div></div>

            <div class="cp-group mb-4" id="cp-settings">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest px-3 py-2 flex items-center gap-2"><i class="fa-solid fa-universal-access"></i> Einstellungen</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 px-2">
                    <button id="cp-toggle-contrast" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-rose-500 dark:hover:border-rose-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-circle-half-stroke"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Kontrast</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUS</div></button>
                    <button id="cp-toggle-fontsize" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-indigo-500 dark:hover:border-indigo-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-text-height"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Größe</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUS</div></button>
                    <button id="cp-toggle-motion" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-emerald-500 dark:hover:border-emerald-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-person-running"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Bewegung</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUS</div></button>
                    <button id="cp-toggle-theme" class="cp-item flex items-center gap-3 px-3 py-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 hover:border-amber-500 dark:hover:border-amber-500 cursor-pointer group text-left focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all"><div class="w-8 h-8 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white flex items-center justify-center shadow-sm"><i class="fa-solid fa-moon dark:hidden"></i><i class="fa-solid fa-sun hidden dark:block"></i></div><div class="flex-1"><span class="block text-sm font-bold text-slate-900 dark:text-white">Design</span></div><div class="toggle-status text-[10px] font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 px-2 py-0.5 rounded text-slate-500">AUTO</div></button>
                </div>
            </div>

            <div class="cp-group mb-2" id="cp-static-nav">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest px-3 py-2 sticky top-0 bg-white dark:bg-slate-900 z-10">Navigation</h4>
                <a href="/" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="home start"><div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center"><i class="fa-solid fa-house"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Startseite</span></a>
                <a href="/events" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="kalender termin"><div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center"><i class="fa-regular fa-calendar"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Veranstaltungen</span></a>
                <a href="/camps" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="urlaub reisen"><div class="w-8 h-8 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center"><i class="fa-solid fa-plane"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Camps & Reisen</span></a>
                <a href="/projects" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="projekte"><div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center"><i class="fa-solid fa-lightbulb"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Projekte</span></a>
                <a href="/services" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="angebot hilfe"><div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center"><i class="fa-solid fa-hand-holding-heart"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Angebote</span></a>
                <a href="/about" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="team verein"><div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center"><i class="fa-solid fa-users"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Über uns & Team</span></a>
                <a href="/contact" class="cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group" data-keywords="kontakt email adresse"><div class="w-8 h-8 rounded-lg bg-slate-200 text-slate-600 flex items-center justify-center"><i class="fa-regular fa-envelope"></i></div><span class="text-slate-700 dark:text-slate-200 font-medium">Kontakt</span></a>
            </div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-950 px-4 py-3 border-t border-slate-100 dark:border-slate-800 text-[10px] text-slate-400 flex justify-between items-center shrink-0">
            <div class="flex gap-4">
                <span class="flex items-center gap-1"><kbd class="bg-white px-1 rounded border">↑↓</kbd> wählen</span>
                <span class="flex items-center gap-1"><kbd class="bg-white px-1 rounded border">↵</kbd> bestätigen</span>
            </div>
             <span class="opacity-50">Die Brücke Portal</span>
        </div>
    </div>
</div>

<script>
    // --- DOM REFERENCES ---
    const backdrop = document.getElementById('command-palette-backdrop');
    const modal = document.getElementById('command-palette-modal');
    const input = document.getElementById('cp-input');
    const searchIcon = document.getElementById('cp-search-icon');
    const loadingIcon = document.getElementById('cp-loading-icon');

    // Groups
    const dynamicEvents = document.getElementById('cp-dynamic-events');
    const dynamicTrips = document.getElementById('cp-dynamic-trips');
    const dynamicProjects = document.getElementById('cp-dynamic-projects');
    const dynamicServices = document.getElementById('cp-dynamic-services');
    const dynamicTeam = document.getElementById('cp-dynamic-team');
    
    const staticNav = document.getElementById('cp-static-nav');
    const settingsGroup = document.getElementById('cp-settings');
    
    // Toggles
    const btnContrast = document.getElementById('cp-toggle-contrast');
    const btnFontSize = document.getElementById('cp-toggle-fontsize');
    const btnMotion = document.getElementById('cp-toggle-motion');
    const btnTheme = document.getElementById('cp-toggle-theme');

    let isOpen = false;
    let searchTimeout;
    let currentSearchController = null;

    // --- HELPER ---
    function updateToggleUI(btn, isActive, labelOverride = null) {
        if(!btn) return;
        const status = btn.querySelector('.toggle-status');
        if(status) {
            status.innerText = labelOverride ? labelOverride : (isActive ? "AN" : "AUS");
            
            let activeClass = 'bg-emerald-100 text-emerald-700 border-emerald-200 dark:bg-emerald-900 dark:text-emerald-300 dark:border-emerald-800';
            if (btn.id === 'cp-toggle-theme' && isActive) {
                activeClass = 'bg-amber-100 text-amber-700 border-amber-200 dark:bg-amber-900 dark:text-amber-300 dark:border-amber-800';
            }

            status.className = `toggle-status text-[10px] font-bold border px-2 py-0.5 rounded ${
                isActive 
                ? activeClass
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-600 text-slate-500'
            }`;
        }
    }

    // --- INIT ---
    function initAccessibility() {
        if (localStorage.getItem('high-contrast') === 'true') {
            document.documentElement.classList.add('high-contrast');
            updateToggleUI(btnContrast, true);
        }
        if (localStorage.getItem('large-text') === 'true') {
            document.documentElement.classList.add('large-text');
            updateToggleUI(btnFontSize, true);
        }
        if (localStorage.getItem('reduced-motion') === 'true') {
            document.documentElement.classList.add('reduced-motion');
            updateToggleUI(btnMotion, true);
        }
        const isDark = document.documentElement.classList.contains('dark');
        updateToggleUI(btnTheme, isDark, isDark ? "DUNKEL" : "HELL");
    }
    initAccessibility();

    // --- OPEN / CLOSE ---
    function openCP() {
        if(!backdrop || !modal) return;
        backdrop.classList.remove('hidden');
        void backdrop.offsetWidth; 
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95');
        document.body.style.overflow = 'hidden';
        if(input) { input.value = ''; resetView(); setTimeout(() => input.focus(), 50); }
        initAccessibility();
        isOpen = true;
    }

    function closeCP() {
        if(!backdrop || !modal) return;
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95');
        document.body.style.overflow = '';
        setTimeout(() => { backdrop.classList.add('hidden'); }, 200);
        isOpen = false;
    }

    // --- RESET VIEW ---
    function resetView() {
        // Hide Spinner Forcefully
        searchIcon?.classList.remove('hidden');
        loadingIcon?.classList.add('hidden');

        [dynamicEvents, dynamicTrips, dynamicProjects, dynamicServices, dynamicTeam].forEach(el => {
            if(el) {
                el.classList.add('hidden');
                const list = el.querySelector('.cp-list-content');
                if(list) list.innerHTML = '';
            }
        });

        if(staticNav) staticNav.classList.remove('hidden');
        if(settingsGroup) settingsGroup.classList.remove('hidden');
        document.querySelectorAll('.cp-item').forEach(el => el.classList.remove('hidden'));
    }

    // --- MAIN SEARCH FUNCTION ---
    async function performSearch(query) {
        if (query.length < 2) {
            resetView();
            filterStaticItems(query);
            return;
        }

        if (currentSearchController) currentSearchController.abort();
        currentSearchController = new AbortController();
        const signal = currentSearchController.signal;

        // UI: Loading Start
        searchIcon?.classList.add('hidden');
        loadingIcon?.classList.remove('hidden');

        try {
            const baseUrl = 'https://api.diebruecke.social/items';
            const s = encodeURIComponent(query);
            
            const promises = [
                fetch(`${baseUrl}/events?limit=3&search=${s}&filter[status][_eq]=published&fields=id,title,slug,start_date`, { signal }),
                fetch(`${baseUrl}/services?limit=3&search=${s}&filter[status][_eq]=published&fields=id,title,slug,icon`, { signal }),
                fetch(`${baseUrl}/projects?limit=3&search=${s}&filter[status][_eq]=published&fields=id,title,slug,category`, { signal }),
                fetch(`${baseUrl}/camps?limit=3&search=${s}&filter[status][_eq]=published&fields=id,title,slug,date_range`, { signal }),
                fetch(`${baseUrl}/city_trips?limit=3&search=${s}&filter[status][_eq]=published&fields=id,title,slug,date_range`, { signal }),
                fetch(`${baseUrl}/team?limit=3&search=${s}&filter[status][_eq]=published&fields=id,name,role`, { signal }),
            ];

            const responses = await Promise.all(promises);
            const jsonData = await Promise.all(responses.map(r => r.ok ? r.json() : { data: [] }));

            if (!signal.aborted) {
                renderEvents(jsonData[0].data);
                renderServices(jsonData[1].data);
                renderProjects(jsonData[2].data);
                renderTrips([...jsonData[3].data, ...jsonData[4].data]);
                renderTeam(jsonData[5].data);
                filterStaticItems(query);
            }

        } catch (e) {
            // Fehlerbehandlung: Nur loggen, wenn es kein Abort war
            if (e.name !== 'AbortError') {
                console.warn("CP Search Error (likely CORS on localhost):", e);
                // NOTBREMSE: Spinner weg bei Fehler!
                searchIcon?.classList.remove('hidden');
                loadingIcon?.classList.add('hidden');
            }
        } finally {
            // Aufräumen nur, wenn wir noch der aktive Controller sind
            if (currentSearchController && currentSearchController.signal === signal) {
                searchIcon?.classList.remove('hidden');
                loadingIcon?.classList.add('hidden');
                currentSearchController = null;
            }
        }
    }

    // --- RENDER FUNCTIONS (gekürzt, Logik bleibt gleich) ---
    function renderEvents(items) {
        fillList(dynamicEvents, items, (item) => {
            const date = item.start_date ? new Date(item.start_date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' }) : '';
            return { href: `/events/${item.slug}`, text: item.title, iconClass: 'bg-rose-500 text-white', iconContent: date, isHtml: false };
        });
    }
    function renderServices(items) {
        fillList(dynamicServices, items, (item) => ({ 
            href: `/services/${item.slug}`, text: item.title, iconClass: 'bg-indigo-500 text-white', 
            iconContent: item.icon ? `<i class="fa-solid ${item.icon}"></i>` : '<i class="fa-solid fa-star"></i>', isHtml: true 
        }));
    }
    function renderProjects(items) {
        fillList(dynamicProjects, items, (item) => ({ 
            href: `/projects/${item.slug}`, text: item.title, iconClass: 'bg-purple-500 text-white', iconContent: '<i class="fa-solid fa-lightbulb"></i>', isHtml: true 
        }));
    }
    function renderTrips(items) {
        fillList(dynamicTrips, items, (item) => ({ 
            href: `/camps/${item.slug}`, text: item.title, iconClass: 'bg-orange-500 text-white', iconContent: '<i class="fa-solid fa-plane"></i>', isHtml: true 
        }));
    }
    function renderTeam(items) {
        fillList(dynamicTeam, items, (item) => ({ 
            href: `/about`, text: `${item.name} (${item.role || 'Team'})`, iconClass: 'bg-emerald-500 text-white', iconContent: '<i class="fa-solid fa-user"></i>', isHtml: true 
        }));
    }

    // Generic Helper um Code zu sparen
    function fillList(containerGroup, items, mapFn) {
        if(!containerGroup) return;
        const list = containerGroup.querySelector('.cp-list-content');
        list.innerHTML = '';
        if (items && items.length > 0) {
            containerGroup.classList.remove('hidden');
            items.forEach(item => {
                const data = mapFn(item);
                addItem(list, data.href, data.text, data.iconClass, data.iconContent, data.isHtml);
            });
        } else {
            containerGroup.classList.add('hidden');
        }
    }

    function addItem(container, href, text, iconClass, iconContent, isHtmlIcon = false) {
        const el = document.createElement('a');
        el.href = href;
        el.className = "cp-item flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer group focus:bg-slate-100 dark:focus:bg-slate-800 focus:outline-none";
        
        const iconDiv = document.createElement('div');
        iconDiv.className = `w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-xs font-bold ${iconClass}`;
        if(isHtmlIcon) iconDiv.innerHTML = iconContent;
        else iconDiv.innerText = iconContent;

        const textDiv = document.createElement('div');
        textDiv.className = "min-w-0 flex-1";
        textDiv.innerHTML = `<span class="block text-slate-700 dark:text-slate-200 font-medium group-hover:text-black dark:group-hover:text-white truncate">${text}</span>`;

        el.appendChild(iconDiv);
        el.appendChild(textDiv);
        container.appendChild(el);
    }

    function filterStaticItems(query) {
        const term = query.toLowerCase().trim();
        if (!term) {
            document.querySelectorAll('.cp-item').forEach(el => el.classList.remove('hidden'));
            if(staticNav) staticNav.classList.remove('hidden');
            if(settingsGroup) settingsGroup.classList.remove('hidden');
            return;
        }
        const items = document.querySelectorAll('.cp-item[data-keywords]');
        items.forEach((item) => {
            const text = (item.textContent + ' ' + (item.getAttribute('data-keywords') || '')).toLowerCase();
            if (text.includes(term)) item.classList.remove('hidden');
            else item.classList.add('hidden');
        });
        [staticNav, settingsGroup].forEach(group => {
            if(!group) return;
            const visibleItems = group.querySelectorAll('.cp-item:not(.hidden)');
            if (visibleItems.length > 0) group.classList.remove('hidden');
            else group.classList.add('hidden');
        });
    }

    // --- LISTENERS ---
    input?.addEventListener('input', (e) => {
        const val = e.target.value;
        clearTimeout(searchTimeout);
        
        if(val.length < 2) {
            // RESET: Suche abbrechen und Spinner resetten
            if(currentSearchController) {
                currentSearchController.abort();
                currentSearchController = null;
            }
            searchIcon?.classList.remove('hidden');
            loadingIcon?.classList.add('hidden');
            
            if(val.length === 0) resetView(); 
            else filterStaticItems(val); 
            return;
        }
        filterStaticItems(val);
        searchTimeout = setTimeout(() => performSearch(val), 300);
    });

    document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); isOpen ? closeCP() : openCP(); }
        if (e.key === '/' && !isOpen) {
            const tag = document.activeElement?.tagName;
            if (tag !== 'INPUT' && tag !== 'TEXTAREA' && !document.activeElement?.isContentEditable) {
                e.preventDefault(); openCP();
            }
        }
        if (!isOpen) return;
        if (e.key === 'Escape') closeCP();
        
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            const items = Array.from(document.querySelectorAll('.cp-item:not(.hidden)'));
            if(items.length === 0) return;
            const active = document.activeElement;
            let idx = items.indexOf(active);
            if (e.key === 'ArrowDown') idx = idx < items.length - 1 ? idx + 1 : 0;
            if (e.key === 'ArrowUp') idx = idx > 0 ? idx - 1 : items.length - 1;
            items[idx]?.focus();
        }
    });

    backdrop?.addEventListener('click', (e) => { if (e.target === backdrop) closeCP(); });

    // Toggles
    btnContrast?.addEventListener('click', () => {
        const isActive = document.documentElement.classList.toggle('high-contrast');
        localStorage.setItem('high-contrast', String(isActive));
        updateToggleUI(btnContrast, isActive);
    });
    btnFontSize?.addEventListener('click', () => {
        const isActive = document.documentElement.classList.toggle('large-text');
        localStorage.setItem('large-text', String(isActive));
        updateToggleUI(btnFontSize, isActive);
    });
    btnMotion?.addEventListener('click', () => {
        const isActive = document.documentElement.classList.toggle('reduced-motion');
        localStorage.setItem('reduced-motion', String(isActive));
        updateToggleUI(btnMotion, isActive);
    });
    btnTheme?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateToggleUI(btnTheme, isDark, isDark ? "DUNKEL" : "HELL");
    });
</script>

<style is:global>
    html.high-contrast { filter: contrast(1.3) saturate(1.1); }
    html.high-contrast * { text-shadow: none !important; }
    html.high-contrast img, html.high-contrast video { filter: contrast(0.8); }
    html.large-text { font-size: 125%; }
    
    html.reduced-motion *, html.reduced-motion *::before, html.reduced-motion *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
</style>